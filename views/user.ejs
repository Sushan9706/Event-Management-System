<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EMS – User Dashboard</title>
    <link rel="stylesheet" href="/css/user.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="navbar">
      <div class="nav-inner">
        <div class="nav-logo">EMS</div>
        <nav class="nav-center">
          <a href="#">Events</a>
          <a href="#">My Bookings</a>
          <a href="#" class="nav-active">Profile</a>
        </nav>
        <div class="nav-right">
          <div style="position: relative">
            <button class="icon-btn" aria-label="Notifications" id="bellBtn">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.73 21a2 2 0 0 1-3.46 0" />
              </svg>
            </button>
            <div
              id="bellDropdown"
              style="
                display: none;
                position: absolute;
                right: 0;
                top: 36px;
                width: 220px;
                background: #fff;
                border: 1px solid #e6e6e3;
                border-radius: 8px;
                box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
                padding: 12px 16px;
                font-size: 12px;
                color: #666;
                z-index: 300;
              "
            >
              No new notifications
            </div>
          </div>
          <img
            src="https://img.freepik.com/premium-photo/memoji-emoji-handsome-smiling-man-white-background_826801-6987.jpg?semt=ais_incoming&w=740&q=80"
            alt="User avatar"
            class="avatar-circle"
            onerror="this.style.background='#3b4254';this.removeAttribute('src')"
          />
        </div>
      </div>
    </header>

    <main class="page-main">
      <section class="hero">
        <p class="hero-eyebrow">DASHBOARD</p>
        <h1 class="hero-title">
          Welcome back, <span class="hero-name">Divyani</span>.
        </h1>
        <p class="hero-sub">
          Your curated events and management hub for the 2026<br />season is
          ready for exploration.
        </p>
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-ico">
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <rect x="3" y="3" width="7" height="7" />
                <rect x="14" y="3" width="7" height="7" />
                <rect x="3" y="14" width="7" height="7" />
                <rect x="14" y="14" width="7" height="7" />
              </svg>
            </div>
            <p class="stat-label">TOTAL BOOKINGS</p>
            <p class="stat-num">24</p>
          </div>
          <div class="stat-card">
            <div class="stat-ico">
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <rect x="3" y="4" width="18" height="18" rx="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg>
            </div>
            <p class="stat-label">UPCOMING EVENTS</p>
            <p class="stat-num">03</p>
          </div>
          <div class="stat-card stat-card--member">
            <div class="member-row-top">
              <p class="member-eyebrow">MEMBERSHIP</p>
              <div class="gem-icon">
                <svg
                  viewBox="0 0 50 50"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  width="36"
                  height="36"
                >
                  <polygon
                    points="25,3 47,17 47,39 25,49 3,39 3,17"
                    fill="rgba(255,255,255,0.05)"
                    stroke="rgba(255,255,255,0.2)"
                    stroke-width="1.2"
                  />
                  <polygon
                    points="25,11 40,21 40,37 25,45 10,37 10,21"
                    fill="rgba(255,255,255,0.04)"
                    stroke="rgba(255,255,255,0.12)"
                    stroke-width="1"
                  />
                  <circle cx="25" cy="28" r="5" fill="rgba(255,255,255,0.18)" />
                </svg>
              </div>
            </div>
            <p class="member-title">Elite Curator</p>
            <a href="#" class="member-link">VIEW BENEFITS →</a>
          </div>
        </div>
      </section>

      <section class="recommended">
        <div class="sec-header">
          <div>
            <h2 class="sec-title">Recommended for You</h2>
            <p class="sec-sub">
              AI-powered suggestions based on your interests
            </p>
          </div>
          <a href="#" class="explore-all"
            >EXPLORE ALL
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </a>
        </div>
        <div class="cards-grid">
          <div class="ecard ecard--featured">
            <div class="ecard-img-wrap">
              <img
                src="https://media.bitcot.com/wp-content/uploads/2025/04/Best-Tech-Conferences-2026.webp"
                alt="Tech Conference 2026"
                class="ecard-img ecard-img--featured"
              />
            </div>
            <div class="ecard-body">
              <p class="ecard-meta">
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <rect x="3" y="4" width="18" height="18" rx="2" />
                  <line x1="16" y1="2" x2="16" y2="6" />
                  <line x1="8" y1="2" x2="8" y2="6" />
                  <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
                Oct 12, 2026
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  style="margin-left: 5px"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                Berlin, DE
              </p>
              <h3 class="ecard-title">
                Global Synergy: Design &amp; Ethics Summit
              </h3>
            </div>
          </div>
          <div class="ecard ecard--sm">
            <div class="ecard-img-wrap">
              <img
                src="https://covers.stocktune.com/public/a/2/f/a2f8dadf-ce7a-4158-bb72-82a31cc5b032_large/infinite-neon-soundscapes-stocktune.jpg"
                alt="Metropolis Night Series"
                class="ecard-img ecard-img--sm"
              />
            </div>
            <div class="ecard-body ecard-body--sm">
              <p class="ecard-date-sm">Nov 04, 2026</p>
              <h3 class="ecard-title ecard-title--sm">
                Metropolis Night Series: Soundscapes
              </h3>
            </div>
          </div>
          <div class="ecard ecard--sm">
            <div class="ecard-img-wrap">
              <img
                src="https://nohoartsdistrict.com/wp-content/uploads/2025/11/Throw-a-Festive-Winter-Solstice-Dinner-With-These-Finishing-Touches-scaled.jpeg"
                alt="The Artisan's Table"
                class="ecard-img ecard-img--sm"
              />
            </div>
            <div class="ecard-body ecard-body--sm">
              <p class="ecard-date-sm">Dec 15, 2026</p>
              <h3 class="ecard-title ecard-title--sm">
                The Artisan's Table: Winter Solstice
              </h3>
            </div>
          </div>
        </div>
      </section>

      <section class="search-filter">
        <h2 class="sec-title">Search &amp; Filter Events</h2>
        <div class="filter-row">
          <input
            type="text"
            id="searchInput"
            placeholder="Search events by name..."
          />
          <select id="dateFilter">
            <option value="">All Dates</option>
            <option value="2026-10-12">Oct 12, 2026</option>
            <option value="2026-11-04">Nov 04, 2026</option>
          </select>
          <select id="locationFilter">
            <option value="">All Locations</option>
            <option value="Berlin">Berlin</option>
            <option value="Kathmandu">Kathmandu</option>
          </select>
          <select id="categoryFilter">
            <option value="">All Categories</option>
            <option value="Tech">Tech</option>
            <option value="Music">Music</option>
          </select>
        </div>
      </section>

      <section class="bookings-wrap">
        <div class="bookings-box">
          <div class="bk-header">
            <h2 class="sec-title">Recent Bookings</h2>
            <a href="#" class="view-hist">VIEW HISTORY</a>
          </div>
          <div class="tbl">
            <div class="tbl-head">
              <span class="th">EVENT NAME</span>
              <span class="th">STATUS</span>
              <span class="th">AMOUNT</span>
              <span class="th">ACTION</span>
            </div>
            <div class="tbl-row">
              <div class="td td-event">
                <div class="ri ri--blue">
                  <img
                    src="images/icon-expo.png"
                    alt=""
                    class="ri-img"
                    onerror="this.parentElement.innerHTML='<svg width=\'13\' height=\'13\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'2\' stroke-linecap=\'round\'><circle cx=\'12\' cy=\'12\' r=\'10\'/><polyline points=\'12 6 12 12 16 14\'/></svg>'"
                  />
                </div>
                <div>
                  <p class="rn">Modernist Expo 2026</p>
                  <p class="rid">Booking ID: #EMS-29402</p>
                </div>
              </div>
              <div class="td td-status">
                <span class="pill pill--ok">CONFIRMED</span>
              </div>
              <div class="td td-amount">$145.00</div>
              <div class="td td-action">
                <button class="act-btn" aria-label="Download">
                  <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  >
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="7 10 12 15 17 10" />
                    <line x1="12" y1="15" x2="12" y2="3" />
                  </svg>
                </button>
              </div>
            </div>
            <div class="tbl-row">
              <div class="td td-event">
                <div class="ri ri--amber">
                  <img
                    src="images/icon-gastro.png"
                    alt=""
                    class="ri-img"
                    onerror="this.parentElement.innerHTML='<svg width=\'13\' height=\'13\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'2\' stroke-linecap=\'round\'><path d=\'M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2\'/><path d=\'M7 2v20\'/><path d=\'M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3zm0 0v7\'/></svg>'"
                  />
                </div>
                <div>
                  <p class="rn">Gastronomy Workshop</p>
                  <p class="rid">Booking ID: #EMS-28183</p>
                </div>
              </div>
              <div class="td td-status">
                <span class="pill pill--pend">PENDING</span>
              </div>
              <div class="td td-amount">$89.00</div>
              <div class="td td-action">
                <button class="act-btn" aria-label="More options">
                  <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <circle cx="12" cy="5" r="1.5" />
                    <circle cx="12" cy="12" r="1.5" />
                    <circle cx="12" cy="19" r="1.5" />
                  </svg>
                </button>
              </div>
            </div>
            <div class="tbl-row tbl-row--last">
              <div class="td td-event">
                <div class="ri ri--green">
                  <img
                    src="images/icon-startup.png"
                    alt=""
                    class="ri-img"
                    onerror="this.parentElement.innerHTML='<svg width=\'13\' height=\'13\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'2\' stroke-linecap=\'round\'><polygon points=\'13 2 3 14 12 14 11 22 21 10 12 10 13 2\'/></svg>'"
                  />
                </div>
                <div>
                  <p class="rn">Startup Ignition Night</p>
                  <p class="rid">Booking ID: #EMS-27561</p>
                </div>
              </div>
              <div class="td td-status">
                <span class="pill pill--ok">CONFIRMED</span>
              </div>
              <div class="td td-amount">$0.00</div>
              <div class="td td-action">
                <button class="act-btn" aria-label="Download">
                  <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  >
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="7 10 12 15 17 10" />
                    <line x1="12" y1="15" x2="12" y2="3" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span class="footer-copy">COPYRIGHT 2026 EMS MANAGEMENT</span>
      <div class="footer-links">
        <a href="#">PRIVACY POLICY</a>
        <a href="#">TERMS OF SERVICE</a>
        <a href="#">CONTACT</a>
      </div>
    </footer>
    <div class="avatar-sidebar-overlay" id="sidebarOverlay"></div>
    <aside class="avatar-sidebar" id="avatarSidebar">
      <button class="sidebar-item" id="openPwModal">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <rect x="3" y="11" width="18" height="11" rx="2" />
          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
        Update Password
      </button>
      <div class="sidebar-divider"></div>
      <button class="sidebar-item sidebar-item--danger" id="logoutBtn">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
          <polyline points="16 17 21 12 16 7" />
          <line x1="21" y1="12" x2="9" y2="12" />
        </svg>
        Log Out
      </button>
    </aside>

    <div class="pw-modal-overlay" id="pwModalOverlay">
      <div class="pw-modal">
        <h3>Update Password</h3>
        <label
          >CURRENT PASSWORD
          <input
            type="password"
            id="pwCurrent"
            placeholder="Enter current password"
          />
        </label>
        <label
          >NEW PASSWORD
          <input type="password" id="pwNew" placeholder="Enter new password" />
        </label>
        <label
          >CONFIRM NEW PASSWORD
          <input
            type="password"
            id="pwConfirm"
            placeholder="Confirm new password"
          />
        </label>
        <p class="pw-msg" id="pwMsg"></p>
        <div class="pw-modal-actions">
          <button class="pw-btn" id="cancelPw">Cancel</button>
          <button class="pw-btn pw-btn--primary" id="savePw">Save</button>
        </div>
      </div>
    </div>
    <script>
      const events = [
        {
          name: "Global Synergy: Design & Ethics Summit",
          date: "2026-10-12",
          location: "Berlin",
          category: "Tech",
        },
        {
          name: "Metropolis Night Series: Soundscapes",
          date: "2026-11-04",
          location: "Kathmandu",
          category: "Music",
        },
        {
          name: "The Artisan's Table: Winter Solstice",
          date: "2026-12-15",
          location: "Berlin",
          category: "Food",
        },
      ];

      const cards = document.querySelectorAll(".ecard");

      function filterEvents() {
        const search = document
          .getElementById("searchInput")
          .value.toLowerCase();
        const date = document.getElementById("dateFilter").value;
        const location = document.getElementById("locationFilter").value;
        const category = document.getElementById("categoryFilter").value;

        cards.forEach((card, index) => {
          const event = events[index];
          const match =
            event.name.toLowerCase().includes(search) &&
            (date === "" || event.date === date) &&
            (location === "" || event.location === location) &&
            (category === "" || event.category === category);
          card.style.display = match ? "block" : "none";
        });
      }

      document
        .getElementById("searchInput")
        .addEventListener("input", filterEvents);
      document
        .getElementById("dateFilter")
        .addEventListener("change", filterEvents);
      document
        .getElementById("locationFilter")
        .addEventListener("change", filterEvents);
      document
        .getElementById("categoryFilter")
        .addEventListener("change", filterEvents);

      const avatar = document.querySelector(".avatar-circle");
      const sidebar = document.getElementById("avatarSidebar");
      const overlay = document.getElementById("sidebarOverlay");

      function openSidebar() {
        sidebar.classList.add("open");
        overlay.classList.add("open");
      }
      function closeSidebar() {
        sidebar.classList.remove("open");
        overlay.classList.remove("open");
      }

      avatar.addEventListener("click", () =>
        sidebar.classList.contains("open") ? closeSidebar() : openSidebar()
      );
      overlay.addEventListener("click", closeSidebar);

      document.getElementById("logoutBtn").addEventListener("click", () => {
        if (confirm("Are you sure you want to log out?")) {
          window.location.href = "/logout";
        }
      });

      const pwOverlay = document.getElementById("pwModalOverlay");
      document.getElementById("openPwModal").addEventListener("click", () => {
        closeSidebar();
        pwOverlay.classList.add("open");
      });
      document.getElementById("cancelPw").addEventListener("click", () => {
        pwOverlay.classList.remove("open");
        document.getElementById("pwMsg").textContent = "";
        ["pwCurrent", "pwNew", "pwConfirm"].forEach(
          (id) => (document.getElementById(id).value = "")
        );
      });
      document.getElementById("savePw").addEventListener("click", () => {
        const cur = document.getElementById("pwCurrent").value;
        const nw = document.getElementById("pwNew").value;
        const cf = document.getElementById("pwConfirm").value;
        const msg = document.getElementById("pwMsg");
        if (!cur || !nw || !cf) {
          msg.style.color = "#c0392b";
          msg.textContent = "Please fill in all fields.";
          return;
        }
        if (nw !== cf) {
          msg.style.color = "#c0392b";
          msg.textContent = "New passwords do not match.";
          return;
        }
        if (nw.length < 6) {
          msg.style.color = "#c0392b";
          msg.textContent = "Password must be at least 6 characters.";
          return;
        }
        msg.style.color = "#27a05a";
        msg.textContent = "Password updated successfully!";
        setTimeout(() => {
          document.getElementById("cancelPw").click();
        }, 1500);
      });
      const bellBtn = document.getElementById("bellBtn");
      const bellDropdown = document.getElementById("bellDropdown");

      bellBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        bellDropdown.style.display =
          bellDropdown.style.display === "none" ? "block" : "none";
      });

      document.addEventListener("click", () => {
        bellDropdown.style.display = "none";
      });
    </script>
  </body>
</html>
