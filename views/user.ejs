<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EMS – User Dashboard</title>
  <link rel="stylesheet" href="/css/user.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet" />
</head>

<body>
  <header class="navbar">
    <div class="nav-inner">
      <div class="nav-logo">EMS</div>
      
      <nav class="nav-center">
        <a href="/user" class="nav-link <%= (locals.activePage === 'home') ? 'active' : '' %>">Home</a>
        <a href="/catalog" class="nav-link <%= (locals.activePage === 'events') ? 'active' : '' %>">Events</a>
        <a href="/venues" class="nav-link <%= (locals.activePage === 'venues') ? 'active' : '' %>">Venues</a>
        <a href="/bookings" class="nav-link <%= (locals.activePage === 'bookings') ? 'active' : '' %>">My Bookings</a>
        <a href="/venue-bookings" class="nav-link <%= (locals.activePage === 'venue-bookings') ? 'active' : '' %>">My Venue Bookings</a>
      </nav>

      <div class="nav-right">
        <button class="icon-btn" id="notifBtn" aria-label="Notifications">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" />
          </svg>
          <% if (Array.isArray(locals.notifications) && locals.notifications.some(n => !n.isRead)) { %>
            <span class="notif-dot"></span>
          <% } %>
        </button>
        <img src="<%= (locals.user && user.profileImage) ? user.profileImage : 'https://ui-avatars.com/api/?name=' + (locals.user ? user.username : 'User') + '&background=e74c3c&color=fff' %>" 
             alt="User avatar" class="avatar-circle" id="profileTrigger" />
      </div>
    </div>
  </header>

  <%
  var _notifs = Array.isArray(locals.notifications) ? locals.notifications : [];
  var _unread = _notifs.filter(function(n){ return !n.isRead; }).length;
  var _formatTime = function(date) {
    if (!date) return 'Just now';
    var d = new Date(date);
    if (Number.isNaN(d.getTime())) return 'Just now';
    return d.toLocaleString('en-US', { month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit' });
  };
%>
<div class="notif-dropdown" id="notifDropdown">
  <div style="display:flex; align-items:center; justify-content:space-between; padding:0 0 10px 0;">
    <p class="notif-title" style="margin:0;">NOTIFICATIONS</p>
    <% if (_unread > 0) { %>
      <button id="markAllReadBtn" onclick="markAllNotificationsRead()"
        style="font-size:11px;font-weight:600;color:#e74c3c;background:none;border:none;cursor:pointer;padding:0;letter-spacing:0.03em;">
        MARK ALL READ
      </button>
    <% } %>
  </div>
  <% if (_notifs.length === 0) { %>
    <p class="notif-empty">No new notifications</p>
  <% } else { %>
    <% _notifs.forEach(function(note) {
      var title = 'Notification';
      var sub = note.eventName || 'Event';
      var isLink = false;
      var eventLink = note.link || (note.eventId ? '/event/' + note.eventId : '#');
      var count = note.ticketCount || 1;
      if (note.type === 'booking_confirmed') {
        title = 'Booking Confirmed';
        sub = (note.eventName || 'Event') + ' · ' + count + ' ticket' + (count === 1 ? '' : 's');
      } else if (note.type === 'booking_cancelled') {
        title = 'Booking Cancelled';
        sub = (note.eventName || 'Event') + ' · ' + count + ' ticket' + (count === 1 ? '' : 's');
      } else if (note.type === 'event_update') {
        title = 'Event Updated';
        sub = (note.eventName || 'Event') + ' details have been updated.';
        isLink = true;
      } else if (note.type === 'event_cancelled') {
        title = 'Event Cancelled';
        sub = (note.eventName || 'Event') + (note.eventDate ? ' · ' + note.eventDate : '') + ' has been cancelled.';
      }
      var timeLabel = _formatTime(note.createdAt);
      var isUnread = !note.isRead;
    %>
    <div class="notif-item <%= isUnread ? 'notif-item--unread' : '' %>">
      <% if (isLink) { %>
        <a href="<%= eventLink %>" style="text-decoration:none;color:inherit;display:block;">
          <p class="notif-item-title"><%= title %></p>
          <p class="notif-item-sub"><%= sub %></p>
          <p class="notif-time"><%= timeLabel %></p>
        </a>
      <% } else { %>
        <p class="notif-item-title"><%= title %></p>
        <p class="notif-item-sub"><%= sub %></p>
        <p class="notif-time"><%= timeLabel %></p>
      <% } %>
    </div>
    <% }); %>
  <% } %>
</div>

  <main class="page-main">
    <section class="hero">
      <p class="hero-eyebrow">DASHBOARD</p>
      <h1 class="hero-title">
        Welcome, <span class="hero-name"><%= (locals.user && user.username) ? user.username.charAt(0).toUpperCase() + user.username.slice(1) : 'Guest' %></span>.
      </h1>
      <p class="hero-sub">Your curated events and management hub for the 2026 season is ready for exploration.</p>
      
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-ico"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg></div>
          <p class="stat-label">TOTAL BOOKINGS</p>
          <p class="stat-num"><%= locals.totalBookings || 0 %></p>
        </div>
        <div class="stat-card">
          <div class="stat-ico"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg></div>
          <p class="stat-label">UPCOMING EVENTS</p>
          <p class="stat-num"><%= locals.upcomingEvents || 0 %></p>
        </div>
        
      </div>
    </section>

    <section class="recommended">
      <div class="sec-header">
        <h2 class="sec-title">Latest Events</h2>
        <a href="/catalog" class="explore-all">EXPLORE ALL <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg></a>
      </div>
      <div class="cards-grid">
        <% if (locals.latestEvents && latestEvents.length > 0) { %>
          <% latestEvents.forEach(function(event, i) { %>
            <a href="/event/<%= event._id %>" class="ecard <%= i === 0 ? 'ecard--latest' : '' %>" style="text-decoration:none; color:inherit;">
              <div class="ecard-img-wrap">
                <img src="<%= event.image || event.imagePath || 'https://via.placeholder.com/400x260?text=Event' %>" 
                     class="ecard-img" 
                     onerror="this.src='https://via.placeholder.com/400x260?text=Event'" />
              </div>
              <div class="ecard-body">
                <h3 class="ecard-title">
                  <%= event.eventName || event.title %>
                </h3>
                <p class="ecard-meta">
                  <%= new Date(event.startDate || event.date).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) %>
                  <% if (event.location) { %> • <%= event.location %><% } %>
                </p>
              </div>
            </a>
          <% }) %>
        <% } else { %>
          <p style="color: var(--text-mid); padding: 20px 0; grid-column: 1/-1;">No events available at the moment.</p>
        <% } %>
      </div>
    </section>
    

    <section class="bookings-wrap">
      <div class="bookings-box">
        <div class="bk-header">
          <h2 class="sec-title">Recent Bookings</h2>
        </div>
        <div class="tbl">
          <div class="tbl-head">
            <span class="th">EVENT NAME</span>
            <span class="th">STATUS</span>
            <span class="th">DATE</span>
            <span class="th">ACTION</span>
          </div>
          <% if (locals.recentBookings && recentBookings.length > 0) { %>
            <% recentBookings.forEach(booking => { 
                const event = booking.eventId;
            %>
              <div class="tbl-row">
                <div class="td td-event">
                  <div class="ri"><img src="<%= event.image || event.imagePath %>" class="ri-img" onerror="this.parentElement.style.background='#eee'"></div>
                  <div><p class="rn"><%= event.eventName || event.title %></p><p class="rid"><%= event.location %></p></div>
                </div>
                <div class="td"><span class="pill pill--ok" <%= (booking.status === 'cancelled') ? 'style="background: #fde8e8; color: #c0392b;"' : ((booking.status === 'expired') ? 'style="background: #f0f0f0; color: #666;"' : '') %>><%= (booking.status || 'confirmed').toUpperCase() %></span></div>
                <div class="td"><%= new Date(event.startDate || event.date || new Date()).toLocaleDateString() %></div>
                <div class="td">
                   <a href="/bookings/manage/<%= booking._id %>" class="act-btn" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                   </a>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <p style="padding: 20px; color: #999; text-align: center;">No recent bookings found.</p>
          <% } %>
        </div>
        <% if (locals.recentBookings && recentBookings.length === 3) { %>
          <div style="text-align: center; margin-top: 20px;">
            <button id="loadMoreBtn" style="padding: 8px 16px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-page); color: var(--text-dark); cursor: pointer; font-family: var(--sans);">Load More Bookings</button>
          </div>
        <% } %>
      </div>
    </section>
  </main>
  <script src="/js/user.js"></script>
</body>
</html>
