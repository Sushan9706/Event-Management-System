<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EMS – Account Settings</title>
    <link rel="stylesheet" href="/css/profile.css" />
    <% if (user && user.role === 'admin') { %>
      <link rel="stylesheet" href="/css/admin-manage.css" />
      <style>
        /* Override some admin-manage.css styles that conflict with profile page */
        body { display: flex; flex-direction: column; }
        .page-main, main { padding: 44px 40px 72px 60px; flex: 1; }
        .navbar { position: sticky; top: 0; width: 100%; }
        .nav-inner { max-width: 1200px; margin: 0 auto; height: 60px; display: flex; align-items: center; justify-content: space-between; padding: 0 32px; }
      </style>
    <% } %>
  </head>
  <body>
    <% if (user && user.role === 'admin') { %>
      <header class="navbar">
          <div class="nav-inner">
              <div class="nav-brand">
                  <span class="logo">EMS</span>
              </div>
              <nav class="nav-links">
                  <a href="/admin/dashboard" class="nav-link">Events</a>
                  
                  <button class="icon-btn" id="notifBtn" aria-label="Notifications" title="Recent Bookings">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                          <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                      </svg>
                      <span class="notif-dot" id="notifDot" style="display: none;"></span>
                  </button>

                  <div class="notif-dropdown" id="notifDropdown" style="right: 50px;">
                      <p class="notif-title">RECENT BOOKINGS</p>
                      <div id="notifList">
                          <p class="notif-empty">Loading notifications...</p>
                      </div>
                  </div>

                  <div class="user-menu-container">
                      <button class="user-trigger" id="userTrigger" title="User Account">
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                              stroke-width="2">
                              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                              <circle cx="12" cy="7" r="4"></circle>
                          </svg>
                      </button>
                      <div class="user-dropdown" id="userDropdown">
                          <a href="/profile" class="dropdown-link">
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                  stroke-width="2">
                                  <circle cx="12" cy="12" r="3"></circle>
                                  <path
                                      d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1-2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z">
                                  </path>
                              </svg>
                              Profile
                          </a>
                          <a href="/logout" class="dropdown-link logout">
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                  stroke-width="2">
                                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                  <polyline points="16 17 21 12 16 7"></polyline>
                                  <line x1="21" y1="12" x2="9" y2="12"></line>
                              </svg>
                              Logout
                          </a>
                      </div>
                  </div>
              </nav>
          </div>
      </header>
    <% } else { %>
      <nav>
        <a href="/user" class="nav-logo">EMS</a>
        <ul class="nav-links">
          <li><a href="/user">Home</a></li>
          <li><a href="/catalog">Events</a></li>
          <li><a href="/venues">Venues</a></li>
          <li><a href="/bookings">My Bookings</a></li>
        </ul>

        <div class="nav-actions">
          <button class="notif-btn" id="notifBtn" title="Notifications" onclick="toggleNotif()">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 10-12 0v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            <span class="notif-badge"></span>
          </button>
          <div class="notif-panel" id="notifPanel">
            <div class="notif-header">Notifications</div>
            <%
              const notifications = Array.isArray(locals.notifications) ? locals.notifications : [];
              const formatTicketCount = (count) => `${count} ticket${count === 1 ? '' : 's'}`;
              const formatNotifTime = (date) => {
                if (!date) return "Just now";
                const d = new Date(date);
                if (Number.isNaN(d.getTime())) return "Just now";
                return d.toLocaleString("en-US", { month: "short", day: "2-digit", hour: "2-digit", minute: "2-digit" });
              };
            %>
            <div class="notif-list">
              <% if (notifications.length === 0) { %>
                <div class="notif-item">No new notifications</div>
              <% } else { %>
                <% notifications.forEach(function(note) { 
                    const title = note.type === 'booking_cancelled' ? 'Booking Cancelled' : 'Booking Confirmed';
                    const eventTitle = note.eventName || 'Event';
                    const countLabel = formatTicketCount(note.ticketCount || 1);
                    const timeLabel = formatNotifTime(note.createdAt);
                %>
                  <div class="notif-item">
                    <span><%= title %></span>
                    <span><%= eventTitle %> · <%= countLabel %></span>
                    <span class="notif-time"><%= timeLabel %></span>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>
          <img id="navAvatar" class="nav-avatar" src="https://ui-avatars.com/api/?name=<%= user.username %>&background=e74c3c&color=fff" alt="User avatar" />
        </div>
      </nav>
    <% } %>

    <main>
      <div class="page-title">
        <span class="t1">Account</span>
        <span class="t2">Settings</span>
      </div>

      <div class="settings-grid">
        <div class="left-col">
          <div class="profile-card">
            <div class="avatar-wrapper" onclick="document.getElementById('avatarInput').click()" title="Click to change avatar">
              <img id="profileAvatar" src="<%= user.profileImage || 'https://ui-avatars.com/api/?name=' + user.username + '&background=e74c3c&color=fff' %>" alt="Profile Avatar" />
              <div class="avatar-overlay">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                  <circle cx="12" cy="13" r="3" />
                </svg>
                Change
              </div>
            </div>
            <input type="file" id="avatarInput" accept="image/*" style="display: none;" onchange="handleAvatarUpload(event)" />

            <div class="profile-name">
              <%= user.username.charAt(0).toUpperCase() + user.username.slice(1) %>
            </div>
            <div class="profile-badge">Member since <%= new Date(user.createdAt).getFullYear() %></div>

            <button class="btn-upload" onclick="document.getElementById('avatarInput').click()">Upload New Avatar</button>
            <button class="btn-remove" onclick="removePhoto()">Remove Photo</button>
          </div>
        </div>

        <div class="right-col">
          <div class="section-title">Personal Info</div>
          <div class="fields-row">
            <div class="field-group">
              <label for="username">Username</label>
              <input type="text" id="username" value="<%= user.username %>" disabled/>
            </div>
            <div class="field-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" value="<%= user.email %>" disabled/>
            </div>
          </div>

          <hr class="divider" />

          <div class="section-title">Security</div>

          <div class="field-group">
            <label for="currentPw">Current Password</label>
            <input type="password" id="currentPw" placeholder="Enter your current password" />
          </div>

          <div class="fields-row" style="margin-top: 16px">
            <div class="field-group">
              <label for="newPw">New Password</label>
              <input type="password" id="newPw" placeholder="At least 8 characters" />
            </div>
            <div class="field-group">
              <label for="confirmPw">Confirm New Password</label>
              <input type="password" id="confirmPw" placeholder="Repeat new password" />
            </div>
          </div>

          <div class="pw-bottom">
            <div class="hint">
              <span class="hint-icon">
                <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10" /><path d="M12 16v-4M12 8h.01" />
                </svg>
              </span>
              <span class="hint-text">Password must be at least 8 characters and include a mix of uppercase, numbers, and symbols.</span>
            </div>
            <button class="btn-update-pw" onclick="updatePassword()">Update Password</button>
          </div>
          <div class="bottom-actions">
            <button class="btn-discard" onclick="openDiscardModal()">Discard Changes</button>
            <button class="btn-save" onclick="saveChanges()">Save Changes</button>
          </div>
        </div>
      </div>
    </main>

    <footer>
      <span class="footer-copy">Copyright 2026 EMS Management</span>
      <div class="footer-links">
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Service</a>
        <a href="#">Contact</a>
      </div>
    </footer>

    <div id="toast"></div>
    <div class="modal-backdrop" id="discardModal">
      <div class="modal">
        <h3>Discard Changes?</h3>
        <p>All unsaved changes will be lost. This action cannot be undone.</p>
        <div class="modal-btns">
          <button class="btn-cancel-modal" onclick="closeDiscardModal()">Cancel</button>
          <button class="btn-confirm-discard" onclick="confirmDiscard()">Discard</button>
        </div>
      </div>
    </div>

    <script src="/js/profile.js"></script>
    <% if (user && user.role === 'admin') { %>
      <script>
        const userTrigger = document.getElementById('userTrigger');
        const userDropdown = document.getElementById('userDropdown');
        const notifBtn = document.getElementById('notifBtn');
        const notifDropdown = document.getElementById('notifDropdown');
        const notifList = document.getElementById('notifList');
        const notifDot = document.getElementById('notifDot');

        if (userTrigger) {
            userTrigger.addEventListener('click', (e) => {
                e.stopPropagation();
                userDropdown.classList.toggle('show');
                notifDropdown.classList.remove('show');
            });
            document.addEventListener('click', () => {
                userDropdown.classList.remove('show');
                notifDropdown.classList.remove('show');
            });
        }

        notifBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            notifDropdown.classList.toggle('show');
            userDropdown.classList.remove('show');
            if (notifDropdown.classList.contains('show')) {
                fetchNotifications();
            }
        });

        async function fetchNotifications() {
            try {
                const response = await fetch('/admin/notifications');
                const data = await response.json();
                renderNotifications(data);
            } catch (err) {
                console.error('Error fetching notifications:', err);
                notifList.innerHTML = '<p class="notif-empty">Failed to load</p>';
            }
        }

        function renderNotifications(notifications) {
            if (!notifications || notifications.length === 0) {
                notifList.innerHTML = '<p class="notif-empty">No new bookings</p>';
                notifDot.style.display = 'none';
                return;
            }
            notifDot.style.display = 'block';
            notifList.innerHTML = notifications.map(n => {
                const eventName = n.eventId ? (n.eventId.eventName || n.eventId.title) : 'Event';
                const date = new Date(n.createdAt).toLocaleString('en-US', { 
                    month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' 
                });
                return `
                    <div class="notif-item-admin">
                        <p class="notif-item-title">${n.userName} booked</p>
                        <p class="notif-item-sub">${eventName} · ${n.ticketCount}</p>
                        <p class="notif-time">${date}</p>
                    </div>
                `;
            }).join('');
        }
        fetchNotifications();
      </script>
      <style>
        .notif-item-admin { padding: 12px; background: #f8fafc; border-radius: 10px; margin-bottom: 10px; border: 1px solid transparent; }
        .notif-item-admin:hover { background: #f1f5f9; border-color: #e2e8f0; }
        .notif-item-title { font-size: 13px; font-weight: 600; color: #0f172a; margin-bottom: 2px; }
        .notif-item-sub { font-size: 12px; color: #64748b; }
      </style>
    <% } %>
  </body>
</html>
