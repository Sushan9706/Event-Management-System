<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title><%= event.eventName %> – EMS</title>

    <link rel="stylesheet" href="/css/event.css" />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="navbar">
      <div class="logo">EMS</div>

      <nav class="nav-links">
        <a href="/user">Home</a>
        <a href="/catalog">Events</a>
        <a href="/bookings">My Bookings</a>
      </nav>

      <div class="nav-icons">
        <button class="icon-btn" aria-label="Notifications" id="notifBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
          </svg>
        </button>
      </div>
    </header>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-bg">
        <img
          src="<%= event.image || event.imagePath || 'https://via.placeholder.com/1200x600' %>"
          alt="<%= event.eventName %>"  
          class="hero-img"
        />
        <div class="hero-overlay"></div>
      </div>

      <div class="hero-content">
        <span class="featured-badge">FEATURED EXPERIENCE</span>

        <h1 class="hero-title">
          <%= event.eventName %>
        </h1>
      </div>
    </section>

    <!-- BODY -->
    <div class="page-body">
      <div class="content-col">

        <!-- META -->
        <div class="meta-cards">
          <div class="meta-card">
            <p class="meta-label">WHEN</p>
            <p class="meta-value large">
              <%= new Date(event.date).toDateString() %>
            </p>
            <p class="meta-sub"><%= event.time || "TBA" %></p>
          </div>

          <div class="meta-card">
            <p class="meta-label">WHERE</p>
            <p class="meta-value large"><%= event.location %></p>
            <p class="meta-sub">Event Location</p>
          </div>

          <div class="meta-card">
            <p class="meta-label">CATEGORY</p>
            <p class="meta-value large">
              <%= event.category || (event.categoryId?.name || "General") %>
            </p>
            <p class="meta-sub">Event Type</p>
          </div>
        </div>

        <!-- DESCRIPTION -->
        <div class="vision">
          <h2>Description</h2>
          <p>
            <%= event.description || "No description available for this event." %>
          </p>
        </div>

        <!-- LOCATION -->
        <div class="location-section">
          <div class="location-header">
            <h2>Location</h2>
            <a href="#" class="get-directions">Get Directions</a>
          </div>

          <div class="map-container">
            <img
              src="https://gisgeography.com/wp-content/uploads/2017/10/Japan-Map-1265x1223.jpg"
              alt="Map"
              class="map-img"
            />
          </div>
        </div>
      </div>

      <!-- SIDEBAR -->
      <aside class="booking-sidebar">
        <p class="entry-label">STANDARD ENTRY</p>

        <div class="price-row">
          <span class="price">
            $<%= event.ticketPrice || 0 %>
          </span>
          <span class="price-per">/ per guest</span>
        </div>

        <ul class="perks">
          <li>✔ Full access to event</li>
          <li>✔ Networking opportunities</li>
          <li>✔ Digital pass</li>
        </ul>

        <button class="book-btn" onclick="handleBooking()">Book Now</button>

        <p class="secure-note">
          SECURE CHECKOUT POWERED BY EMS
        </p>
      </aside>
    </div>

    <!-- BOOKING MODAL -->
    <div id="bookingModal" style="display:none;">
      <div>
        <h3>Booking Confirmed!</h3>
        <p><%= event.eventName %></p>
        <button onclick="closeBooking()">Done</button>
      </div>
    </div>

    <!-- FOOTER -->
    <footer class="footer">
      <p>COPYRIGHT 2026 EMS MANAGEMENT</p>
      <div class="footer-links">
        <a href="#">PRIVACY POLICY</a>
        <a href="#">TERMS</a>
        <a href="#">CONTACT</a>
      </div>
    </footer>

    <script>
      function handleBooking() {
        document.getElementById("bookingModal").style.display = "flex";
      }

      function closeBooking() {
        document.getElementById("bookingModal").style.display = "none";
        window.location.href = "/user";
      }
    </script>
  </body>
</html>