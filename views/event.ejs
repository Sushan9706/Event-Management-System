<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Global Architecture Summit 2026 – EMS</title>
    <link rel="stylesheet" href="stylesheets/event.css" />
    <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"n"
    rel="stylesheet" />
  </head>
  <body>
    <header class="navbar">
      <div class="logo">EMS</div>
      <nav class="nav-links">
        <a href="guest.html" class="active">Events</a>
        <a href="user.html">My Bookings</a>
        <a href="user.html">Profile</a>
      </nav>
      <div class="nav-icons">
        <button class="icon-btn" aria-label="Search" id="searchBtn">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </button>
        <button class="icon-btn" aria-label="Notifications" id="notifBtn">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
          </svg>
        </button>
        <div class="avatar" id="avatarBtn" style="cursor: pointer">
          <img
            src="https://img.freepik.com/free-vector/smiling-young-man-illustration_1308-174669.jpg?semt=ais_hybrid&w=740&q=80"
            alt="User"
            onerror="this.style.display='none'"
          />
        </div>
      </div>
    </header>

    <section class="hero">
      <div class="hero-bg">
        <img
          src="https://images.unsplash.com/photo-1633507170063-253c395b532c?q=80&w=2232&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
          alt="Architecture"
        />
        class="hero-img" onerror="this.style.display='none'" />
        <div class="hero-overlay"></div>
      </div>
      <div class="hero-content">
        <span class="featured-badge">FEATURED EXPERIENCE</span>
        <h1 class="hero-title">
          Global Architecture<br />Summit <span class="year">2026</span>
        </h1>
      </div>
    </section>

    <div class="page-body">
      <div class="content-col">
        <div class="meta-cards">
          <div class="meta-card">
            <p class="meta-label">WHEN</p>
            <p class="meta-value large">Oct 14–16</p>
            <p class="meta-sub">09:00 AM – 06:00 PM</p>
          </div>
          <div class="meta-card">
            <p class="meta-label">WHERE</p>
            <p class="meta-value large">The Glass<br />Pavilion</p>
            <p class="meta-sub">Tokyo, Japan</p>
          </div>
          <div class="meta-card">
            <p class="meta-label">TIER</p>
            <p class="meta-value large">Premium</p>
            <p class="meta-sub">Access All Areas</p>
          </div>
        </div>

        <div class="vision">
          <h2>The Vision for Tomorrow</h2>
          <p>
            The 2026 EMS Global Architecture Summit brings together visionaries,
            lead architects, and urban planners from across the globe to
            redefine the boundaries of structural integrity and aesthetic
            innovation. This year's theme, "Fluidity and Form," explores how
            sustainable materials can adapt to rapidly shifting urban
            environments.
          </p>
          <p>
            Join us for three days of immersive keynote sessions, hands-on
            workshops with sustainable concrete alternatives, and networking
            events set against the backdrop of Tokyo's most iconic modern
            structures. Attendees will gain exclusive access to the preliminary
            blueprints of the Sky-Garden Project, launching in late 2027.
          </p>
        </div>

        <div class="location-section">
          <div class="location-header">
            <h2>Location</h2>
            <a href="#" class="get-directions">
              Get Directions
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" y1="14" x2="21" y2="3" />
              </svg>
            </a>
          </div>
          <div class="map-container">
            <img
              src="https://gisgeography.com/wp-content/uploads/2017/10/Japan-Map-1265x1223.jpg"
              alt="Map of Tokyo, Japan"
              class="map-img"
              onerror="this.innerHTML=''"
            />
            <div class="map-pin">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="#1a1a2e"
                stroke="white"
                stroke-width="1.5"
              >
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                <circle cx="12" cy="10" r="3" fill="white" stroke="none" />
              </svg>
            </div>
          </div>
        </div>
      </div>

      <aside class="booking-sidebar">
        <p class="entry-label">STANDARD ENTRY</p>
        <div class="price-row">
          <span class="price">$850</span>
          <span class="price-per">/ per guest</span>
        </div>
        <ul class="perks">
          <li>
            <span class="check-icon">✔</span>
            Full access to all keynote sessions
          </li>
          <li>
            <span class="check-icon">✔</span>
            Lunch &amp; Evening Networking Mixers
          </li>
          <li>
            <span class="check-icon">✔</span>
            Digital Certification of Attendance
          </li>
        </ul>
        <button class="book-btn" onclick="handleBooking()">Book Now</button>
        <p class="secure-note">
          SECURE CHECKOUT POWERED BY EMS GLOBAL<br />NO HIDDEN PROCESSING FEES.
        </p>
      </aside>
    </div>

    <div
      id="notifDropdown"
      style="
        display: none;
        position: fixed;
        top: 66px;
        right: 80px;
        width: 280px;
        background: #fff;
        border: 1px solid #e2e4e8;
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
        z-index: 400;
        padding: 16px;
      "
    >
      <p
        style="
          font-size: 11px;
          font-weight: 700;
          letter-spacing: 0.1em;
          color: #888;
          margin-bottom: 12px;
        "
      >
        NOTIFICATIONS
      </p>
      <div style="display: flex; flex-direction: column; gap: 10px">
        <div style="padding: 10px; background: #f4f4f6; border-radius: 7px">
          <p
            style="
              font-size: 12.5px;
              font-weight: 600;
              color: #1a1a2e;
              margin-bottom: 2px;
            "
          >
            Booking Confirmed
          </p>
          <p style="font-size: 11px; color: #888">
            Modernist Expo 2026 · #EMS-29402
          </p>
        </div>
        <div style="padding: 10px; background: #f4f4f6; border-radius: 7px">
          <p
            style="
              font-size: 12.5px;
              font-weight: 600;
              color: #1a1a2e;
              margin-bottom: 2px;
            "
          >
            Event Reminder
          </p>
          <p style="font-size: 11px; color: #888">
            Global AI Summit starts in 3 days
          </p>
        </div>
      </div>
    </div>

    <div
      id="searchOverlay"
      style="
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 500;
        align-items: flex-start;
        justify-content: center;
        padding-top: 100px;
      "
    >
      <div
        style="
          background: #fff;
          border-radius: 10px;
          padding: 20px;
          width: 500px;
          max-width: 90%;
        "
      >
        <input
          type="text"
          id="searchInput"
          placeholder="Search events..."
          style="
            width: 100%;
            padding: 10px 14px;
            border: 1px solid #e2e4e8;
            border-radius: 6px;
            font-size: 14px;
            outline: none;
          "
        />
        <p
          style="
            font-size: 11px;
            color: #888;
            margin-top: 8px;
            text-align: center;
          "
        >
          Press ESC to close
        </p>
      </div>
    </div>

    <div
      id="evOverlay"
      style="display: none; position: fixed; inset: 0; z-index: 300"
    ></div>
    <aside
      id="evSidebar"
      style="
        position: fixed;
        top: 0;
        right: -260px;
        width: 240px;
        height: 100vh;
        background: #fff;
        border-left: 1px solid #e2e4e8;
        z-index: 301;
        padding: 56px 0 20px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        transition: right 0.22s ease;
        box-shadow: -4px 0 20px rgba(0, 0, 0, 0.07);
      "
    >
      <a
        href="user.html"
        style="
          display: flex;
          align-items: center;
          gap: 10px;
          padding: 11px 22px;
          font-size: 13px;
          font-weight: 500;
          color: #1a1a2e;
          text-decoration: none;
        "
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </svg>
        My Profile
      </a>
      <a
        href="user.html"
        style="
          display: flex;
          align-items: center;
          gap: 10px;
          padding: 11px 22px;
          font-size: 13px;
          font-weight: 500;
          color: #1a1a2e;
          text-decoration: none;
        "
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <rect x="3" y="4" width="18" height="18" rx="2" />
          <line x1="16" y1="2" x2="16" y2="6" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="3" y1="10" x2="21" y2="10" />
        </svg>
        My Bookings
      </a>
      <div style="height: 1px; background: #e2e4e8; margin: 6px 22px"></div>
      <button
        id="evLogoutBtn"
        style="
          display: flex;
          align-items: center;
          gap: 10px;
          padding: 11px 22px;
          font-size: 13px;
          font-weight: 500;
          color: #c0392b;
          background: none;
          border: none;
          width: 100%;
          text-align: left;
          cursor: pointer;
        "
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
          <polyline points="16 17 21 12 16 7" />
          <line x1="21" y1="12" x2="9" y2="12" />
        </svg>
        Log Out
      </button>
    </aside>

    <div
      id="bookingModal"
      style="
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        z-index: 400;
        align-items: center;
        justify-content: center;
      "
    >
      <div
        style="
          background: #fff;
          border-radius: 12px;
          padding: 32px 28px;
          width: 340px;
          text-align: center;
        "
      >
        <div style="font-size: 40px; margin-bottom: 12px">🎟️</div>
        <h3
          style="
            font-size: 17px;
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 8px;
          "
        >
          Booking Confirmed!
        </h3>
        <p style="font-size: 13px; color: #555; margin-bottom: 4px">
          Global Architecture Summit 2026
        </p>
        <p style="font-size: 12px; color: #888; margin-bottom: 24px">
          Oct 14–16 · Tokyo, Japan · $850
        </p>
        <button
          onclick="closeBooking()"
          style="
            background: #1a1a2e;
            color: #fff;
            border: none;
            padding: 10px 28px;
            border-radius: 7px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
          "
        >
          Done
        </button>
      </div>
    </div>

    <footer class="footer">
      <p>COPYRIGHT 2026 EMS MANAGEMENT</p>
      <div class="footer-links">
        <a href="#">PRIVACY POLICY</a>
        <a href="#">TERMS OF SERVICE</a>
        <a href="#">CONTACT</a>
      </div>
    </footer>
    <script>
      const searchOverlay = document.getElementById("searchOverlay");
      document.getElementById("searchBtn").addEventListener("click", () => {
        searchOverlay.style.display =
          searchOverlay.style.display === "flex" ? "none" : "flex";
        if (searchOverlay.style.display === "flex")
          document.getElementById("searchInput").focus();
      });
      searchOverlay.addEventListener("click", (e) => {
        if (e.target === searchOverlay) searchOverlay.style.display = "none";
      });

      const notifDropdown = document.getElementById("notifDropdown");
      document.getElementById("notifBtn").addEventListener("click", (e) => {
        e.stopPropagation();
        notifDropdown.style.display =
          notifDropdown.style.display === "block" ? "none" : "block";
      });
      document.addEventListener("click", () => {
        notifDropdown.style.display = "none";
      });

      const evSidebar = document.getElementById("evSidebar");
      const evOverlay = document.getElementById("evOverlay");
      function openSidebar() {
        evSidebar.style.right = "0";
        evOverlay.style.display = "block";
      }
      function closeSidebar() {
        evSidebar.style.right = "-260px";
        evOverlay.style.display = "none";
      }
      document
        .getElementById("avatarBtn")
        .addEventListener("click", () =>
          evSidebar.style.right === "0px" ? closeSidebar() : openSidebar()
        );
      evOverlay.addEventListener("click", closeSidebar);

      document.getElementById("evLogoutBtn").addEventListener("click", () => {
        if (confirm("Are you sure you want to log out?"))
          window.location.href = "guest.html";
      });

      function handleBooking() {
        document.getElementById("bookingModal").style.display = "flex";
      }
      function closeBooking() {
        document.getElementById("bookingModal").style.display = "none";
        window.location.href = "user.html";
      }
      document
        .getElementById("bookingModal")
        .addEventListener("click", function (e) {
          if (e.target === this) this.style.display = "none";
        });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          searchOverlay.style.display = "none";
          notifDropdown.style.display = "none";
          closeSidebar();
        }
      });
    </script>
  </body>
</html>
