<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact Us - EMS</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/common-nav.css" />
  <link rel="stylesheet" href="/css/policies.css" />
  <link rel="stylesheet" href="/css/catalog.css" />
</head>
<body>
  <header class="navbar">
    <div class="nav-inner">
      <a href="<%= locals.user ? (locals.user.role === 'admin' ? '/admin/dashboard' : '/user') : '/guest' %>" class="nav-logo" style="text-decoration: none; color: #1e293b !important; font-size: 1.25rem !important; font-weight: 800 !important; letter-spacing: normal !important; font-family: 'DM Sans', sans-serif !important;">EMS</a>
      
      <nav class="nav-center">
        <a href="/user" class="nav-link">Home</a>
        <a href="/catalog" class="nav-link">Events</a>
        <a href="/venue" class="nav-link">Venues</a>
        <% if (locals.user) { %>
        <a href="/bookings" class="nav-link">My Bookings</a>
        <% } %>
      </nav>

      <div class="nav-right">
        <% if (locals.user) { %>
          <img src="<%= (locals.user && user.profileImage) ? user.profileImage : 'https://ui-avatars.com/api/?name=' + (locals.user ? user.username : 'User') + '&background=e74c3c&color=fff' %>" 
               alt="User avatar" class="avatar-circle" id="profileTrigger" />
        <% } else { %>
          <a href="/login" class="nav-link">Login</a>
        <% } %>
      </div>
    </div>
  </header>

  <div class="policy-header">
    <h1>Get in Touch</h1>
    <p>Have a question about an event, venue booking or your account? We are here to help. Fill in the form below and we will get back to you as soon as possible.</p>
  </div>

  <main class="policy-container">
    <form class="contact-form" action="/contact" method="POST">
      <div class="form-group">
        <label for="name">Full Name <span style="color: #e74c3c;">*</span></label>
        <input type="text" id="name" name="name" required placeholder="John Doe" />
      </div>

      <div class="form-group">
        <label for="email">Email Address <span style="color: #e74c3c;">*</span></label>
        <input type="email" id="email" name="email" required placeholder="john@example.com" />
      </div>

      <div class="form-group">
        <label for="subject">Subject</label>
        <select id="subject" name="subject">
          <option value="General Enquiry">General Enquiry</option>
          <option value="Booking Issue">Booking Issue</option>
          <option value="Payment Issue">Payment Issue</option>
          <option value="Account Issue">Account Issue</option>
          <option value="Venue Enquiry">Venue Enquiry</option>
          <option value="Report a Problem">Report a Problem</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div class="form-group">
        <label for="message">Message <span style="color: #e74c3c;">*</span></label>
        <textarea id="message" name="message" required placeholder="How can we help you?"></textarea>
      </div>

      <button type="submit" class="btn-submit">Submit Form</button>

      <% if (locals.success && locals.success.length > 0) { %>
        <div style="padding: 15px; background: #d4edda; color: #155724; border-radius: 8px; margin-top: 15px;">
          <%= locals.success %>
        </div>
      <% } %>
      <% if (locals.error && locals.error.length > 0) { %>
        <div style="padding: 15px; background: #f8d7da; color: #721c24; border-radius: 8px; margin-top: 15px;">
          <%= locals.error %>
        </div>
      <% } %>
    </form>

    <div class="contact-notice">
      <p><strong>Response time:</strong> We aim to respond to all enquiries within 2 business days.</p>
      <p><strong>Note about refunds:</strong> Please note that all payments made on EMS are strictly non-refundable. For more information please read our <a href="/terms">Terms of Service</a>.</p>
    </div>
  </main>

  <footer class="footer">
    <span class="footer-copy">COPYRIGHT © 2026 EMS. ALL RIGHTS RESERVED.</span>
    <div class="footer-links">
      <a href="/privacy">PRIVACY POLICY</a>
      <a href="/terms">TERMS OF SERVICE</a>
      <a href="/contact">CONTACT</a>
    </div>
  </footer>

  <% if (locals.user) { %>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
  <aside class="avatar-sidebar" id="avatarSidebar">
      <div class="sidebar-user-info">
          Hi, <%= (locals.user && user.username) ? user.username.charAt(0).toUpperCase() + user.username.slice(1) : 'User' %>
      </div>
      <div class="sidebar-divider"></div>
      <a href="/profile" class="sidebar-link">My Profile</a>
      <div class="sidebar-divider"></div>
      <a href="/logout" class="sidebar-logout" id="logoutBtn">Log Out</a>
  </aside>
  <% } %>

  <script src="/js/user.js"></script>
</body>
</html>
