<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EMS – Curated Experiences</title>
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/catalog.css" />
  </head>
  <body>
    <header class="navbar">
      <div class="nav-inner">
        <div class="nav-logo">EMS</div>
        <nav class="nav-links">
          <a href="/user" class="active">Home</a>
          <a href="/catalog">Events</a>
          <a href="/bookings">My Bookings</a>
        </nav>
        <div class="nav-right">
          <button
            class="icon-btn"
            id="searchBtn"
            aria-label="Search"
            style="display: none"
          >
            <svg
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </button>
          <button class="icon-btn" id="notifBtn" aria-label="Notifications">
            <svg
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
              <path d="M13.73 21a2 2 0 0 1-3.46 0" />
            </svg>
            <span class="notif-dot"></span>
          </button>
          <div class="avatar-btn" id="avatarBtn">
            <img
              src="https://img.freepik.com/free-vector/smiling-young-man-illustration_1308-174669.jpg?semt=ais_hybrid&w=740&q=80"
              alt="User"
              onerror="this.style.background='#ccc'"
            />
          </div>
        </div>
      </div>
    </header>

    <div class="notif-dropdown" id="notifDropdown">
      <p class="notif-title">NOTIFICATIONS</p>
      <div class="notif-item">
        <p class="notif-item-title">Booking Confirmed</p>
        <p class="notif-item-sub">Modernist Expo 2026 · #EMS-29402</p>
      </div>
      <div class="notif-item">
        <p class="notif-item-title">Event Reminder</p>
        <p class="notif-item-sub">Global AI Summit starts in 3 days</p>
      </div>
      <div class="notif-item">
        <p class="notif-item-title">New Event Added</p>
        <p class="notif-item-sub">The Artisan's Table: Winter Solstice</p>
      </div>
    </div>

    <div class="search-overlay" id="searchOverlay">
      <div class="search-box">
        <input
          type="text"
          id="searchInput"
          placeholder="Search for events, venues, or cities..."
        />
        <p class="search-hint">Press ESC to close</p>
      </div>
    </div>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <aside class="avatar-sidebar" id="avatarSidebar">
      <a href="/user" class="sidebar-link">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </svg>
        My Profile
      </a>
      <div class="sidebar-divider"></div>
      <button class="sidebar-logout" id="logoutBtn">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
          <polyline points="16 17 21 12 16 7" />
          <line x1="21" y1="12" x2="9" y2="12" />
        </svg>
        Log Out
      </button>
    </aside>

    <section class="hero">
      <h1>Curated <span>Experiences.</span></h1>
      <div class="search-bar">
        <div class="search-bar-input">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            type="text"
            id="heroSearch"
            placeholder="Search for events, venues, or cities..."
          />
        </div>
        <button class="btn-find" id="findBtn">Find Events</button>
      </div>
    </section>

    <div class="filters" id="filters">
      <button class="filter-tag active" data-filter="all">All Events</button>
      <button class="filter-tag" data-filter="music">Music</button>
      <button class="filter-tag" data-filter="tech">Technology</button>
      <button class="filter-tag" data-filter="sports">Sports</button>
      <button class="filter-tag" data-filter="arts">Arts</button>
      <button class="filter-tag" data-filter="food">Food and Drink</button>
      <button class="filter-tag" data-filter="networking">Networking</button>
      <button class="filter-tag" data-filter="education">Education</button>
      <button class="filter-tag" data-filter="other">Other</button>
    </div>

    <section class="events-section">
      <div class="events-grid" id="eventsGrid">
        <% if (typeof events !== 'undefined' && events.length > 0) { %>
          <% events.forEach(event => { 
               // Determine category class/slug
               let catStr = (event.category || 'other').toLowerCase();
               if(event.categoryId && event.categoryId.name) {
                   catStr = event.categoryId.name.toLowerCase();
               }
               // Get image
               let imgUrl = event.image || event.imagePath || 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=600&auto=format&fit=crop';
               if(imgUrl && !imgUrl.startsWith('http') && !imgUrl.startsWith('/')) {
                   imgUrl = '/' + imgUrl;
               }
               // Dates
               let eventDate = new Date(event.date).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
               // Price
               let isFree = event.ticketPrice === 0;
               let displayPrice = isFree ? "Free Admission" : "$" + event.ticketPrice.toFixed(2);
          %>
            <div class="event-card" data-id="<%= event._id %>" data-category="<%= catStr %>">
              <div class="card-img">
                <img src="<%= imgUrl %>" alt="<%= event.eventName || event.title %>" />
                <span class="card-tag tag-<%= catStr %>"><%= event.category || (event.categoryId ? event.categoryId.name : 'Other') %></span>
              </div>
              <div class="card-body">
                <p class="card-name"><%= event.eventName || event.title %></p>
                <div class="card-meta">
                  <div class="card-meta-row">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="4" width="18" height="18" rx="2" />
                      <line x1="16" y1="2" x2="16" y2="6" />
                      <line x1="8" y1="2" x2="8" y2="6" />
                      <line x1="3" y1="10" x2="21" y2="10" />
                    </svg>
                    <%= eventDate %>
                  </div>
                  <div class="card-meta-row">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                      <circle cx="12" cy="10" r="3" />
                    </svg>
                    <%= event.location %>
                  </div>
                </div>
                <div class="card-footer">
                  <span class="card-price <%= isFree ? 'free' : '' %>"><%= displayPrice %></span>
                  <button class="btn-details" onclick="openModal(this)">
                    Details →
                  </button>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <p style="text-align: center; grid-column: 1 / -1; margin-top: 2rem;">No events found dynamically. Create some in the admin panel!</p>
        <% } %>
      </div>

      <div class="load-more-wrap">
        <button class="btn-load" id="loadMoreBtn">
          Load More Events
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>
      </div>
    </section>

    <div class="event-modal" id="eventModal">
      <div class="modal-box">
        <span class="modal-tag" id="modalTag"></span>
        <p class="modal-name" id="modalName"></p>
        <div class="modal-meta">
          <div class="modal-meta-row" id="modalDate"></div>
          <div class="modal-meta-row" id="modalLocation"></div>
        </div>
        <p class="modal-price" id="modalPrice"></p>
        <div class="modal-actions">
          <button class="btn-book" onclick="confirmBooking()">Book Now</button>
          <button class="btn-close-modal" onclick="closeModal()">Close</button>
        </div>
      </div>
    </div>

    <div class="booking-modal" id="bookingModal">
      <div class="booking-box">
        <div class="booking-emoji">🎟️</div>
        <p class="booking-title">Booking Confirmed!</p>
        <p class="booking-sub" id="bookingEventName"></p>
        <p class="booking-detail" id="bookingDetail"></p>
        <button class="btn-done" onclick="closeBooking()">Done</button>
      </div>
    </div>

    <footer class="footer">
      <span class="footer-copy">COPYRIGHT 2026 EMS MANAGEMENT</span>
      <div class="footer-links">
        <a href="#">PRIVACY POLICY</a>
        <a href="#">TERMS OF SERVICE</a>
        <a href="#">CONTACT</a>
      </div>
    </footer>

    <script src="/js/catalog.js"></script>
  </body>
</html>
