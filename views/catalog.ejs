    <div class="event-modal" id="eventModal">
      <div class="modal-box">
        <span class="modal-tag" id="modalTag"></span>
        <p class="modal-name" id="modalName"></p>
        <div class="modal-meta">
          <div class="modal-meta-row" id="modalDate"></div>
          <div class="modal-meta-row" id="modalLocation"></div>
        </div>
        <p class="modal-price" id="modalPrice"></p>
        <div class="modal-actions">
          <button class="btn-book" onclick="confirmBooking()">Book Now</button>
          <button class="btn-close-modal" onclick="closeModal()">Close</button>
        </div>
      </div>
    </div>

    <div class="booking-modal" id="bookingModal">
      <div class="booking-box">
        <div class="booking-emoji">🎟️</div>
        <p class="booking-title">Booking Confirmed!</p>
        <p class="booking-sub" id="bookingEventName"></p>
        <p class="booking-detail" id="bookingDetail"></p>
        <button class="btn-done" onclick="closeBooking()">Done</button>
      </div>
    </div>

    <footer class="footer">
      <span class="footer-copy">COPYRIGHT 2026 EMS MANAGEMENT</span>
      <div class="footer-links">
        <a href="#">PRIVACY POLICY</a>
        <a href="#">TERMS OF SERVICE</a>
        <a href="#">CONTACT</a>
      </div>
