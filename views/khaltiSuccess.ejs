<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Status - EMS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #f7f1ee;
        --card: #ffffff;
        --border: #ece0d9;
        --text: #1f2031;
        --muted: #70728a;
        --navy: #23253d;
        --green: #2f8f46;
        --amber: #bb7d1f;
        --red: #c0392b;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        min-height: 100vh;
        font-family: "DM Sans", sans-serif;
        background:
          radial-gradient(circle at top left, rgba(205, 227, 210, 0.45), transparent 24%),
          radial-gradient(circle at top right, rgba(242, 218, 195, 0.55), transparent 28%),
          var(--bg);
        color: var(--text);
      }

      .balloon-celebration {
        position: fixed;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
        z-index: 1;
      }

      .celebration-balloon {
        position: absolute;
        width: 24px;
        height: 32px;
        border-radius: 50% 50% 46% 46%;
        background: var(--color);
        box-shadow: inset -5px -8px 0 rgba(255, 255, 255, 0.18);
        opacity: 0.95;
      }

      .celebration-balloon::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: -12px;
        width: 2px;
        height: 18px;
        background: rgba(31, 32, 49, 0.22);
        transform: translateX(-50%);
      }

      .celebration-balloon.from-left,
      .celebration-balloon.from-right {
        top: var(--start-y);
        animation: drift-horizontal 1.8s ease-out var(--delay) forwards;
      }

      .celebration-balloon.from-left { left: -36px; }
      .celebration-balloon.from-right { right: -36px; }

      .celebration-balloon.from-top,
      .celebration-balloon.from-bottom {
        left: var(--start-x);
        animation: drift-vertical 1.8s ease-out var(--delay) forwards;
      }

      .celebration-balloon.from-top { top: -38px; }
      .celebration-balloon.from-bottom { bottom: -38px; }

      .balloon-pop-particle {
        position: absolute;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--color);
        opacity: 0;
        animation: burst-particle 1.2s ease-out forwards;
      }

      .page-shell {
        position: relative;
        z-index: 2;
        width: min(100%, 1040px);
        margin: 0 auto;
        padding: 32px 20px 56px;
      }

      .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 36px;
      }

      .brand {
        font-weight: 800;
        letter-spacing: 0.08em;
      }

      .topbar a {
        color: var(--muted);
        text-decoration: none;
        font-size: 14px;
      }

      .status-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 22px;
        padding: 28px;
        box-shadow: 0 24px 48px rgba(35, 37, 61, 0.08);
      }

      .eyebrow {
        font-size: 12px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 12px;
        font-weight: 700;
      }

      .headline {
        display: flex;
        gap: 16px;
        align-items: center;
      }

      .icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 28px;
        font-weight: 800;
        background: #edf7ef;
        color: var(--green);
      }

      h1 {
        font-size: clamp(28px, 3vw, 38px);
        line-height: 1.05;
        margin-bottom: 8px;
      }

      .copy {
        color: var(--muted);
        font-size: 15px;
        line-height: 1.7;
        max-width: 650px;
      }

      .meta-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 14px;
        margin-top: 24px;
      }

      .meta-card {
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 16px;
        background: #fcfaf8;
      }

      .meta-card span {
        display: block;
        font-size: 11px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 8px;
      }

      .meta-card strong {
        display: block;
        font-size: 16px;
        word-break: break-word;
      }

      .meta-card.timer strong {
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.04em;
        font-size: 28px;
        line-height: 1;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 24px;
      }

      .btn {
        border: none;
        border-radius: 999px;
        padding: 14px 20px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
      }

      .btn-primary {
        background: var(--navy);
        color: #fff;
      }

      .btn-secondary {
        background: #fff;
        color: var(--navy);
        border: 1px solid var(--border);
      }

      .helper {
        margin-top: 18px;
        font-size: 13px;
        color: var(--muted);
      }

      .helper strong {
        color: var(--text);
      }

      @keyframes drift-horizontal {
        to {
          transform: translate(var(--move-x), var(--move-y)) rotate(12deg) scale(1.05);
          opacity: 0;
        }
      }

      @keyframes drift-vertical {
        to {
          transform: translate(var(--move-x), var(--move-y)) rotate(-12deg) scale(1.05);
          opacity: 0;
        }
      }

      @keyframes burst-particle {
        0% {
          opacity: 1;
          transform: translate(0, 0) scale(1);
        }
        100% {
          opacity: 0;
          transform: translate(var(--piece-x), var(--piece-y)) scale(0.2);
        }
      }
    </style>
  </head>
  <body>
    <div class="balloon-celebration" id="balloonCelebration" aria-hidden="true"></div>

    <main class="page-shell">
      <div class="topbar">
        <div class="brand">EMS</div>
        <a href="/bookings">Back to My Bookings</a>
      </div>

      <section class="status-card">
        <p class="eyebrow" id="providerLabel"><%= provider === 'free' ? 'EMS' : 'Khalti' %></p>
        <div class="headline">
          <div class="icon" id="statusIcon">…</div>
          <div>
            <h1 id="statusTitle"><%= provider === 'free' ? 'Booking Successful' : 'Verifying payment...' %></h1>
            <p class="copy" id="statusMessage"><%= provider === 'free' ? 'Your booking is confirmed and ready inside My Bookings.' : 'We are checking the Khalti payment status before confirming your booking.' %></p>
          </div>
        </div>

        <div class="meta-grid">
          <div class="meta-card">
            <span id="metaLabel">EVENT</span>
            <strong id="pidxValue"><%= eventName || pidx || bookingId || 'Not available' %></strong>
          </div>
          <div class="meta-card">
            <span>Status</span>
            <strong id="paymentStatus">Checking</strong>
          </div>
          <div class="meta-card timer" id="timerCard" hidden>
            <strong id="countdownValue">30:00</strong>
          </div>
        </div>

        <div class="actions">
          <a class="btn btn-primary" id="primaryAction" href="/bookings">Go to My Bookings</a>
          <a class="btn btn-secondary" href="/catalog">Browse Events</a>
        </div>

      </section>
    </main>

    <script>
      const initialPidx = "<%= pidx %>";
      const initialBookingId = "<%= bookingId %>";
      const statusIcon = document.getElementById("statusIcon");
      const statusTitle = document.getElementById("statusTitle");
      const statusMessage = document.getElementById("statusMessage");
      const paymentStatus = document.getElementById("paymentStatus");
      const primaryAction = document.getElementById("primaryAction");
      const metaLabel = document.getElementById("metaLabel");
      const timerCard = document.getElementById("timerCard");
      const countdownValue = document.getElementById("countdownValue");
      const isFreeBooking = "<%= provider %>" === "free";
      let celebrationPlayed = false;
      const paymentDeadline = Number(<%- JSON.stringify(expiresAt || null) %>) || null;
      let countdownTimer = null;

      function runBalloonCelebration() {
        if (celebrationPlayed) return;
        celebrationPlayed = true;

        const layer = document.getElementById("balloonCelebration");
        if (!layer) return;

        const colors = ["#e94f64", "#ffb84c", "#5cc8ff", "#7ed957", "#9b6dff", "#ff77bc", "#ffd166", "#4ecdc4"];
        const sides = ["left", "right", "top", "bottom"];

        const createBurst = (x, y, color, delayMs) => {
          window.setTimeout(() => {
            for (let pieceIndex = 0; pieceIndex < 8; pieceIndex += 1) {
              const piece = document.createElement("span");
              piece.className = "balloon-pop-particle";
              piece.style.setProperty("--color", color);
              piece.style.left = `${x}vw`;
              piece.style.top = `${y}vh`;
              piece.style.setProperty("--piece-x", `${Math.cos((Math.PI * 2 * pieceIndex) / 8) * (28 + (pieceIndex % 3) * 10)}px`);
              piece.style.setProperty("--piece-y", `${Math.sin((Math.PI * 2 * pieceIndex) / 8) * (28 + (pieceIndex % 3) * 10)}px`);
              layer.appendChild(piece);
              window.setTimeout(() => piece.remove(), 1200);
            }
          }, delayMs);
        };

        for (let index = 0; index < 72; index += 1) {
          const side = sides[index % sides.length];
          const color = colors[index % colors.length];
          const delaySeconds = (index % 18) * 0.03;
          const balloon = document.createElement("span");
          balloon.className = `celebration-balloon from-${side}`;
          balloon.style.setProperty("--color", color);
          balloon.style.setProperty("--delay", `${delaySeconds}s`);

          let popX = 50;
          let popY = 50;
          if (side === "left" || side === "right") {
            const startY = 6 + ((index * 13) % 86);
            const endY = 10 + ((index * 17) % 80);
            const moveX = 54 + ((index * 11) % 34);
            balloon.style.setProperty("--start-y", `${startY}vh`);
            balloon.style.setProperty("--move-x", `${side === "left" ? moveX : -moveX}vw`);
            balloon.style.setProperty("--move-y", `${endY - startY}vh`);
            popX = side === "left" ? 14 + ((index * 7) % 30) : 56 + ((index * 7) % 28);
            popY = Math.max(10, Math.min(88, startY + ((endY - startY) * 0.35)));
          } else {
            const startX = 4 + ((index * 9) % 92);
            const endX = 6 + ((index * 5) % 86);
            const moveY = 40 + ((index * 19) % 42);
            balloon.style.setProperty("--start-x", `${startX}vw`);
            balloon.style.setProperty("--move-x", `${endX - startX}vw`);
            balloon.style.setProperty("--move-y", `${side === "top" ? moveY : -moveY}vh`);
            popX = Math.max(8, Math.min(92, startX + ((endX - startX) * 0.4)));
            popY = side === "top" ? 16 + ((index * 5) % 20) : 66 + ((index * 5) % 18);
          }

          layer.appendChild(balloon);
          window.setTimeout(() => balloon.remove(), (delaySeconds * 1000) + 1900);
          createBurst(popX, popY, color, (delaySeconds * 1000) + 640);
        }
      }

      function applyStatus(status, message, actionHref, actionLabel) {
        paymentStatus.textContent = status;
        statusMessage.textContent = message;
        primaryAction.href = actionHref;
        primaryAction.textContent = actionLabel;

        if (status === "Completed") {
          statusIcon.textContent = "✓";
          statusIcon.style.background = "#edf7ef";
          statusIcon.style.color = "#2f8f46";
          statusTitle.textContent = isFreeBooking ? "Booking Successful" : "Payment Successful";
          if (countdownTimer) {
            window.clearInterval(countdownTimer);
            countdownTimer = null;
          }
          timerCard.hidden = true;
          runBalloonCelebration();
        } else if (status === "Pending") {
          statusIcon.textContent = "!";
          statusIcon.style.background = "#fff4df";
          statusIcon.style.color = "#bb7d1f";
          statusTitle.textContent = "Payment Pending";
        } else {
          statusIcon.textContent = "×";
          statusIcon.style.background = "#fdeceb";
          statusIcon.style.color = "#c0392b";
          statusTitle.textContent = "Payment Failed or Cancelled";
        }
      }

      function formatCountdown(msRemaining) {
        const totalSeconds = Math.max(Math.floor(msRemaining / 1000), 0);
        const minutes = String(Math.floor(totalSeconds / 60)).padStart(2, "0");
        const seconds = String(totalSeconds % 60).padStart(2, "0");
        return `${minutes}:${seconds}`;
      }

      function startCountdown() {
        if (!timerCard || !countdownValue || !paymentDeadline) return;
        timerCard.hidden = false;

        const tick = () => {
          const remaining = paymentDeadline - Date.now();
          if (remaining <= 0) {
            countdownValue.textContent = "00:00";
            if (paymentStatus.textContent !== "Completed") {
              applyStatus("Expired", "The 30-minute payment window expired. Please start again.", "/bookings", "Back to My Bookings");
            }
            if (countdownTimer) {
              window.clearInterval(countdownTimer);
              countdownTimer = null;
            }
            return;
          }

          countdownValue.textContent = formatCountdown(remaining);
        };

        tick();
        countdownTimer = window.setInterval(tick, 1000);
      }

      async function verifyKhaltiPayment() {
        if (!initialPidx) {
          applyStatus("Failed", "The Khalti payment identifier is missing from the redirect URL.", "/bookings", "Back to My Bookings");
          return;
        }

        try {
          const response = await fetch("/api/khalti/verify", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "same-origin",
            body: JSON.stringify({ pidx: initialPidx }),
          });
          const data = await response.json();

          if (!response.ok) {
            applyStatus(data.status || "Failed", data.message || "Unable to verify Khalti sandbox payment.", "/bookings", "Back to My Bookings");
            return;
          }

          if (data.status === "Completed") {
            applyStatus("Completed", "Your booking is confirmed and ready inside My Bookings.", data.redirectUrl || "/bookings", "View Booking");
            return;
          }

          if (data.status === "Pending") {
            applyStatus("Pending", data.message || "Khalti sandbox payment is still pending.", "/bookings", "Go to My Bookings");
            return;
          }

          applyStatus(data.status || "Failed", data.message || "Payment was not completed.", "/bookings", "Back to My Bookings");
        } catch (err) {
          applyStatus("Failed", "We could not reach the Khalti verification endpoint. Please try again.", "/bookings", "Back to My Bookings");
        }
      }

      metaLabel.textContent = "<%= eventName ? 'EVENT' : 'PIDX' %>";

      if (isFreeBooking) {
        const freeBookingId = "<%= bookingId %>";
        applyStatus(
          "Completed",
          "Your booking is confirmed and ready inside My Bookings.",
          freeBookingId ? `/bookings/manage/${freeBookingId}` : "/bookings",
          freeBookingId ? "View Booking" : "Go to My Bookings"
        );
      } else {
        startCountdown();
        verifyKhaltiPayment();
      }
    </script>
  </body>
</html>
