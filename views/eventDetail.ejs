<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= event.name %> - EMS</title>
    <link rel="stylesheet" href="/css/eventDetail.css">
</head>
<body>

    <header class="navbar">
        <div class="logo">EMS</div>
        <nav>
            <a href="/events">Events</a>
            <% if (user) { %>
                <a href="/bookings">My Bookings</a>
                <a href="/logout" class="btn-logout-nav">Logout</a>
            <% } else { %>
                <a href="/" class="btn-login-nav">Home</a>
            <% } %>
        </nav>
    </header>

    <% if (locals.error && error.length > 0) { %>
        <div class="flash-error"><%= error[0] %></div>
    <% } %>

    <div class="event-hero" <% if (event.image) { %>style="background-image: url('<%= event.image %>')"<% } %>>
        <div class="hero-overlay">
            <div class="hero-content">
                <span class="event-category"><%= event.category || 'Event' %></span>
                <h1><%= event.name %></h1>
            </div>
        </div>
    </div>

    <main class="event-main">

        <div class="event-info-bar">
            <div class="info-box">
                <span class="info-label">WHEN</span>
                <span class="info-value">
                    <%= new Date(event.startDate).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) %>
                    <% if (event.startTime) { %> &bull; <%= event.startTime %><%= event.endTime ? ' - ' + event.endTime : '' %><% } %>
                </span>
            </div>
            <div class="info-box">
                <span class="info-label">WHERE</span>
                <span class="info-value"><%= event.location || 'TBA' %></span>
            </div>
            <div class="info-box">
                <span class="info-label">TIER</span>
                <span class="info-value"><%= event.tier || 'Standard' %></span>
            </div>
            <div class="info-box highlight">
                <span class="info-label">STANDARD ENTRY</span>
                <span class="info-value price">
                    <% if (event.ticketPrice === 0) { %>Free<% } else { %>$<%= event.ticketPrice.toFixed(2) %><% } %>
                </span>
            </div>
        </div>

        <div class="event-body">
            <div class="event-description">
                <h2>About This Event</h2>
                <p><%= event.description || 'No description available.' %></p>

                <div class="capacity-info">
                    <span><%= event.currentBookings %> / <%= event.maxCapacity %> Registered</span>
                    <div class="capacity-bar">
                        <%
  const capacityPercent = event.maxCapacity
    ? Math.min((event.currentBookings / event.maxCapacity) * 100, 100)
    : 0;
%>

<div class="capacity-fill" style="width: <%= capacityPercent %>%"></div>
                    </div>
                </div>
            </div>

            <div class="booking-panel">
                <div class="booking-card">
                    <h3>Reserve Your Spot</h3>
                    <div class="price-display">
                        <% if (event.ticketPrice === 0) { %>
                            <span class="price-amount">Free</span>
                        <% } else { %>
                            <span class="price-amount">$<%= event.ticketPrice.toFixed(2) %></span>
                            <span class="price-per">per guest</span>
                        <% } %>
                    </div>

                    <% if (event.status === 'sold_out' || event.currentBookings >= event.maxCapacity) { %>
                        <button class="book-btn sold-out" disabled>Sold Out</button>
                    <% } else if (user) { %>
                        <form action="/bookings/book/<%= event._id %>" method="POST">
                            <button type="submit" class="book-btn">Book Now &rarr;</button>
                        </form>
                    <% } else { %>
                        <button class="book-btn sold-out" disabled>Booking Unavailable</button>
                    <% } %>

                    <p class="secure-note">Secure checkout &bull; No hidden fees</p>
                </div>
            </div>
        </div>

    </main>

    <footer class="footer">
        <div class="footer-left">COPYRIGHT &copy; 2026 EMS. ALL RIGHTS RESERVED.</div>
        <div class="footer-right">
            <a href="#">TERMS</a>
            <a href="#">PRIVACY</a>
        </div>
    </footer>

</body>
</html>
