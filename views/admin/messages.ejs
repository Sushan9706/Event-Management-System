<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manage Messages – EMS Admin</title>
    <link rel="stylesheet" href="/css/admin-manage.css" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />
</head>

<body>
    <!-- ── Navbar ── -->
    <header class="navbar">
        <div class="nav-inner">
            <div class="nav-brand">
                <a href="/admin/dashboard" class="logo" style="text-decoration: none; color: #1e293b !important; font-size: 1.25rem !important; font-weight: 800 !important; letter-spacing: normal !important; font-family: 'DM Sans', sans-serif !important;">EMS</a>
            </div>
            <nav class="nav-links">
                <a href="/admin/dashboard" class="nav-link">Events</a>
                <a href="/admin/venues" class="nav-link">Venues</a>
                <a href="/admin/messages" class="nav-link active">Messages</a>
                <a href="/admin/users" class="nav-link">Users</a>
                
                <div class="admin-notif-wrapper" style="position: relative; display: flex; align-items: center;">
                    <button class="icon-btn" id="notifBtn" aria-label="Notifications" title="Recent Bookings">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                        </svg>
                        <span class="notif-dot" id="notifDot" style="display: none;"></span>
                    </button>

                    <div class="notif-dropdown" id="notifDropdown" style="position: absolute; top: calc(100% + 12px); right: 0; width: 320px; padding: 0; overflow: hidden; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1); z-index: 1000; display: none;">
                        <p class="notif-title">RECENT BOOKINGS</p>
                        <div id="notifList">
                            <p class="notif-empty">Loading notifications...</p>
                        </div>
                    </div>
                </div>

                <div class="user-menu-container">
                    <button class="user-trigger" id="userTrigger" title="User Account">
                        <% if (locals.user && user.profileImage && user.profileImage !== 'https://tinyurl.com/3jjyxzj6') { %>
                            <img src="<%= user.profileImage %>" alt="User avatar" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" />
                        <% } else { %>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        <% } %>
                    </button>
                    <div class="user-dropdown" id="userDropdown">
                        <a href="/profile" class="dropdown-link">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                            </svg>
                            Profile
                        </a>
                        <a href="/logout" class="dropdown-link logout">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            Logout
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main class="page-main">
        <!-- ── Page Header ── -->
        <div class="page-header">
            <div class="header-content">
                <p class="page-eyebrow">Administration</p>
                <h1 class="page-title">Manage Messages</h1>
            </div>
        </div>

        <!-- ── Flash Messages ── -->
        <% if (locals.success && success.length > 0) { %>
            <div class="flash-msg flash-success">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <%= success %>
            </div>
        <% } %>
        <% if (locals.error && error.length > 0) { %>
            <div class="flash-msg flash-error">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <%= error %>
            </div>
        <% } %>

        <!-- ── Messages Table Section ── -->
        <div class="table-container">
            <div class="table-controls" style="display: flex; justify-content: space-between; align-items: center;">
                <div class="search-mini" style="position: relative; display: flex; align-items: center;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position: absolute; left: 12px; color: var(--text-light); pointer-events: none;">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" id="messageSearch" placeholder="Search messages..." value="<%= filters.search || '' %>" style="padding: 8px 12px 8px 36px; border-radius: 8px; border: 1px solid var(--border-soft); font-size: 13px; color: var(--text-rich); background: #fff; width: 260px; transition: all 0.2s;" />
                </div>
                <div class="filter-group">
                    <select class="select-plain" id="statusFilter">
                        <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
                        <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
                        <option value="resolved" <%= filters.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
                    </select>
                </div>
            </div>

            <table class="events-table">
                <thead>
                    <tr>
                        <th style="width: 25%;">User Details</th>
                        <th style="width: 20%;">Subject</th>
                        <th style="width: 35%;">Message</th>
                        <th style="width: 10%;">Status</th>
                        <th style="width: 10%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (messages.length === 0) { %>
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 48px; color: var(--text-muted);">
                                No contact messages found.
                            </td>
                        </tr>
                    <% } else { %>
                        <% messages.forEach(msg => { %>
                            <tr>
                                <td>
                                    <p style="font-weight: 600; font-size: 14px; color: #1e293b; margin-bottom: 2px;"><%= msg.name %></p>
                                    <p style="font-size: 12px; color: #64748b;"><%= msg.email %></p>
                                    <p style="font-size: 10px; color: #94a3b8; margin-top: 4px;">
                                        <%= new Date(msg.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                    </p>
                                </td>
                                <td>
                                    <span style="font-weight: 500; font-size: 13px; color: #1e293b;"><%= msg.subject %></span>
                                </td>
                                <td>
                                    <p style="font-size: 13px; color: #334155; line-height: 1.5; white-space: pre-wrap; word-break: break-word;"><%= msg.message %></p>
                                </td>
                                <td>
                                    <span class="status-pill status-<%= msg.status === 'pending' ? 'live' : 'completed' %>" style="text-transform: uppercase; font-size: 9px; font-weight: 700; padding: 4px 8px; border-radius: 20px;">
                                        <%= msg.status %>
                                    </span>
                                </td>
                                <td>
                                    <form action="/admin/messages/resolve/<%= msg._id %>" method="POST" style="display:inline;">
                                        <button type="submit" class="btn-view" style="font-size: 10px; padding: 6px 12px; background: <%= msg.status === 'pending' ? '#2563eb' : '#64748b' %>; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; text-transform: uppercase;">
                                            <%= msg.status === 'pending' ? 'RESOLVE' : 'RE-OPEN' %>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>

            <!-- Pagination -->
            <div class="pagination" style="display: <%= pagination.totalPages > 1 ? 'flex' : 'none' %>;">
                <% if (pagination.totalPages > 1) { %>
                    <a href="?status=<%= filters.status %>&page=<%= pagination.currentPage - 1 %>" class="pg-btn <%= pagination.currentPage <= 1 ? 'disabled' : '' %>">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </a>
                    <% for(let i=1; i <= pagination.totalPages; i++) { %>
                        <a href="?status=<%= filters.status %>&page=<%= i %>" class="pg-btn <%= i === pagination.currentPage ? 'active' : '' %>">
                            <%= i %>
                        </a>
                    <% } %>
                    <a href="?status=<%= filters.status %>&page=<%= pagination.currentPage + 1 %>" class="pg-btn <%= pagination.currentPage >= pagination.totalPages ? 'disabled' : '' %>">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </a>
                <% } %>
            </div>
        </div>
    </main>

    <!-- Unified Notifications System -->
    <script src="/js/admin-notif.js"></script>

    <script>
        // Auto-dismiss flash messages
        document.querySelectorAll('.flash-msg').forEach(msg => {
            setTimeout(() => {
                msg.classList.add('fade-out');
                setTimeout(() => { msg.remove(); }, 400);
            }, 2000);
        });

        // Real-time search & status filter
        const messageSearch = document.getElementById('messageSearch');
        const statusFilter = document.getElementById('statusFilter');
        let searchTimeout;

        function fetchMessages() {
            const search = messageSearch.value;
            const status = statusFilter.value;
            fetch(`/admin/messages?search=${encodeURIComponent(search)}&status=${status}`, {
                headers: { 'Accept': 'application/json' }
            })
            .then(res => res.json())
            .then(data => {
                renderMessagesTable(data.messages, data.pagination);
            })
            .catch(err => console.error("Error fetching messages:", err));
        }

        messageSearch.addEventListener('input', () => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(fetchMessages, 300);
        });

        statusFilter.addEventListener('change', fetchMessages);

        function renderMessagesTable(messages, pagination) {
            const tbody = document.querySelector('.events-table tbody');
            const paginationDiv = document.querySelector('.pagination');

            if (messages.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 48px; color: var(--text-muted);">No contact messages found.</td></tr>';
                if (paginationDiv) paginationDiv.style.display = 'none';
                return;
            }

            tbody.innerHTML = messages.map(msg => {
                const dateStr = new Date(msg.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                const pillClass = msg.status === 'pending' ? 'live' : 'completed';
                const actionText = msg.status === 'pending' ? 'RESOLVE' : 'RE-OPEN';
                const actionBg = msg.status === 'pending' ? '#2563eb' : '#64748b';

                return `
                    <tr>
                        <td>
                            <p style="font-weight: 600; font-size: 14px; color: #1e293b; margin-bottom: 2px;">${msg.name}</p>
                            <p style="font-size: 12px; color: #64748b;">${msg.email}</p>
                            <p style="font-size: 10px; color: #94a3b8; margin-top: 4px;">${dateStr}</p>
                        </td>
                        <td>
                            <span style="font-weight: 500; font-size: 13px; color: #1e293b;">${msg.subject}</span>
                        </td>
                        <td>
                            <p style="font-size: 13px; color: #334155; line-height: 1.5; white-space: pre-wrap; word-break: break-word;">${msg.message}</p>
                        </td>
                        <td>
                            <span class="status-pill status-${pillClass}" style="text-transform: uppercase; font-size: 9px; font-weight: 700; padding: 4px 8px; border-radius: 20px;">
                                ${msg.status}
                            </span>
                        </td>
                        <td>
                            <form action="/admin/messages/resolve/${msg._id}" method="POST" style="display:inline;">
                                <button type="submit" class="btn-view" style="font-size: 10px; padding: 6px 12px; background: ${actionBg}; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; text-transform: uppercase;">
                                    ${actionText}
                                </button>
                            </form>
                        </td>
                    </tr>
                `;
            }).join('');

            if (paginationDiv) {
                if (pagination.totalPages > 1) {
                    paginationDiv.style.display = 'flex';
                    let pgHtml = `
                        <a href="?status=${statusFilter.value}&page=${pagination.currentPage - 1}" class="pg-btn ${pagination.currentPage <= 1 ? 'disabled' : ''}">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="15 18 9 12 15 6"></polyline>
                            </svg>
                        </a>
                    `;
                    for (let i = 1; i <= pagination.totalPages; i++) {
                        pgHtml += `
                            <a href="?status=${statusFilter.value}&page=${i}" class="pg-btn ${i === pagination.currentPage ? 'active' : ''}">
                                ${i}
                            </a>
                        `;
                    }
                    pgHtml += `
                        <a href="?status=${statusFilter.value}&page=${pagination.currentPage + 1}" class="pg-btn ${pagination.currentPage >= pagination.totalPages ? 'disabled' : ''}">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </a>
                    `;
                    paginationDiv.innerHTML = pgHtml;
                } else {
                    paginationDiv.style.display = 'none';
                }
            }
        }
    </script>
<script src="/js/user.js"></script>
</body>

</html>
