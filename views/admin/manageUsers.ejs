<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registered Users – EMS Admin</title>
    <!-- CSS Dependencies -->
    <link rel="stylesheet" href="/css/admin-manage.css" />
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
        rel="stylesheet" />
    <style>
        .icon-users {
            background: rgba(99, 102, 241, 0.1);
            color: #6366f1;
        }

        .icon-month {
            background: rgba(16, 185, 129, 0.1);
            color: #10b981;
        }

        .icon-active-bookers {
            background: rgba(245, 158, 11, 0.1);
            color: #f59e0b;
        }

        .user-avatar-mini {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #e2e8f0;
            background: #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #64748b;
        }

        .actions-cell .btn-icon.delete {
            background: #fee2e2;
            color: #ef4444;
        }

        .actions-cell .btn-icon.delete:hover {
            background: #ef4444;
            color: #ffffff;
        }

        .badge-count {
            background: #f1f5f9;
            color: #334155;
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            display: inline-block;
        }
    </style>
</head>

<body>
    <!-- ── Navbar ── -->
    <header class="navbar">
        <div class="nav-inner">
            <div class="nav-brand">
                <a href="/admin/dashboard" class="logo" style="text-decoration: none; color: #1e293b !important; font-size: 1.25rem !important; font-weight: 800 !important; letter-spacing: normal !important; font-family: 'DM Sans', sans-serif !important;">EMS</a>
            </div>
            <nav class="nav-links">
                <a href="/admin/dashboard" class="nav-link">Events</a>
                <a href="/admin/venues" class="nav-link">Venues</a>
                <a href="/admin/messages" class="nav-link">Messages</a>
                <a href="/admin/users" class="nav-link active">Users</a>
                
                <div class="admin-notif-wrapper" style="position: relative; display: flex; align-items: center;">
                    <button class="icon-btn" id="notifBtn" aria-label="Notifications" title="Recent Bookings">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                        </svg>
                        <span class="notif-dot" id="notifDot" style="display: none;"></span>
                    </button>

                    <div class="notif-dropdown" id="notifDropdown" style="position: absolute; top: calc(100% + 12px); right: 0; width: 320px; padding: 0; overflow: hidden; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1); z-index: 1000; display: none;">
                        <p class="notif-title">RECENT BOOKINGS</p>
                        <div id="notifList">
                            <p class="notif-empty">Loading notifications...</p>
                        </div>
                    </div>
                </div>

                <div class="user-menu-container">
                    <button class="user-trigger" id="userTrigger" title="User Account">
                        <% if (locals.user && user.profileImage && user.profileImage !== 'https://tinyurl.com/3jjyxzj6') { %>
                            <img src="<%= user.profileImage %>" alt="User avatar" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" />
                        <% } else { %>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        <% } %>
                    </button>
                    <div class="user-dropdown" id="userDropdown">
                        <a href="/profile" class="dropdown-link">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path
                                    d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1-2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z">
                                </path>
                            </svg>
                            Profile
                        </a>
                        <a href="/logout" class="dropdown-link logout">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            Logout
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main class="page-main">
        <!-- ── Page Header ── -->
        <div class="page-header">
            <div class="header-content">
                <p class="page-eyebrow">Administration</p>
                <h1 class="page-title">Registered Users</h1>
            </div>
            <a href="/admin/users/export" class="btn-create">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Export CSV
            </a>
        </div>

        <!-- ── Flash Messages ── -->
        <% if (locals.success && success.length > 0) { %>
            <div class="flash-msg flash-success">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <%= success %>
            </div>
        <% } %>
        <% if (locals.error && error.length > 0) { %>
            <div class="flash-msg flash-error">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <%= error %>
            </div>
        <% } %>

        <!-- ── Stats Grid ── -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon icon-users">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>
                <p class="stat-label">Total Users</p>
                <p class="stat-value">
                    <%= stats.totalUsers %>
                </p>
            </div>
            <div class="stat-card">
                <div class="stat-icon icon-month">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
                <p class="stat-label">Joined This Month</p>
                <p class="stat-value">
                    <%= stats.joinedThisMonth %>
                </p>
            </div>
            <div class="stat-card">
                <div class="stat-icon icon-active-bookers">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                </div>
                <p class="stat-label">Active Bookers</p>
                <p class="stat-value">
                    <%= stats.activeBookers %>
                </p>
            </div>
        </div>

        <!-- ── Table Section ── -->
        <div class="table-container">
            <div class="table-controls">
                <div class="search-box">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" id="searchInput"
                        placeholder="Search users by username or email address..." />
                </div>
            </div>

            <div id="usersTableBody">
                <table class="events-table">
                    <thead>
                        <tr>
                            <th style="width: 40%;">User Account Details</th>
                            <th style="width: 25%;">Date Joined</th>
                            <th style="width: 20%;">Bookings Activity</th>
                            <th style="width: 15%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (users.length === 0) { %>
                            <tr>
                                <td colspan="4"
                                    style="text-align: center; padding: 48px; color: var(--text-muted);">
                                    No registered users found.
                                </td>
                            </tr>
                        <% } else { %>
                            <% users.forEach(user => { %>
                                <tr>
                                    <td>
                                        <div class="event-cell">
                                            <% if (user.profileImage && user.profileImage !== 'https://tinyurl.com/3jjyxzj6') { %>
                                                <img src="<%= user.profileImage %>" alt="<%= user.username %>" class="user-avatar-mini" />
                                            <% } else { %>
                                                <div class="user-avatar-mini">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                                        <circle cx="12" cy="7" r="4"></circle>
                                                    </svg>
                                                </div>
                                            <% } %>
                                            <div class="event-info-cell" style="margin-left: 12px;">
                                                <p class="event-name" style="font-weight: 600;">
                                                    <%= user.username %>
                                                </p>
                                                <p class="event-location" style="font-size: 13px; color: var(--text-light);">
                                                    <%= user.email %>
                                                </p>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <p style="font-weight: 500; color: var(--text-dark);">
                                            <%= new Date(user.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                        </p>
                                    </td>
                                    <td>
                                        <div style="display: flex; flex-direction: column; gap: 4px;">
                                            <div>
                                                <span class="badge-count">Events: <%= user.eventBookings %></span>
                                            </div>
                                            <div>
                                                <span class="badge-count">Venues: <%= user.venueBookings %></span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="actions-cell">
                                        <div class="actions-wrapper">
                                            <button type="button" class="btn-icon delete delete-trigger"
                                                title="Delete User" data-id="<%= user._id %>"
                                                data-name="<%= user.username %>">
                                                <svg width="16" height="16" viewBox="0 0 24 24"
                                                    fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                    <path
                                                        d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                    </path>
                                                </svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>

                <!-- Pagination -->
                <div class="pagination">
                    <a href="?page=<%= pagination.currentPage - 1 %>"
                        class="pg-btn <%= pagination.currentPage <= 1 ? 'disabled' : '' %>">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </a>
                    <% for(let i=1; i <= pagination.totalPages; i++) { %>
                        <a href="?page=<%= i %>"
                            class="pg-btn <%= i === pagination.currentPage ? 'active' : '' %>">
                            <%= i %>
                        </a>
                    <% } %>
                    <a href="?page=<%= pagination.currentPage + 1 %>"
                        class="pg-btn <%= pagination.currentPage >= pagination.totalPages ? 'disabled' : '' %>">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- Unified Notifications System -->
    <script src="/js/admin-notif.js"></script>

    <script>
        // ─── Real-time Search (AJAX) ───
        const searchInput = document.getElementById('searchInput');
        let searchTimeout;

        const updateUsers = async () => {
            const search = searchInput.value;
            const url = `/admin/users?search=${search}`;

            try {
                const response = await fetch(url, { headers: { 'Accept': 'application/json' } });
                const data = await response.json();
                renderTable(data.users, data.pagination);
            } catch (err) {
                console.error('Fetch error:', err);
            }
        };

        if (searchInput) {
            searchInput.addEventListener('input', () => {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(updateUsers, 300);
            });
        }

        const renderTable = (users, pagination) => {
            const tbody = document.querySelector('.events-table tbody');
            const paginationDiv = document.querySelector('.pagination');

            if (users.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align: center; padding: 48px; color: var(--text-muted);">No registered users found.</td></tr>';
                paginationDiv.innerHTML = '';
                return;
            }

            tbody.innerHTML = users.map(user => {
                const dateStr = new Date(user.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
                const avatar = (user.profileImage && user.profileImage !== 'https://tinyurl.com/3jjyxzj6') 
                    ? `<img src="${user.profileImage}" alt="${user.username}" class="user-avatar-mini" />`
                    : `<div class="user-avatar-mini"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></div>`;
                
                return `
                    <tr>
                        <td>
                            <div class="event-cell">
                                ${avatar}
                                <div class="event-info-cell" style="margin-left: 12px;">
                                    <p class="event-name" style="font-weight: 600;">${user.username}</p>
                                    <p class="event-location" style="font-size: 13px; color: var(--text-light);">${user.email}</p>
                                </div>
                            </div>
                        </td>
                        <td>
                            <p style="font-weight: 500; color: var(--text-dark);">${dateStr}</p>
                        </td>
                        <td>
                            <div style="display: flex; flex-direction: column; gap: 4px;">
                                <div>
                                    <span class="badge-count">Events: ${user.eventBookings}</span>
                                </div>
                                <div>
                                    <span class="badge-count">Venues: ${user.venueBookings}</span>
                                </div>
                            </div>
                        </td>
                        <td class="actions-cell">
                            <div class="actions-wrapper">
                                <button type="button" class="btn-icon delete delete-trigger" title="Delete User" data-id="${user._id}" data-name="${user.username}">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');

            // Pagination rendering
            let pgHtml = `
                <a href="?page=${pagination.currentPage - 1}" class="pg-btn ${pagination.currentPage <= 1 ? 'disabled' : ''}" onclick="event.preventDefault(); goToPage(${pagination.currentPage - 1})">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </a>
            `;
            for (let i = 1; i <= pagination.totalPages; i++) {
                pgHtml += `<a href="?page=${i}" class="pg-btn ${i === pagination.currentPage ? 'active' : ''}" onclick="event.preventDefault(); goToPage(${i})">${i}</a>`;
            }
            pgHtml += `
                <a href="?page=${pagination.currentPage + 1}" class="pg-btn ${pagination.currentPage >= pagination.totalPages ? 'disabled' : ''}" onclick="event.preventDefault(); goToPage(${pagination.currentPage + 1})">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
            `;
            paginationDiv.innerHTML = pgHtml;
        };

        window.goToPage = async (page) => {
            const search = searchInput.value;
            const url = `/admin/users?page=${page}&search=${search}`;

            try {
                const response = await fetch(url, { headers: { 'Accept': 'application/json' } });
                const data = await response.json();
                renderTable(data.users, data.pagination);
            } catch (err) {
                console.error('Fetch error:', err);
            }
        };

        // ─── Delete Modal Logic ───
        const showDeleteModal = (userId, userName) => {
            const deleteModal = document.getElementById('deleteModal');
            const deleteForm = document.getElementById('deleteForm');
            const userNameSpan = document.getElementById('deleteUserName');

            if (userNameSpan) userNameSpan.textContent = userName;
            if (deleteForm) deleteForm.action = `/admin/users/delete/${userId}`;
            if (deleteModal) deleteModal.classList.add('show');
        };

        window.closeDeleteModal = () => {
            const deleteModal = document.getElementById('deleteModal');
            if (deleteModal) deleteModal.classList.remove('show');
        };

        // Event delegation for delete buttons
        document.addEventListener('click', (e) => {
            const btn = e.target.closest('.delete-trigger');
            if (btn) {
                e.preventDefault();
                e.stopPropagation();
                const id = btn.getAttribute('data-id');
                const name = btn.getAttribute('data-name');
                showDeleteModal(id, name);
            }
        });

        // Close modal on escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeDeleteModal();
        });

        // Auto-dismiss flash messages
        document.querySelectorAll('.flash-msg').forEach(msg => {
            setTimeout(() => {
                msg.classList.add('fade-out');
                setTimeout(() => {
                    msg.remove();
                }, 400); // Wait for animation to finish
            }, 2000); // 2 seconds delay
        });
    </script>

    <!-- ── Deletion Modal HTML ── -->
    <div class="modal-overlay" id="deleteModal" onclick="if(event.target === this) closeDeleteModal()">
        <div class="modal-card">
            <div class="modal-warning-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M3 6h18"></path>
                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                    <line x1="10" y1="11" x2="10" y2="17"></line>
                    <line x1="14" y1="11" x2="14" y2="17"></line>
                </svg>
            </div>
            <h2 class="modal-title">Purge User Account?</h2>
            <p class="modal-text">
                Are you sure you want to permanently delete user 
                <span id="deleteUserName" class="modal-event-name">Username</span>?
                All of their venue and event bookings will be immediately purged. This action is irreversible.
            </p>
            <div class="modal-actions">
                <button type="button" class="modal-btn btn-cancel" onclick="closeDeleteModal()">CANCEL</button>
                <form id="deleteForm" method="POST" style="flex: 1;">
                    <button type="submit" class="modal-btn btn-confirm-delete">CONFIRM PURGE</button>
                </form>
            </div>
        </div>
    </div>
<script src="/js/user.js"></script>
</body>

</html>
