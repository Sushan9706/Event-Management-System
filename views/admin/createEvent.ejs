<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Event – EMS Admin</title>
    <link rel="stylesheet" href="/css/admin-create.css" />
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
        rel="stylesheet" />
</head>

<body>
    <!-- ── Navbar ── -->
    <header class="navbar">
        <div class="nav-inner">
            <span class="logo">EMS</span>
            <nav class="nav-links">
                <a href="/admin/events" class="nav-link">Events</a>
                <a href="/admin/dashboard" class="nav-link">Dashboard</a>
                <a href="/logout" class="nav-link">Logout</a>
            </nav>
        </div>
    </header>

    <main class="create-layout">
        <!-- ── Left Panel ── -->
        <aside class="left-panel">
            <div class="left-panel-content">
                <h1 class="left-heading">Drafting the<br />Next Experience.</h1>
                <p class="left-caption">Every great event begins with a vision. Fill in the details, upload your banner,
                    and let your audience discover something unforgettable.</p>

                <div class="left-actions">
                    <div class="left-action-card">
                        <div class="left-action-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                                <polyline points="7 3 7 8 15 8"></polyline>
                            </svg>
                        </div>
                        <div>
                            <p class="action-title">Save Draft</p>
                            <p class="action-desc">Save progress and publish later</p>
                        </div>
                    </div>
                    <div class="left-action-card">
                        <div class="left-action-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </div>
                        <div>
                            <p class="action-title">Preview</p>
                            <p class="action-desc">See how your event will look</p>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- ── Right Panel (Form) ── -->
        <section class="right-panel">
            <% if (typeof error !=='undefined' && error && error.length> 0) { %>
                <div class="flash-error">
                    <%= error %>
                </div>
                <% } %>

                    <form action="/admin/events/create" method="POST" enctype="multipart/form-data" class="event-form"
                        id="createEventForm">
                        <div class="form-section">
                            <h2 class="form-section-title">Event Details</h2>

                            <div class="form-row">
                                <div class="form-group full">
                                    <label for="name">EVENT NAME</label>
                                    <input type="text" id="name" name="name" placeholder="Enter event name..."
                                        required />
                                </div>
                            </div>

                            <div class="form-row two-col">
                                <div class="form-group">
                                    <label for="category">CATEGORY</label>
                                    <select id="category" name="category">
                                        <option value="General">General</option>
                                        <option value="Technology">Technology</option>
                                        <option value="Music & Entertainment">Music & Entertainment</option>
                                        <option value="Arts & Culture">Arts & Culture</option>
                                        <option value="Sports & Fitness">Sports & Fitness</option>
                                        <option value="Business & Networking">Business & Networking</option>
                                        <option value="Food & Drink">Food & Drink</option>
                                        <option value="Education & Workshop">Education & Workshop</option>
                                        <option value="Architecture & Design">Architecture & Design</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="city">CITY</label>
                                    <div class="input-with-icon">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <circle cx="11" cy="11" r="8"></circle>
                                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                        </svg>
                                        <input type="text" id="city" name="city" placeholder="Search city..." />
                                    </div>
                                </div>
                            </div>

                            <div class="form-group full">
                                <label for="description">EVENT DESCRIPTION</label>
                                <textarea id="description" name="description" rows="5"
                                    placeholder="Describe your event in detail..."></textarea>
                            </div>
                        </div>

                        <div class="form-section">
                            <h2 class="form-section-title">Date & Capacity</h2>

                            <div class="form-row three-col">
                                <div class="form-group">
                                    <label for="date">DATE</label>
                                    <input type="date" id="date" name="date" required />
                                </div>
                                <div class="form-group">
                                    <label for="time">TIME</label>
                                    <input type="time" id="time" name="time" required />
                                </div>
                                <div class="form-group">
                                    <label for="max_capacity">MAX CAPACITY</label>
                                    <input type="number" id="max_capacity" name="max_capacity" placeholder="e.g., 500"
                                        min="1" />
                                </div>
                            </div>

                            <div class="form-row two-col">
                                <div class="form-group">
                                    <label for="ticket_price">TICKET PRICE ($)</label>
                                    <input type="number" id="ticket_price" name="ticket_price" placeholder="0.00"
                                        step="0.01" min="0" />
                                </div>
                                <div class="form-group">
                                    <label for="location">LOCATION / VENUE</label>
                                    <input type="text" id="location" name="location"
                                        placeholder="Venue name or address" />
                                </div>
                            </div>
                        </div>

                        <div class="form-section">
                            <h2 class="form-section-title">Event Visuals</h2>

                            <div class="upload-area" id="uploadArea">
                                <input type="file" id="banner_image" name="banner_image" accept="image/*" hidden />
                                <div class="upload-placeholder" id="uploadPlaceholder">
                                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#aaa"
                                        stroke-width="1.5">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                        <polyline points="21 15 16 10 5 21"></polyline>
                                    </svg>
                                    <p class="upload-text">Click or drag to upload event banner</p>
                                    <p class="upload-hint">PNG, JPG or WEBP • Max 5MB</p>
                                </div>
                                <div class="upload-preview" id="uploadPreview" style="display:none;">
                                    <img id="previewImg" src="" alt="Preview" />
                                    <button type="button" class="btn-remove-preview" id="removePreview">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" name="status" value="active" class="btn-publish">
                                PUBLISH EVENT
                            </button>
                            <button type="submit" name="status" value="draft" class="btn-draft">
                                Save Draft
                            </button>
                        </div>
                    </form>
        </section>
    </main>

    <script>
        // File upload handling
        const uploadArea = document.getElementById('uploadArea');
        const fileInput = document.getElementById('banner_image');
        const placeholder = document.getElementById('uploadPlaceholder');
        const preview = document.getElementById('uploadPreview');
        const previewImg = document.getElementById('previewImg');
        const removeBtn = document.getElementById('removePreview');

        uploadArea.addEventListener('click', () => fileInput.click());
        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.classList.add('dragover');
        });
        uploadArea.addEventListener('dragleave', () => {
            uploadArea.classList.remove('dragover');
        });
        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadArea.classList.remove('dragover');
            if (e.dataTransfer.files.length) {
                fileInput.files = e.dataTransfer.files;
                showPreview(e.dataTransfer.files[0]);
            }
        });

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length) showPreview(fileInput.files[0]);
        });

        function showPreview(file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                previewImg.src = e.target.result;
                placeholder.style.display = 'none';
                preview.style.display = 'flex';
            };
            reader.readAsDataURL(file);
        }

        removeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            fileInput.value = '';
            previewImg.src = '';
            preview.style.display = 'none';
            placeholder.style.display = 'flex';
        });
    </script>
</body>

</html>