<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manage Events – EMS Admin</title>
    <link rel="stylesheet" href="/css/admin-manage.css" />
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
        rel="stylesheet" />
</head>

<body>
    <!-- ── Navbar ── -->
    <header class="navbar">
        <div class="nav-inner">
            <span class="logo">EMS</span>
            <nav class="nav-links">
                <a href="/admin/events" class="nav-link active">Events</a>
                <a href="/admin/dashboard" class="nav-link">Dashboard</a>
                <a href="/logout" class="nav-link">Logout</a>
            </nav>
        </div>
    </header>

    <main class="page-main">
        <!-- ── Page Header ── -->
        <div class="page-header">
            <div class="page-header-text">
                <p class="page-eyebrow">ADMINISTRATION</p>
                <h1 class="page-title">Manage Events</h1>
            </div>
            <a href="/admin/events/create" class="btn-create">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                    stroke-linecap="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Create New Event
            </a>
        </div>

        <% if (typeof success !=='undefined' && success && success.length> 0) { %>
            <div class="flash-success">
                <%= success %>
            </div>
            <% } %>
                <% if (typeof error !=='undefined' && error && error.length> 0) { %>
                    <div class="flash-error">
                        <%= error %>
                    </div>
                    <% } %>

                        <!-- ── Stats Cards ── -->
                        <div class="stats-grid">
                            <div class="stat-card">
                                <div class="stat-icon-wrap stat-icon--blue">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="1.8">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                </div>
                                <p class="stat-label">Total Events</p>
                                <p class="stat-num">
                                    <%= stats.totalEvents %>
                                </p>
                            </div>
                            <div class="stat-card">
                                <div class="stat-icon-wrap stat-icon--green">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="1.8">
                                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                    </svg>
                                </div>
                                <p class="stat-label">Active Events</p>
                                <p class="stat-num">
                                    <%= stats.activeEvents %>
                                </p>
                            </div>
                            <div class="stat-card">
                                <div class="stat-icon-wrap stat-icon--purple">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="1.8">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    </svg>
                                </div>
                                <p class="stat-label">Total Attendees</p>
                                <p class="stat-num">
                                    <%= stats.totalAttendees>= 1000 ? (stats.totalAttendees / 1000).toFixed(1) + 'K' :
                                        stats.totalAttendees %>
                                </p>
                            </div>
                            <div class="stat-card">
                                <div class="stat-icon-wrap stat-icon--amber">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="1.8">
                                        <line x1="18" y1="20" x2="18" y2="10"></line>
                                        <line x1="12" y1="20" x2="12" y2="4"></line>
                                        <line x1="6" y1="20" x2="6" y2="14"></line>
                                    </svg>
                                </div>
                                <p class="stat-label">Avg Attendance</p>
                                <p class="stat-num">
                                    <%= stats.avgAttendance %>%
                                </p>
                            </div>
                        </div>

                        <!-- ── Events List ── -->
                        <div class="events-list-section">
                            <div class="events-list-header">
                                <h2 class="list-title">All Events</h2>
                                <span class="list-count">
                                    <%= events.length %> events
                                </span>
                            </div>

                            <% if (events.length===0) { %>
                                <div class="empty-state">
                                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ccc"
                                        stroke-width="1.5">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                    <p>No events created yet</p>
                                    <a href="/admin/events/create" class="btn-create-small">Create Your First Event</a>
                                </div>
                                <% } else { %>
                                    <div class="events-list">
                                        <% events.forEach(function(event) { %>
                                            <div class="event-list-card">
                                                <div class="event-list-left">
                                                    <div class="event-thumb">
                                                        <% if (event.banner_image) { %>
                                                            <img src="<%= event.banner_image %>"
                                                                alt="<%= event.name %>" />
                                                            <% } else { %>
                                                                <div class="thumb-placeholder">
                                                                    <svg width="20" height="20" viewBox="0 0 24 24"
                                                                        fill="none" stroke="#999" stroke-width="1.5">
                                                                        <rect x="3" y="3" width="18" height="18" rx="2"
                                                                            ry="2"></rect>
                                                                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                                                        <polyline points="21 15 16 10 5 21"></polyline>
                                                                    </svg>
                                                                </div>
                                                                <% } %>
                                                    </div>
                                                    <div class="event-list-info">
                                                        <h3 class="event-list-name">
                                                            <%= event.name %>
                                                        </h3>
                                                        <div class="event-list-meta">
                                                            <span class="meta-item">
                                                                <svg width="12" height="12" viewBox="0 0 24 24"
                                                                    fill="none" stroke="currentColor" stroke-width="2">
                                                                    <path
                                                                        d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z">
                                                                    </path>
                                                                    <circle cx="12" cy="10" r="3"></circle>
                                                                </svg>
                                                                <%= event.location || event.city || 'No location' %>
                                                            </span>
                                                            <span class="meta-item">
                                                                <svg width="12" height="12" viewBox="0 0 24 24"
                                                                    fill="none" stroke="currentColor" stroke-width="2">
                                                                    <rect x="3" y="4" width="18" height="18" rx="2"
                                                                        ry="2"></rect>
                                                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                                                </svg>
                                                                <% if (event.date) { %>
                                                                    <%= new Date(event.date).toLocaleDateString('en-US',
                                                                        { month: 'short' , day: 'numeric' ,
                                                                        year: 'numeric' }) %>
                                                                        <% } else { %>
                                                                            No date
                                                                            <% } %>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="event-list-right">
                                                    <span class="status-badge status--<%= event.status %>">
                                                        <%= event.status %>
                                                    </span>
                                                    <div class="event-actions-dropdown">
                                                        <button class="btn-dots" aria-label="Actions">
                                                            <svg width="16" height="16" viewBox="0 0 24 24"
                                                                fill="currentColor">
                                                                <circle cx="12" cy="5" r="2"></circle>
                                                                <circle cx="12" cy="12" r="2"></circle>
                                                                <circle cx="12" cy="19" r="2"></circle>
                                                            </svg>
                                                        </button>
                                                        <div class="dropdown-menu">
                                                            <a href="/admin/events/edit/<%= event._id %>"
                                                                class="dropdown-item">
                                                                <svg width="14" height="14" viewBox="0 0 24 24"
                                                                    fill="none" stroke="currentColor" stroke-width="2">
                                                                    <path
                                                                        d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7">
                                                                    </path>
                                                                    <path
                                                                        d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z">
                                                                    </path>
                                                                </svg>
                                                                Edit Event
                                                            </a>
                                                            <a href="/admin/events/<%= event._id %>/bookings"
                                                                class="dropdown-item">
                                                                <svg width="14" height="14" viewBox="0 0 24 24"
                                                                    fill="none" stroke="currentColor" stroke-width="2">
                                                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2">
                                                                    </path>
                                                                    <circle cx="9" cy="7" r="4"></circle>
                                                                </svg>
                                                                View Bookings
                                                            </a>
                                                            <form action="/admin/events/delete/<%= event._id %>"
                                                                method="POST" class="delete-form"
                                                                onsubmit="return confirm('Are you sure you want to delete this event?')">
                                                                <button type="submit"
                                                                    class="dropdown-item dropdown-item--danger">
                                                                    <svg width="14" height="14" viewBox="0 0 24 24"
                                                                        fill="none" stroke="currentColor"
                                                                        stroke-width="2">
                                                                        <polyline points="3 6 5 6 21 6"></polyline>
                                                                        <path
                                                                            d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                                        </path>
                                                                    </svg>
                                                                    Delete Event
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }); %>
                                    </div>
                                    <% } %>
                        </div>
    </main>

    <footer class="footer">
        <span class="footer-copy">COPYRIGHT © 2026 EMS. ALL RIGHTS RESERVED.</span>
        <div class="footer-links">
            <a href="#">TERMS</a>
            <a href="#">PRIVACY</a>
        </div>
    </footer>

    <script>
        // Dropdown toggle
        document.querySelectorAll('.btn-dots').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const dropdown = btn.nextElementSibling;
                document.querySelectorAll('.dropdown-menu.open').forEach(d => {
                    if (d !== dropdown) d.classList.remove('open');
                });
                dropdown.classList.toggle('open');
            });
        });
        document.addEventListener('click', () => {
            document.querySelectorAll('.dropdown-menu.open').forEach(d => d.classList.remove('open'));
        });
    </script>
</body>

</html>