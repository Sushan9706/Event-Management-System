<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Booking Details – EMS Admin</title>
    <link rel="stylesheet" href="/css/admin-booking.css" />
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
        rel="stylesheet" />
</head>

<body>
    <!-- ── Navbar ── -->
    <header class="navbar">
        <div class="nav-inner">
            <span class="logo">EMS</span>
            <nav class="nav-links">
                <a href="/admin/events" class="nav-link">Events</a>
                <a href="/admin/dashboard" class="nav-link">Dashboard</a>
                <a href="/logout" class="nav-link">Logout</a>
            </nav>
        </div>
    </header>

    <main class="page-main">
        <!-- ── Breadcrumbs ── -->
        <div class="breadcrumbs">
            <a href="/admin/events" class="crumb">EVENTS</a>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
            <span class="crumb crumb--active">BOOKING DETAILS</span>
        </div>

        <div class="booking-layout">
            <!-- ── Left Column: Event Details ── -->
            <aside class="event-detail-card">
                <div class="event-image-wrap">
                    <% if (event.banner_image) { %>
                        <img src="<%= event.banner_image %>" alt="<%= event.name %>" class="event-image" />
                        <% } else { %>
                            <div class="event-image-placeholder">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#bbb"
                                    stroke-width="1.5">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                    <polyline points="21 15 16 10 5 21"></polyline>
                                </svg>
                            </div>
                            <% } %>
                </div>

                <div class="event-detail-body">
                    <h2 class="event-detail-title">
                        <%= event.name %>
                    </h2>

                    <div class="event-detail-meta">
                        <div class="detail-row">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            <span>
                                <% if (event.date) { %>
                                    <%= new Date(event.date).toLocaleDateString('en-US', { weekday: 'long' ,
                                        month: 'long' , day: 'numeric' , year: 'numeric' }) %>
                                        <% } else { %>
                                            No date set
                                            <% } %>
                            </span>
                        </div>
                        <div class="detail-row">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            <span>
                                <%= event.time || 'No time set' %>
                            </span>
                        </div>
                        <div class="detail-row">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <span>
                                <%= event.location || event.city || 'No location' %>
                            </span>
                        </div>
                    </div>

                    <div class="capacity-section">
                        <div class="capacity-header">
                            <span class="capacity-label">Capacity</span>
                            <span class="capacity-numbers">
                                <%= totalBookings %> / <%= event.max_capacity %> Registered
                            </span>
                        </div>
                        <div class="capacity-bar">
                            <div class="capacity-fill" style="width: <%= Math.min(capacityPercent, 100) %>%"></div>
                        </div>
                        <div class="capacity-footer">
                            <span class="velocity-label">Registration Velocity</span>
                            <span class="velocity-value">
                                <%= capacityPercent %>% capacity
                            </span>
                        </div>
                    </div>

                    <a href="/admin/events/edit/<%= event._id %>" class="btn-edit-event">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                        </svg>
                        Edit Event
                    </a>
                </div>
            </aside>

            <!-- ── Right Column: Bookings Table ── -->
            <section class="bookings-panel">
                <div class="bookings-header">
                    <h2 class="bookings-title">Attendees</h2>
                    <div class="bookings-controls">
                        <form action="/admin/events/<%= event._id %>/bookings" method="GET" class="search-form">
                            <div class="search-input-wrap">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                </svg>
                                <input type="text" name="search" placeholder="Search attendees..."
                                    value="<%= filters.search %>" />
                            </div>
                            <input type="hidden" name="status" value="<%= filters.status %>" />
                        </form>

                        <div class="filter-group">
                            <a href="/admin/events/<%= event._id %>/bookings?status=all"
                                class="filter-btn <%= filters.status === 'all' ? 'filter-btn--active' : '' %>">All</a>
                            <a href="/admin/events/<%= event._id %>/bookings?status=confirmed"
                                class="filter-btn <%= filters.status === 'confirmed' ? 'filter-btn--active' : '' %>">Confirmed</a>
                            <a href="/admin/events/<%= event._id %>/bookings?status=pending"
                                class="filter-btn <%= filters.status === 'pending' ? 'filter-btn--active' : '' %>">Pending</a>
                            <a href="/admin/events/<%= event._id %>/bookings?status=cancelled"
                                class="filter-btn <%= filters.status === 'cancelled' ? 'filter-btn--active' : '' %>">Cancelled</a>
                        </div>

                        <a href="/admin/events/<%= event._id %>/bookings/export" class="btn-export">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                            Export CSV
                        </a>
                    </div>
                </div>

                <% if (bookings.length===0) { %>
                    <div class="empty-bookings">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1.5">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                        </svg>
                        <p>No bookings found</p>
                    </div>
                    <% } else { %>
                        <div class="bookings-table">
                            <div class="table-head">
                                <span class="th th-name">Name</span>
                                <span class="th th-email">Email</span>
                                <span class="th th-ref">Reference</span>
                                <span class="th th-date">Date</span>
                                <span class="th th-status">Status</span>
                            </div>

                            <% bookings.forEach(function(booking) { %>
                                <div class="table-row">
                                    <div class="td td-name">
                                        <div class="avatar-circle">
                                            <%= booking.user_name ? booking.user_name.charAt(0).toUpperCase() : '?' %>
                                        </div>
                                        <span>
                                            <%= booking.user_name %>
                                        </span>
                                    </div>
                                    <div class="td td-email">
                                        <%= booking.user_email %>
                                    </div>
                                    <div class="td td-ref">
                                        <%= booking.reference_number %>
                                    </div>
                                    <div class="td td-date">
                                        <%= new Date(booking.booking_date).toLocaleDateString('en-US', { month: 'short'
                                            , day: 'numeric' , year: 'numeric' }) %>
                                    </div>
                                    <div class="td td-status">
                                        <span class="status-pill status-pill--<%= booking.status %>">
                                            <%= booking.status %>
                                        </span>
                                    </div>
                                </div>
                                <% }); %>
                        </div>

                        <!-- ── Pagination ── -->
                        <div class="pagination-bar">
                            <span class="pagination-info">
                                Showing <%= ((pagination.page - 1) * pagination.limit) + 1 %>-<%=
                                        Math.min(pagination.page * pagination.limit, pagination.total) %> of <%=
                                            pagination.total %> attendees
                            </span>
                            <div class="pagination-controls">
                                <% if (pagination.page> 1) { %>
                                    <a href="/admin/events/<%= event._id %>/bookings?page=<%= pagination.page - 1 %>&status=<%= filters.status %>"
                                        class="page-btn">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <polyline points="15 18 9 12 15 6"></polyline>
                                        </svg>
                                    </a>
                                    <% } %>

                                        <% for (let i=1; i <=pagination.totalPages; i++) { %>
                                            <a href="/admin/events/<%= event._id %>/bookings?page=<%= i %>&status=<%= filters.status %>"
                                                class="page-btn <%= i === pagination.page ? 'page-btn--active' : '' %>">
                                                <%= i %>
                                            </a>
                                            <% } %>

                                                <% if (pagination.page < pagination.totalPages) { %>
                                                    <a href="/admin/events/<%= event._id %>/bookings?page=<%= pagination.page + 1 %>&status=<%= filters.status %>"
                                                        class="page-btn">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                            stroke="currentColor" stroke-width="2">
                                                            <polyline points="9 18 15 12 9 6"></polyline>
                                                        </svg>
                                                    </a>
                                                    <% } %>
                            </div>
                        </div>
                        <% } %>
            </section>
        </div>
    </main>

    <footer class="footer">
        <span class="footer-copy">COPYRIGHT © 2026 EMS. ALL RIGHTS RESERVED.</span>
        <div class="footer-links">
            <a href="#">TERMS</a>
            <a href="#">PRIVACY</a>
        </div>
    </footer>
</body>

</html>