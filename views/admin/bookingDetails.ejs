<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Booking Details – EMS Admin</title>
    <link rel="stylesheet" href="/css/admin-booking.css" />
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
        rel="stylesheet" />
</head>

<body>
    <!-- ── Navbar ── -->
    <header class="navbar">
        <div class="nav-inner">
            <div class="nav-brand">
                <a href="/admin/dashboard" class="logo" style="text-decoration: none; color: #1e293b !important; font-size: 1.25rem !important; font-weight: 800 !important; letter-spacing: normal !important; font-family: 'DM Sans', sans-serif !important;">EMS</a>
            </div>
            <nav class="nav-links">
                <a href="/admin/dashboard" class="nav-link">Events</a>
                
                <button class="icon-btn" id="notifBtn" aria-label="Notifications" title="Recent Bookings">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                    </svg>
                    <span class="notif-dot" id="notifDot" style="display: none;"></span>
                </button>

                <div class="notif-dropdown" id="notifDropdown" style="right: 50px;">
                    <p class="notif-title">RECENT BOOKINGS</p>
                    <div id="notifList">
                        <p class="notif-empty">Loading notifications...</p>
                    </div>
                </div>

                <div class="user-menu-container">
                    <button class="user-trigger" id="userTrigger" title="User Account">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </button>
                    <div class="user-dropdown" id="userDropdown">
                        <a href="/profile" class="dropdown-link">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path
                                    d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1-2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z">
                                </path>
                            </svg>
                            Profile
                        </a>
                        <a href="/logout" class="dropdown-link logout">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            Logout
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main class="page-main">
        <div style="margin-bottom: 32px;">
            <a href="/admin/dashboard"
                style="color: var(--text-muted); text-decoration: none; font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                BACK TO LIST
            </a>
        </div>

        <div class="booking-layout">
            <!-- ── Left Column: Summary Card ── -->
            <aside class="event-summary-card">
                <% if (event.imagePath) { %>
                    <img src="<%= event.imagePath %>" alt="Event Cover" class="event-img-small" />
                    <% } else { %>
                        <div
                            style="width:100%; height:180px; background:#f1f5f9; display:flex; align-items:center; justify-content:center; color:var(--text-light);">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="1.5">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                <polyline points="21 15 16 10 5 21"></polyline>
                            </svg>
                        </div>
                        <% } %>

                            <div class="event-summary-body">
                                <span class="event-category-badge">
                                    <%= event.categoryId ? event.categoryId.name : 'General' %>
                                </span>
                                <h2 class="event-summary-title">
                                    <%= event.eventName %>
                                </h2>

                                <div class="summary-meta">
                                    <div class="meta-row">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                            <line x1="16" y1="2" x2="16" y2="6"></line>
                                            <line x1="8" y1="2" x2="8" y2="6"></line>
                                            <line x1="3" y1="10" x2="21" y2="10"></line>
                                        </svg>
                                        <span>
                                            <%= new Date(event.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                            <% if (event.endDate && new Date(event.startDate).toDateString() !== new Date(event.endDate).toDateString()) { %>
                                                - <%= new Date(event.endDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                            <% } %>
                                        </span>
                                    </div>
                                    <div class="meta-row">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                        <span>
                                            <%= event.startTime %> - <%= event.endTime %>
                                        </span>
                                    </div>
                                    <div class="meta-row">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                            <circle cx="12" cy="10" r="3"></circle>
                                        </svg>
                                        <span>
                                            <%= event.location %>
                                        </span>
                                    </div>
                                </div>

                                <div class="velocity-section">
                                    <div class="velocity-header">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
                                        </svg>
                                        REGISTRATION VELOCITY
                                    </div>
                                    <p style="font-size: 13px; font-weight: 700; margin-bottom: 4px;">
                                        <%= totalBookings %> / <%= event.maxCapacity %> Registered
                                    </p>
                                    <div class="velocity-bar">
                                        <div class="velocity-fill" style="width: <%= capacityPercent %>%"></div>
                                    </div>
                                    <p class="velocity-text">
                                        <strong>Demand Insights:</strong> Registration is currently at high velocity.
                                        Recommended to close registration soon or increase capacity if venue permits.
                                    </p>
                                </div>

                                <a href="/admin/events/edit/<%= event._id %>"
                                    style="display: block; width: 100%; padding: 12px; border-radius: 8px; border: 1px solid var(--border-soft); text-align: center; text-decoration: none; color: var(--text-rich); font-size: 13px; font-weight: 700; margin-top: 24px; transition: all 0.2s;">
                                    Edit Event Context
                                </a>
                            </div>
            </aside>

            <!-- ── Right Column: Bookings Table ── -->
            <section class="panel-card">
                <div class="panel-header">
                    <h2 class="panel-title">Attendees List</h2>
                    <div class="header-actions">
                        <div class="search-mini">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input type="text" id="attendeeSearch" placeholder="Search attendees..."
                                value="<%= filters.search %>" />
                        </div>
                        <a href="/admin/events/<%= event._id %>/bookings/export" class="btn-export">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                            EXPORT CSV
                        </a>
                    </div>
                </div>

                <div id="attendeesTable">
                    <table class="bookings-table">
                        <thead>
                            <tr>
                                <th style="width: 40%;">User</th>
                                <th style="width: 30%;">Ref & Date</th>
                                <th style="width: 20%;">Status</th>
                                <th style="width: 10%;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (bookings.length===0) { %>
                                <tr>
                                    <td colspan="4"
                                        style="text-align: center; padding: 48px; color: var(--text-light);">No
                                        attendees registered yet.</td>
                                </tr>
                                <% } else { %>
                                    <% bookings.forEach(booking=> { %>
                                        <tr>
                                            <td>
                                                <div class="user-cell">
                                                    <div class="user-avatar">
                                                        <%= booking.userName ? booking.userName.charAt(0).toUpperCase()
                                                            : '?' %>
                                                    </div>
                                                    <div class="user-info">
                                                        <p>
                                                            <%= booking.userName %>
                                                        </p>
                                                        <span>
                                                            <%= booking.userEmail %>
                                                        </span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <p style="font-weight: 500; font-size: 13px;">
                                                    <%= booking.referenceNumber %>
                                                </p>
                                                <p style="font-size: 11px; color: var(--text-light);">
                                                    <%= new Date(booking.createdAt).toLocaleDateString() %>
                                                </p>
                                            </td>
                                            <td>
                                                <span class="status-tag status-<%= booking.status %>">
                                                    <%= booking.status %>
                                                </span>
                                            </td>
                                            <td>
                                                <button
                                                    style="border: none; background: none; color: var(--text-light); cursor: pointer;">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                                        <circle cx="12" cy="7" r="2"></circle>
                                                        <circle cx="12" cy="12" r="2"></circle>
                                                        <circle cx="12" cy="17" r="2"></circle>
                                                    </svg>
                                                </button>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } %>
                        </tbody>
                    </table>

                    <!-- Pagination -->
                    <div class="footer-bar">
                        <div style="font-size: 12px; color: var(--text-light);">Showing <%= totalBookings %> attendees
                        </div>
                        <div class="pagination-group">
                            <% for(let i=1; i <=pagination.totalPages; i++) { %>
                                <a href="?page=<%= i %>"
                                    class="page-link <%= i === pagination.currentPage ? 'active' : '' %>">
                                    <%= i %>
                                </a>
                                <% } %>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script>
        // Real-time search for attendees
        const attendeeSearch = document.getElementById('attendeeSearch');
        let searchTimeout;

        attendeeSearch.addEventListener('input', () => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(async () => {
                const search = attendeeSearch.value;
                const response = await fetch(`/admin/events/${window.location.pathname.split('/')[3]}/bookings?search=${search}`, {
                    headers: { 'Accept': 'application/json' }
                });
                const data = await response.json();
                renderAttendeesTable(data.bookings, data.pagination);
            }, 300);
        });

        function renderAttendeesTable(bookings, pagination) {
            const tbody = document.querySelector('.bookings-table tbody');
            const pgGroup = document.querySelector('.pagination-group');

            if (bookings.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align: center; padding: 48px; color: var(--text-light);">No attendees found.</td></tr>';
                pgGroup.innerHTML = '';
                return;
            }

            tbody.innerHTML = bookings.map(b => `
                <tr>
                    <td>
                        <div class="user-cell">
                            <div class="user-avatar">${b.userName ? b.userName.charAt(0).toUpperCase() : '?'}</div>
                            <div class="user-info">
                                <p>${b.userName}</p>
                                <span>${b.userEmail}</span>
                            </div>
                        </div>
                    </td>
                    <td>
                        <p style="font-weight: 500; font-size: 13px;">${b.referenceNumber}</p>
                        <p style="font-size: 11px; color: var(--text-light);">${new Date(b.createdAt).toLocaleDateString()}</p>
                    </td>
                    <td>
                        <span class="status-tag status-${b.status}">${b.status}</span>
                    </td>
                    <td>
                        <button style="border: none; background: none; color: var(--text-light); cursor: pointer;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <circle cx="12" cy="7" r="2"></circle>
                                <circle cx="12" cy="12" r="2"></circle>
                                <circle cx="12" cy="17" r="2"></circle>
                            </svg>
                        </button>
                    </td>
                </tr>
            `).join('');

            let pgHtml = '';
            for (let i = 1; i <= pagination.totalPages; i++) {
                pgHtml += `<a href="?page=${i}" class="page-link ${i === pagination.currentPage ? 'active' : ''}">${i}</a>`;
            }
            pgGroup.innerHTML = pgHtml;
        }

        // ─── Navbar Elements ───
        const userTrigger = document.getElementById('userTrigger');
        const userDropdown = document.getElementById('userDropdown');
        const notifBtn = document.getElementById('notifBtn');
        const notifDropdown = document.getElementById('notifDropdown');
        const notifList = document.getElementById('notifList');
        const notifDot = document.getElementById('notifDot');

        if (userTrigger) {
            userTrigger.addEventListener('click', (e) => {
                e.stopPropagation();
                userDropdown.classList.toggle('show');
                notifDropdown.classList.remove('show');
            });
            document.addEventListener('click', () => {
                userDropdown.classList.remove('show');
                notifDropdown.classList.remove('show');
            });
        }

        // ─── Notifications Toggle & Fetch ───
        notifBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            notifDropdown.classList.toggle('show');
            userDropdown.classList.remove('show');
            if (notifDropdown.classList.contains('show')) {
                fetchNotifications();
            }
        });

        async function fetchNotifications() {
            try {
                const response = await fetch('/admin/notifications');
                const data = await response.json();
                renderNotifications(data);
            } catch (err) {
                console.error('Error fetching notifications:', err);
                notifList.innerHTML = '<p class="notif-empty">Failed to load</p>';
            }
        }

        function renderNotifications(notifications) {
            if (!notifications || notifications.length === 0) {
                notifList.innerHTML = '<p class="notif-empty">No new bookings</p>';
                notifDot.style.display = 'none';
                return;
            }

            notifDot.style.display = 'block';

            notifList.innerHTML = notifications.map(n => {
                const bookingName = n.name || 'Booking';
                const bookingType = n.type === 'venue' ? 'Venue' : 'Event';
                const ticketLabel = n.countLabel || '';
                const date = new Date(n.createdAt).toLocaleString('en-US', { 
                    month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' 
                });
                return `
                    <div class="notif-item">
                        <p class="notif-item-title">New ${bookingType} Booking: ${n.userName}</p>
                        <p class="notif-item-sub">${bookingName}${ticketLabel ? ' · ' + ticketLabel : ''}</p>
                        <p class="notif-time">${date}</p>
                    </div>
                `;
            }).join('');
        }
        fetchNotifications();
    </script>
<script src="/js/user.js"></script>
</body>

</html>
