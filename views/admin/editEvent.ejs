<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Event – EMS Admin</title>
    <link rel="stylesheet" href="/css/admin-edit.css" />
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
        rel="stylesheet" />
</head>

<body>
    <!-- ── Navbar ── -->
    <header class="navbar">
        <div class="nav-inner">
            <span class="logo">EMS</span>
            <nav class="nav-links">
                <a href="/admin/events" class="nav-link">Events</a>
                <a href="/admin/dashboard" class="nav-link">Dashboard</a>
                <a href="/logout" class="nav-link">Logout</a>
            </nav>
        </div>
    </header>

    <main class="page-main">
        <!-- ── Breadcrumbs ── -->
        <div class="breadcrumbs">
            <a href="/admin/events" class="crumb">EVENTS</a>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
            <span class="crumb crumb--active">EDIT EVENT</span>
        </div>

        <% if (typeof error !=='undefined' && error && error.length> 0) { %>
            <div class="flash-error">
                <%= error %>
            </div>
            <% } %>

                <form action="/admin/events/edit/<%= event._id %>" method="POST" enctype="multipart/form-data"
                    class="edit-form">
                    <!-- ── Core Information ── -->
                    <div class="form-card">
                        <h2 class="card-title">Core Information</h2>

                        <div class="form-group">
                            <label for="name">EVENT NAME</label>
                            <input type="text" id="name" name="name" value="<%= event.name %>" required />
                        </div>

                        <div class="form-group">
                            <label for="description">DESCRIPTION</label>
                            <textarea id="description" name="description"
                                rows="5"><%= event.description || '' %></textarea>
                        </div>
                    </div>

                    <!-- ── Event Specs ── -->
                    <div class="form-card">
                        <h2 class="card-title">Event Specs</h2>

                        <div class="form-row three-col">
                            <div class="form-group">
                                <label for="category">CATEGORY</label>
                                <select id="category" name="category">
                                    <% const categories=['General', 'Technology' , 'Music & Entertainment'
                                        , 'Arts & Culture' , 'Sports & Fitness' , 'Business & Networking'
                                        , 'Food & Drink' , 'Education & Workshop' , 'Architecture & Design' ]; %>
                                        <% categories.forEach(function(cat) { %>
                                            <option value="<%= cat %>" <%=event.category===cat ? 'selected' : '' %>><%=
                                                    cat %>
                                            </option>
                                            <% }); %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="max_capacity">MAX CAPACITY</label>
                                <input type="number" id="max_capacity" name="max_capacity"
                                    value="<%= event.max_capacity %>" min="1" />
                            </div>
                            <div class="form-group">
                                <label for="ticket_price">TICKET PRICE ($)</label>
                                <input type="number" id="ticket_price" name="ticket_price"
                                    value="<%= event.ticket_price %>" step="0.01" min="0" />
                            </div>
                        </div>

                        <div class="status-tabs">
                            <label class="status-label">STATUS</label>
                            <div class="status-group">
                                <label class="status-tab <%= event.status === 'active' ? 'status-tab--active' : '' %>">
                                    <input type="radio" name="status" value="active" <%=event.status==='active'
                                        ? 'checked' : '' %> />
                                    Active
                                </label>
                                <label class="status-tab <%= event.status === 'draft' ? 'status-tab--active' : '' %>">
                                    <input type="radio" name="status" value="draft" <%=event.status==='draft'
                                        ? 'checked' : '' %> />
                                    Draft
                                </label>
                                <label
                                    class="status-tab <%= event.status === 'cancelled' ? 'status-tab--active' : '' %>">
                                    <input type="radio" name="status" value="cancelled" <%=event.status==='cancelled'
                                        ? 'checked' : '' %> />
                                    Cancelled
                                </label>
                                <label
                                    class="status-tab <%= event.status === 'completed' ? 'status-tab--active' : '' %>">
                                    <input type="radio" name="status" value="completed" <%=event.status==='completed'
                                        ? 'checked' : '' %> />
                                    Completed
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- ── Event Visuals ── -->
                    <div class="form-card">
                        <h2 class="card-title">Event Visuals</h2>

                        <div class="visuals-area">
                            <% if (event.banner_image) { %>
                                <div class="current-image" id="currentImage">
                                    <img src="<%= event.banner_image %>" alt="<%= event.name %>" />
                                    <div class="image-actions">
                                        <label class="btn-update-img" for="banner_image">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2">
                                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                                <polyline points="17 8 12 3 7 8"></polyline>
                                                <line x1="12" y1="3" x2="12" y2="15"></line>
                                            </svg>
                                            UPDATE IMAGE
                                        </label>
                                        <button type="button" class="btn-remove-img" id="removeImageBtn">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path
                                                    d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                </path>
                                            </svg>
                                            REMOVE
                                        </button>
                                    </div>
                                </div>
                                <% } %>
                                    <div class="upload-area" id="uploadArea"
                                        style="<%= event.banner_image ? 'display:none' : '' %>">
                                        <input type="file" id="banner_image" name="banner_image" accept="image/*"
                                            hidden />
                                        <div class="upload-placeholder" id="uploadPlaceholder">
                                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#aaa"
                                                stroke-width="1.5">
                                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                                <polyline points="21 15 16 10 5 21"></polyline>
                                            </svg>
                                            <p class="upload-text">Click or drag to upload new banner</p>
                                            <p class="upload-hint">PNG, JPG or WEBP • Max 5MB</p>
                                        </div>
                                        <div class="upload-preview" id="uploadPreview" style="display:none;">
                                            <img id="previewImg" src="" alt="Preview" />
                                            <button type="button" class="btn-remove-preview" id="removePreview">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2">
                                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                                </svg>
                                            </button>
                                        </div>
                                    </div>
                        </div>
                    </div>

                    <!-- ── Logistics & Venue ── -->
                    <div class="form-card">
                        <h2 class="card-title">Logistics & Venue</h2>

                        <div class="form-row three-col">
                            <div class="form-group">
                                <label for="date">DATE</label>
                                <input type="date" id="date" name="date"
                                    value="<%= event.date ? new Date(event.date).toISOString().split('T')[0] : '' %>"
                                    required />
                            </div>
                            <div class="form-group">
                                <label for="time">TIME</label>
                                <input type="time" id="time" name="time" value="<%= event.time || '' %>" required />
                            </div>
                            <div class="form-group">
                                <label for="location">VENUE</label>
                                <input type="text" id="location" name="location" value="<%= event.location || '' %>"
                                    placeholder="Venue name" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="city">CITY</label>
                            <input type="text" id="city" name="city" value="<%= event.city || '' %>"
                                placeholder="City" />
                        </div>
                    </div>

                    <!-- ── Actions ── -->
                    <div class="form-actions">
                        <button type="submit" class="btn-save">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2.5">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            SAVE CHANGES
                        </button>
                        <div class="secondary-actions">
                            <form action="/admin/events/delete/<%= event._id %>" method="POST" style="display:inline"
                                onsubmit="return confirm('Are you sure you want to delete this event? This action cannot be undone.')">
                                <button type="submit" class="btn-delete">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path
                                            d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                        </path>
                                    </svg>
                                    Delete Event
                                </button>
                            </form>
                            <a href="/admin/events" class="btn-cancel">Cancel</a>
                        </div>
                    </div>
                </form>
    </main>

    <footer class="footer">
        <span class="footer-copy">COPYRIGHT © 2026 EMS. ALL RIGHTS RESERVED.</span>
        <div class="footer-links">
            <a href="#">TERMS</a>
            <a href="#">PRIVACY</a>
        </div>
    </footer>

    <script>
        // File upload handling
        const uploadArea = document.getElementById('uploadArea');
        const fileInput = document.getElementById('banner_image');
        const placeholder = document.getElementById('uploadPlaceholder');
        const preview = document.getElementById('uploadPreview');
        const previewImg = document.getElementById('previewImg');
        const removePreviewBtn = document.getElementById('removePreview');

        uploadArea.addEventListener('click', () => fileInput.click());
        uploadArea.addEventListener('dragover', (e) => { e.preventDefault(); uploadArea.classList.add('dragover'); });
        uploadArea.addEventListener('dragleave', () => uploadArea.classList.remove('dragover'));
        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadArea.classList.remove('dragover');
            if (e.dataTransfer.files.length) {
                fileInput.files = e.dataTransfer.files;
                showPreview(e.dataTransfer.files[0]);
            }
        });

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length) showPreview(fileInput.files[0]);
        });

        function showPreview(file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                previewImg.src = e.target.result;
                placeholder.style.display = 'none';
                preview.style.display = 'flex';
            };
            reader.readAsDataURL(file);
        }

        if (removePreviewBtn) {
            removePreviewBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                fileInput.value = '';
                previewImg.src = '';
                preview.style.display = 'none';
                placeholder.style.display = 'flex';
            });
        }

        // Remove existing image
        const removeImageBtn = document.getElementById('removeImageBtn');
        if (removeImageBtn) {
            removeImageBtn.addEventListener('click', async () => {
                if (!confirm('Remove current event image?')) return;
                try {
                    const res = await fetch('/admin/events/remove-image/<%= event._id %>', { method: 'POST' });
                    const data = await res.json();
                    if (data.success) {
                        document.getElementById('currentImage').style.display = 'none';
                        uploadArea.style.display = '';
                    }
                } catch (e) {
                    alert('Failed to remove image');
                }
            });
        }

        // Status tabs
        document.querySelectorAll('.status-tab input').forEach(radio => {
            radio.addEventListener('change', () => {
                document.querySelectorAll('.status-tab').forEach(t => t.classList.remove('status-tab--active'));
                radio.parentElement.classList.add('status-tab--active');
            });
        });
    </script>
</body>

</html>