<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Events – EMS Admin</title>
    <link rel="stylesheet" href="/css/admin-create.css" />
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
        rel="stylesheet" />
</head>

<body>
    <!-- ── Navbar ── -->
    <header class="navbar">
        <div class="nav-inner">
            <div class="nav-brand">
                <span class="logo">EMS</span>
            </div>
            <nav class="nav-links">
                <a href="/admin/dashboard" class="nav-link">Events</a>
                
                <button class="icon-btn" id="notifBtn" aria-label="Notifications" title="Recent Bookings">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                    </svg>
                    <span class="notif-dot" id="notifDot" style="display: none;"></span>
                </button>

                <div class="notif-dropdown" id="notifDropdown" style="right: 50px;">
                    <p class="notif-title">RECENT BOOKINGS</p>
                    <div id="notifList">
                        <p class="notif-empty">Loading notifications...</p>
                    </div>
                </div>

                <div class="user-menu-container">
                    <button class="user-trigger" id="userTrigger" title="User Account">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </button>
                    <div class="user-dropdown" id="userDropdown">
                        <a href="/profile" class="dropdown-link">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path
                                    d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1-2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z">
                                </path>
                            </svg>
                            Profile
                        </a>
                        <a href="/logout" class="dropdown-link logout">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            Logout
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main class="create-layout">
        <!-- ── Left Panel ── -->
        <aside class="left-panel">
            <div class="left-panel-content">

                <div class="sidebar-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                    </svg>
                </div>
                <h1 class="left-heading">Refining the<br />Experience.</h1>
                <p class="left-caption">Update your event details to keep your audience informed. Every change is
                    reflected in real-time.</p>

                <div class="quality-checklist">
                    <p class="checklist-title">Update Guidelines</p>
                    <div class="checklist-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Ensure dates are in the future</span>
                    </div>
                    <div class="checklist-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Verify ticket price and capacity</span>
                    </div>
                    <div class="checklist-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Review status for visibility</span>
                    </div>
                </div>


            </div>
        </aside>

        <!-- ── Right Panel (Form) ── -->
        <section class="right-panel">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
                <a href="/admin/dashboard"
                    style="color: var(--text-muted); text-decoration: none; font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    BACK TO EVENTS
                </a>
                <form action="/admin/events/delete/<%= event._id %>" method="POST"
                    onsubmit="return confirm('Silmeye emin misiniz?')">
                    <button type="submit" class="btn-danger-outline"
                        style="border: none; color: #ef4444; background: #fee2e2; padding: 8px 16px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer;">
                        DELETE EVENT
                    </button>
                </form>
            </div>

            <form action="/admin/events/edit/<%= event._id %>" method="POST" enctype="multipart/form-data"
                class="event-form">

                <div class="form-section">
                    <h2 class="form-section-title">Event Visuals</h2>
                    <div class="upload-wrapper" style="margin-top: 20px;">
                        <div class="upload-area" id="uploadArea">
                            <input type="file" id="banner_image" name="banner_image" accept="image/*" hidden />

                            <div class="upload-placeholder" id="uploadPlaceholder"
                                style="display: <%= event.imagePath ? 'none' : 'flex' %>;">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="1.5">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                    <polyline points="21 15 16 10 5 21"></polyline>
                                </svg>
                                <p class="upload-text">Upload New Banner</p>
                            </div>

                            <div class="upload-preview" id="uploadPreview"
                                style="display: <%= event.imagePath ? 'block' : 'none' %>;">
                                <img id="previewImg" src="<%= event.imagePath || '' %>" alt="Preview" />
                                <button type="button" class="remove-img" id="removeImageBtn">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-section-head">
                        <h2 class="form-section-title">Core Information</h2>
                    </div>

                    <div class="form-group">
                        <label for="eventName">Event Name</label>
                        <input type="text" id="eventName" name="eventName" value="<%= event.eventName %>" required />
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="categoryId">Category</label>
                            <select id="categoryId" name="categoryId" required>
                                <% categories.forEach(cat=> { %>
                                    <option value="<%= cat._id %>" <%=(event.categoryId &&
                                        event.categoryId.toString()===cat._id.toString()) ? 'selected' : '' %>>
                                        <%= cat.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="status">Event Status</label>
                            <select id="status" name="status">
                                <option value="upcoming" <%=event.status==='upcoming' ? 'selected' : '' %>>Upcoming
                                </option>
                                <option value="ongoing" <%=event.status==='ongoing' ? 'selected' : '' %>>Ongoing
                                </option>
                                <option value="completed" <%=event.status==='completed' ? 'selected' : '' %>>Completed
                                </option>
                                <option value="cancelled" <%=event.status==='cancelled' ? 'selected' : '' %>>Cancelled
                                </option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="description">Event Description</label>
                        <textarea id="description" name="description" rows="6"><%= event.description %></textarea>
                    </div>
                </div>

                <div class="form-section">
                    <h2 class="form-section-title">Logistics & Venue</h2>

                    <div class="form-row" style="margin-top: 24px;">
                        <div class="form-group">
                            <label for="startDate">Start Date</label>
                            <input type="date" id="startDate" name="startDate"
                                value="<%= event.startDate ? new Date(event.startDate).toISOString().split('T')[0] : '' %>"
                                required />
                        </div>
                        <div class="form-group">
                            <label for="startTime">Start Time</label>
                            <input type="time" id="startTime" name="startTime" value="<%= event.startTime %>" required />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="endDate">End Date</label>
                            <input type="date" id="endDate" name="endDate"
                                value="<%= event.endDate ? new Date(event.endDate).toISOString().split('T')[0] : '' %>"
                                required />
                        </div>
                        <div class="form-group">
                            <label for="endTime">End Time</label>
                            <input type="time" id="endTime" name="endTime" value="<%= event.endTime %>" required />
                        </div>
                    </div>

                    <div class="form-row three-col">
                        <div class="form-group">
                            <label for="maxCapacity">Max Capacity</label>
                            <input type="number" id="maxCapacity" name="maxCapacity" value="<%= event.maxCapacity %>" min="0" required />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="ticketPrice">Ticket Price ($)</label>
                            <input type="number" id="ticketPrice" name="ticketPrice" value="<%= event.ticketPrice %>" min="0"
                                step="0.01" />
                        </div>
                        <div class="form-group">
                            <label for="location">Location / Venue</label>
                            <input type="text" id="location" name="location" value="<%= event.location %>" required />
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-secondary"
                        onclick="window.location.href='/admin/dashboard'">CANCEL</button>
                    <button type="submit" class="btn-primary">SAVE CHANGES</button>
                </div>
            </form>
        </section>
    </main>

    <script>
        // Enforce today or future date for selection
        const startDateInput = document.getElementById('startDate');
        const endDateInput = document.getElementById('endDate');
        const now = new Date();
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const day = String(now.getDate()).padStart(2, '0');
        const minDate = `${year}-${month}-${day}`;
        
        startDateInput.min = minDate;
        endDateInput.min = minDate;

        startDateInput.addEventListener('change', () => {
            if (startDateInput.value) {
                endDateInput.min = startDateInput.value;
                if (endDateInput.value && endDateInput.value < startDateInput.value) {
                    endDateInput.value = startDateInput.value;
                }
            }
        });

        const uploadArea = document.getElementById('uploadArea');
        const fileInput = document.getElementById('banner_image');
        const placeholder = document.getElementById('uploadPlaceholder');
        const preview = document.getElementById('uploadPreview');
        const previewImg = document.getElementById('previewImg');
        const removeBtn = document.getElementById('removeImageBtn');

        uploadArea.addEventListener('click', () => fileInput.click());

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length) showPreview(fileInput.files[0]);
        });

        function showPreview(file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                previewImg.src = e.target.result;
                placeholder.style.display = 'none';
                preview.style.display = 'block';
            };
            reader.readAsDataURL(file);
        }

        removeBtn.addEventListener('click', async (e) => {
            e.stopPropagation();
            if (fileInput.files.length > 0) {
                fileInput.value = '';
                previewImg.src = '<%= event.imagePath || "" %>';
                if (!previewImg.src) {
                    preview.style.display = 'none';
                    placeholder.style.display = 'block';
                }
            } else {
                if (!confirm('Remove current event image?')) return;
                try {
                    const res = await fetch('/admin/events/remove-image/<%= event._id %>', { method: 'POST' });
                    const data = await res.json();
                    if (data.success) {
                        previewImg.src = '';
                        preview.style.display = 'none';
                        placeholder.style.display = 'block';
                    }
                } catch (e) {
                    alert('Failed to remove image');
                }
            }
        });

        // ─── Navbar Elements ───
        const userTrigger = document.getElementById('userTrigger');
        const userDropdown = document.getElementById('userDropdown');
        const notifBtn = document.getElementById('notifBtn');
        const notifDropdown = document.getElementById('notifDropdown');
        const notifList = document.getElementById('notifList');
        const notifDot = document.getElementById('notifDot');

        if (userTrigger) {
            userTrigger.addEventListener('click', (e) => {
                e.stopPropagation();
                userDropdown.classList.toggle('show');
                notifDropdown.classList.remove('show');
            });
            document.addEventListener('click', () => {
                userDropdown.classList.remove('show');
                notifDropdown.classList.remove('show');
            });
        }

        // ─── Notifications Toggle & Fetch ───
        notifBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            notifDropdown.classList.toggle('show');
            userDropdown.classList.remove('show');
            if (notifDropdown.classList.contains('show')) {
                fetchNotifications();
            }
        });

        async function fetchNotifications() {
            try {
                const response = await fetch('/admin/notifications');
                const data = await response.json();
                renderNotifications(data);
            } catch (err) {
                console.error('Error fetching notifications:', err);
                notifList.innerHTML = '<p class="notif-empty">Failed to load</p>';
            }
        }

        function renderNotifications(notifications) {
            if (!notifications || notifications.length === 0) {
                notifList.innerHTML = '<p class="notif-empty">No new bookings</p>';
                notifDot.style.display = 'none';
                return;
            }

            notifDot.style.display = 'block';

            notifList.innerHTML = notifications.map(n => {
                const eventName = n.eventId ? (n.eventId.eventName || n.eventId.title) : 'Event';
                const date = new Date(n.createdAt).toLocaleString('en-US', { 
                    month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' 
                });
                return `
                    <div class="notif-item">
                        <p class="notif-item-title">New Booking: ${n.userName}</p>
                        <p class="notif-item-sub">${eventName} · ${n.ticketCount} tickets</p>
                        <p class="notif-time">${date}</p>
                    </div>
                `;
            }).join('');
        }
        fetchNotifications();
    </script>
</body>

</html>