<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Events – EMS Admin</title>
    <link rel="stylesheet" href="/css/admin-create.css" />
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
        rel="stylesheet" />
    <style>
        /* ── Custom Deletion Modal ── */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.4);
            backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 2000;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .modal-overlay.show {
            opacity: 1;
            visibility: visible;
        }
        .modal-card {
            background: #ffffff;
            width: 90%;
            max-width: 440px;
            padding: 32px;
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
            transform: scale(0.9) translateY(20px);
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            text-align: center;
        }
        .modal-overlay.show .modal-card {
            transform: scale(1) translateY(0);
        }
        .modal-warning-icon {
            width: 64px;
            height: 64px;
            background: #fef2f2;
            color: #ef4444;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
        }
        .modal-title {
            font-size: 24px;
            color: #1e293b;
            margin-bottom: 12px;
            font-weight: 700;
            font-family: 'DM Sans', sans-serif;
        }
        .modal-text {
            color: #64748b;
            line-height: 1.6;
            margin-bottom: 32px;
            font-family: 'DM Sans', sans-serif;
        }
        .modal-event-name {
            display: block;
            margin-top: 8px;
            font-weight: 700;
            color: #0f172a;
        }
        .modal-actions {
            display: flex;
            gap: 12px;
        }
        .modal-btn {
            flex: 1;
            padding: 14px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
            border: none;
        }
        .btn-cancel {
            background: #f1f5f9;
            color: #64748b;
        }
        .btn-cancel:hover {
            background: #e2e8f0;
            color: #0f172a;
        }
        .btn-confirm-delete {
            background: #ef4444;
            color: white;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);
        }
        .btn-confirm-delete:hover {
            background: #dc2626;
            transform: translateY(-2px);
        }
    </style>
</head>

<body>
    <!-- ── Navbar ── -->
    <header class="navbar">
        <div class="nav-inner">
            <div class="nav-brand">
                <a href="/admin/dashboard" class="logo" style="text-decoration: none; color: #1e293b !important; font-size: 1.25rem !important; font-weight: 800 !important; letter-spacing: normal !important; font-family: 'DM Sans', sans-serif !important;">EMS</a>
            </div>
            <nav class="nav-links">
                <a href="/admin/dashboard" class="nav-link">Events</a>
                <a href="/admin/venues" class="nav-link">Venues</a>
                <a href="/admin/messages" class="nav-link">Messages</a>
                <a href="/admin/users" class="nav-link">Users</a>

                <div class="admin-notif-wrapper" style="position: relative; display: flex; align-items: center;">
                    <button class="icon-btn" id="notifBtn" aria-label="Notifications" title="Recent Bookings">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                        </svg>
                        <span class="notif-dot" id="notifDot" style="display: none;"></span>
                    </button>

                    <div class="notif-dropdown" id="notifDropdown" style="position: absolute; top: calc(100% + 12px); right: 0; width: 320px; padding: 0; overflow: hidden; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1); z-index: 1000; display: none;">
                        <p class="notif-title">RECENT BOOKINGS</p>
                        <div id="notifList">
                            <p class="notif-empty">Loading notifications...</p>
                        </div>
                    </div>
                </div>

                <div class="user-menu-container">
                    <button class="user-trigger" id="userTrigger" title="User Account">
                        <% if (locals.user && user.profileImage && user.profileImage !== 'https://tinyurl.com/3jjyxzj6') { %>
                            <img src="<%= user.profileImage %>" alt="User avatar" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" />
                        <% } else { %>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        <% } %>
                    </button>
                    <div class="user-dropdown" id="userDropdown">
                        <a href="/profile" class="dropdown-link">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path
                                    d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1-2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z">
                                </path>
                            </svg>
                            Profile
                        </a>
                        <a href="/logout" class="dropdown-link logout">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            Logout
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main class="create-layout">
        <!-- ── Left Panel ── -->
        <aside class="left-panel">
            <div class="left-panel-content">

                <div class="sidebar-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path
                            d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z">
                        </path>
                    </svg>
                </div>
                <h1 class="left-heading">Refining the<br />Experience.</h1>
                <p class="left-caption">Update your event details to keep your audience informed. Every change is
                    reflected in real-time.</p>

                <div class="quality-checklist">
                    <p class="checklist-title">Update Guidelines</p>
                    <div class="checklist-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="3">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Ensure dates are in the future</span>
                    </div>
                    <div class="checklist-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="3">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Verify ticket price and capacity</span>
                    </div>
                    <div class="checklist-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="3">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Review status for visibility</span>
                    </div>
                </div>


            </div>
        </aside>

        <!-- ── Right Panel (Form) ── -->
        <section class="right-panel">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
                <a href="/admin/dashboard"
                    style="color: var(--text-muted); text-decoration: none; font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    BACK TO EVENTS
                </a>
                <button type="button" class="btn-danger-outline" onclick="openDeleteModal('<%= event._id %>', '<%= (event.eventName || event.title).replace(/\'/g, "\\'") %>')"
                    style="border: none; color: #ef4444; background: #fee2e2; padding: 8px 16px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer;">
                    DELETE EVENT
                </button>
            </div>

            <form action="/admin/events/edit/<%= event._id %>" method="POST" enctype="multipart/form-data"
                class="event-form">

                <div class="form-section">
                    <h2 class="form-section-title">Event Visuals</h2>
                    <div class="upload-wrapper" style="margin-top: 20px;">
                        <div class="upload-area" id="uploadArea">
                            <input type="file" id="banner_image" name="banner_image" accept="image/*" hidden />

                            <div class="upload-placeholder" id="uploadPlaceholder"
                                style="display: <%= event.imagePath ? 'none' : 'flex' %>;">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="1.5">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                    <polyline points="21 15 16 10 5 21"></polyline>
                                </svg>
                                <p class="upload-text">Upload New Banner</p>
                            </div>

                            <div class="upload-preview" id="uploadPreview"
                                style="display: <%= event.imagePath ? 'block' : 'none' %>;">
                                <img id="previewImg" src="<%= event.imagePath || '' %>" alt="Preview" />
                                <button type="button" class="remove-img" id="removeImageBtn">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-section-head">
                        <h2 class="form-section-title">Core Information</h2>
                    </div>

                    <div class="form-group">
                        <label for="eventName">Event Name</label>
                        <input type="text" id="eventName" name="eventName" value="<%= event.eventName %>" required />
                        <div class="error-msg" id="eventName-error"></div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="categoryId">Category</label>
                            <select id="categoryId" name="categoryId" required>
                                <% categories.forEach(cat=> { %>
                                    <option value="<%= cat._id %>" <%=(event.categoryId &&
                                        event.categoryId.toString()===cat._id.toString()) ? 'selected' : '' %>>
                                        <%= cat.name %>
                                    </option>
                                    <% }) %>
                            </select>
                            <div class="error-msg" id="categoryId-error"></div>
                        </div>
                        <div class="form-group">
                            <label for="status">Event Status</label>
                            <select id="status" name="status">
                                <option value="upcoming" <%=event.status==='upcoming' ? 'selected' : '' %>>Upcoming
                                </option>
                                <option value="ongoing" <%=event.status==='ongoing' ? 'selected' : '' %>>Ongoing
                                </option>
                                <option value="completed" <%=event.status==='completed' ? 'selected' : '' %>>Completed
                                </option>
                                <option value="cancelled" <%=event.status==='cancelled' ? 'selected' : '' %>>Cancelled
                                </option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="description">Event Description</label>
                        <textarea id="description" name="description" rows="6"><%= event.description %></textarea>
                    </div>
                </div>

                <div class="form-section">
                    <h2 class="form-section-title">Logistics & Venue</h2>

                    <div class="form-row" style="margin-top: 24px;">
                        <div class="form-group">
                            <label for="startDate">Start Date</label>
                            <input type="date" id="startDate" name="startDate"
                                value="<%= event.startDate ? new Date(event.startDate).toISOString().split('T')[0] : '' %>"
                                required />
                            <div class="error-msg" id="startDate-error"></div>
                        </div>
                        <div class="form-group">
                            <label for="startTime">Start Time</label>
                            <input type="time" id="startTime" name="startTime" value="<%= event.startTime %>"
                                required />
                            <div class="error-msg" id="startTime-error"></div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="endDate">End Date</label>
                            <input type="date" id="endDate" name="endDate"
                                value="<%= event.endDate ? new Date(event.endDate).toISOString().split('T')[0] : '' %>"
                                required />
                            <div class="error-msg" id="endDate-error"></div>
                        </div>
                        <div class="form-group">
                            <label for="endTime">End Time</label>
                            <input type="time" id="endTime" name="endTime" value="<%= event.endTime %>" required />
                            <div class="error-msg" id="endTime-error"></div>
                        </div>
                    </div>

                    <div class="form-row three-col">
                        <div class="form-group">
                            <label for="maxCapacity">Max Capacity</label>
                            <input type="number" id="maxCapacity" name="maxCapacity" value="<%= event.maxCapacity %>"
                                min="1" max="100000" required />
                            <div class="error-msg" id="maxCapacity-error"></div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="ticketPrice">Ticket Price (NPR)</label>
                            <input type="number" id="ticketPrice" name="ticketPrice" value="<%= event.ticketPrice %>"
                                min="0" max="100000" step="0.01" />
                            <div class="error-msg" id="ticketPrice-error"></div>
                        </div>
                        <div class="form-group">
                            <label for="location">Location / Venue</label>
                            <input type="text" id="location" name="location" value="<%= event.location %>" required />
                            <div class="error-msg" id="location-error"></div>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-secondary"
                        onclick="window.location.href='/admin/dashboard'">CANCEL</button>
                    <button type="submit" class="btn-primary">SAVE CHANGES</button>
                </div>
            </form>
        </section>
    </main>

    <script>
        // Enforce today or future date for selection
        const startDateInput = document.getElementById('startDate');
        const endDateInput = document.getElementById('endDate');
        const now = new Date();
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const day = String(now.getDate()).padStart(2, '0');
        const minDate = `${year}-${month}-${day}`;

        startDateInput.min = minDate;
        endDateInput.min = minDate;

        const startTimeInput = document.getElementById('startTime');
        const endTimeInput = document.getElementById('endTime');

        function updateTimeConstraints() {
            const now = new Date();
            const currentTime = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
            const selectedStartDate = startDateInput.value;
            const selectedEndDate = endDateInput.value;

            if (selectedStartDate === minDate) {
                startTimeInput.min = currentTime;
            } else {
                startTimeInput.removeAttribute('min');
            }

            if (selectedStartDate && selectedEndDate && selectedStartDate === selectedEndDate) {
                if (startTimeInput.value) {
                    endTimeInput.min = startTimeInput.value;
                } else {
                    endTimeInput.removeAttribute('min');
                }
            } else {
                endTimeInput.removeAttribute('min');
            }
        }

        const startTimeError = document.getElementById('startTime-error');
        const endTimeError = document.getElementById('endTime-error');
        const eventNameInput = document.getElementById('eventName');
        const categoryIdInput = document.getElementById('categoryId');
        const maxCapacityInput = document.getElementById('maxCapacity');
        const ticketPriceInput = document.getElementById('ticketPrice');
        const locationInput = document.getElementById('location');

        const eventNameError = document.getElementById('eventName-error');
        const categoryIdError = document.getElementById('categoryId-error');
        const maxCapacityError = document.getElementById('maxCapacity-error');
        const ticketPriceError = document.getElementById('ticketPrice-error');
        const locationError = document.getElementById('location-error');
        const startDateError = document.getElementById('startDate-error');
        const endDateError = document.getElementById('endDate-error');

        function showError(element, errorElement, message) {
            element.closest('.form-group').classList.add('has-error');
            errorElement.textContent = message;
            errorElement.style.display = 'block';
        }

        function clearError(element, errorElement) {
            element.closest('.form-group').classList.remove('has-error');
            errorElement.textContent = '';
            errorElement.style.display = 'none';
        }

        const touchedFields = new Set();

        function validateField(input, errorElement, checkFn, isSubmit) {
            if (!isSubmit && !touchedFields.has(input.id)) return true;
            const message = checkFn();
            if (message) {
                showError(input, errorElement, message);
                return false;
            } else {
                clearError(input, errorElement);
                return true;
            }
        }

        function validateEventName(isSubmit = false) {
            return validateField(eventNameInput, eventNameError, () => {
                if (!eventNameInput.value.trim()) return 'Event Name is required.';
                return null;
            }, isSubmit);
        }

        function validateCategory(isSubmit = false) {
            return validateField(categoryIdInput, categoryIdError, () => {
                if (!categoryIdInput.value) return 'Please select an event category.';
                return null;
            }, isSubmit);
        }

        function validateStartDate(isSubmit = false) {
            return validateField(startDateInput, startDateError, () => {
                if (!startDateInput.value) return 'Start Date is required.';
                return null;
            }, isSubmit);
        }

        function validateEndDate(isSubmit = false) {
            return validateField(endDateInput, endDateError, () => {
                if (!endDateInput.value) return 'End Date is required.';
                return null;
            }, isSubmit);
        }

        function validateStartTime(isSubmit = false) {
            return validateField(startTimeInput, startTimeError, () => {
                const now = new Date();
                const currentTime = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
                const selectedStartDate = startDateInput.value;
                if (!startTimeInput.value) return 'Start Time is required.';
                if (selectedStartDate === minDate && startTimeInput.value < currentTime) {
                    return 'Start time cannot be in the past for today.';
                }
                return null;
            }, isSubmit);
        }

        function validateEndTime(isSubmit = false) {
            return validateField(endTimeInput, endTimeError, () => {
                const selectedStartDate = startDateInput.value;
                const selectedEndDate = endDateInput.value;
                if (!endTimeInput.value) return 'End Time is required.';
                if (selectedStartDate && selectedEndDate && selectedStartDate === selectedEndDate) {
                    if (startTimeInput.value && startTimeInput.value >= endTimeInput.value) {
                        return 'End time must be after the start time.';
                    }
                }
                return null;
            }, isSubmit);
        }

        function validateMaxCapacity(isSubmit = false) {
            return validateField(maxCapacityInput, maxCapacityError, () => {
                if (!isSubmit && maxCapacityInput.value === '') {
                    return null;
                }
                const cap = parseInt(maxCapacityInput.value);
                if (isNaN(cap) || cap < 1 || cap > 100000) {
                    return 'Capacity must be between 1 and 100,000 attendees.';
                }
                return null;
            }, isSubmit);
        }

        function validateTicketPrice(isSubmit = false) {
            return validateField(ticketPriceInput, ticketPriceError, () => {
                if (ticketPriceInput.value === '') return null; // optional
                const price = parseFloat(ticketPriceInput.value);
                if (isNaN(price) || price < 0 || price > 100000) {
                    return 'Ticket price must be between NPR 0 and NPR 100,000.';
                }
                return null;
            }, isSubmit);
        }

        function validateLocation(isSubmit = false) {
            return validateField(locationInput, locationError, () => {
                if (!locationInput.value.trim()) return 'Location/Venue is required.';
                return null;
            }, isSubmit);
        }

        const allInputs = [
            { input: eventNameInput, validate: validateEventName },
            { input: categoryIdInput, validate: validateCategory },
            { input: startDateInput, validate: validateStartDate },
            { input: endDateInput, validate: validateEndDate },
            { input: startTimeInput, validate: validateStartTime },
            { input: endTimeInput, validate: validateEndTime },
            { input: maxCapacityInput, validate: validateMaxCapacity },
            { input: ticketPriceInput, validate: validateTicketPrice },
            { input: locationInput, validate: validateLocation }
        ];

        allInputs.forEach(({ input, validate }) => {
            const eventType = input.tagName === 'SELECT' ? 'change' : 'input';
            input.addEventListener(eventType, () => {
                touchedFields.add(input.id);
                validate(false);
            });
        });

        startDateInput.addEventListener('change', () => {
            if (startDateInput.value) {
                endDateInput.min = startDateInput.value;
                if (endDateInput.value && endDateInput.value < startDateInput.value) {
                    endDateInput.value = startDateInput.value;
                }
            }
            updateTimeConstraints();
            touchedFields.add(startDateInput.id);
            validateStartDate(false);
            validateStartTime(false);
            validateEndTime(false);
        });

        endDateInput.addEventListener('change', () => {
            updateTimeConstraints();
            touchedFields.add(endDateInput.id);
            validateEndDate(false);
            validateEndTime(false);
        });

        // Initial run to set constraints for existing data
        updateTimeConstraints();

        function validateAll() {
            let isValid = true;
            allInputs.forEach(({ validate }) => {
                const res = validate(true);
                if (!res) isValid = false;
            });
            return isValid;
        }

        const eventForm = document.querySelector('form');
        eventForm.addEventListener('submit', (e) => {
            if (!validateAll()) {
                e.preventDefault();
                const firstError = document.querySelector('.has-error');
                if (firstError) {
                    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        });

        const uploadArea = document.getElementById('uploadArea');
        const fileInput = document.getElementById('banner_image');
        const placeholder = document.getElementById('uploadPlaceholder');
        const preview = document.getElementById('uploadPreview');
        const previewImg = document.getElementById('previewImg');
        const removeBtn = document.getElementById('removeImageBtn');

        uploadArea.addEventListener('click', () => fileInput.click());

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length) showPreview(fileInput.files[0]);
        });

        function showPreview(file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                previewImg.src = e.target.result;
                placeholder.style.display = 'none';
                preview.style.display = 'block';
            };
            reader.readAsDataURL(file);
        }

        removeBtn.addEventListener('click', async (e) => {
            e.stopPropagation();
            if (fileInput.files.length > 0) {
                fileInput.value = '';
                previewImg.src = '<%= event.imagePath || "" %>';
                if (!previewImg.src) {
                    preview.style.display = 'none';
                    placeholder.style.display = 'block';
                }
            } else {
                if (!confirm('Remove current event image?')) return;
                try {
                    const res = await fetch('/admin/events/remove-image/<%= event._id %>', { method: 'POST' });
                    const data = await res.json();
                    if (data.success) {
                        previewImg.src = '';
                        preview.style.display = 'none';
                        placeholder.style.display = 'block';
                    }
                } catch (e) {
                    alert('Failed to remove image');
                }
            }
        });

    </script>

    <!-- Deletion Modal Script & HTML -->
    <script>
        function openDeleteModal(eventId, eventName) {
            const deleteModal = document.getElementById('deleteModal');
            const deleteForm = document.getElementById('deleteForm');
            const eventNameSpan = document.getElementById('deleteEventName');
            
            if (deleteForm) deleteForm.action = `/admin/events/delete/${eventId}`;
            if (eventNameSpan) eventNameSpan.textContent = eventName;
            if (deleteModal) deleteModal.classList.add('show');
        }

        function closeDeleteModal() {
            const deleteModal = document.getElementById('deleteModal');
            if (deleteModal) deleteModal.classList.remove('show');
        }
    </script>

    <!-- ── Deletion Modal HTML ── -->
    <div class="modal-overlay" id="deleteModal" onclick="if(event.target === this) closeDeleteModal()">
        <div class="modal-card">
            <div class="modal-warning-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M3 6h18"></path>
                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                    <line x1="10" y1="11" x2="10" y2="17"></line>
                    <line x1="14" y1="11" x2="14" y2="17"></line>
                </svg>
            </div>
            <h2 class="modal-title">Delete Event?</h2>
            <p class="modal-text">
                Are you sure you want to permanently remove
                <span id="deleteEventName" class="modal-event-name">Event Name</span>
                This action cannot be undone.
            </p>
            <div class="modal-actions">
                <button type="button" class="modal-btn btn-cancel" onclick="closeDeleteModal()">CANCEL</button>
                <form id="deleteForm" method="POST" style="flex: 1;">
                    <button type="submit" class="modal-btn btn-confirm-delete">CONFIRM DELETE</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Unified Notifications System -->
    <script src="/js/admin-notif.js"></script>
</body>
</html>