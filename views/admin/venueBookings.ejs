<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Venue Bookings – <%= venue.name %></title>
    <link rel="stylesheet" href="/css/admin-manage.css" />
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
        rel="stylesheet" />
</head>

<body>
    <!-- ── Navbar ── -->
    <header class="navbar">
        <div class="nav-inner">
            <div class="nav-brand">
                <a href="/admin/dashboard" class="logo" style="text-decoration: none; color: inherit;">EMS</a>
            </div>
            <nav class="nav-links">
                <a href="/admin/dashboard" class="nav-link">Events</a>
                <a href="/admin/venues" class="nav-link active">Venues</a>

                <button class="icon-btn" id="notifBtn" aria-label="Notifications" title="Recent Bookings">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                    </svg>
                    <span class="notif-dot" id="notifDot" style="display: none;"></span>
                </button>

                <div class="notif-dropdown" id="notifDropdown">
                    <p class="notif-title">RECENT BOOKINGS</p>
                    <div id="notifList">
                        <p class="notif-empty">Loading notifications...</p>
                    </div>
                </div>

                <div class="user-menu-container">
                    <button class="user-trigger" id="userTrigger" title="User Account">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </button>
                </div>
            </nav>
        </div>
    </header>

    <main class="page-main">
        <div class="page-header">
            <div class="header-content">
                <a href="/admin/venues" style="color: var(--text-muted); text-decoration: none; font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    BACK TO VENUES
                </a>
                <h1 class="page-title">Bookings for <%= venue.name %></h1>
                <p class="page-eyebrow"><%= totalConfirmed %> Confirmed Bookings</p>
            </div>
            <div class="header-actions">
                <a href="/admin/venues/export-csv/<%= venue._id %>" class="btn-create">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    EXPORT CSV
                </a>
            </div>
        </div>

        <div class="table-container">
            <table class="events-table">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Event Name</th>
                        <th>Booking Date</th>
                        <th>Time Slot</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (confirmedBookings.length === 0 && cancelledBookings.length === 0) { %>
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 48px; color: var(--text-muted);">
                                No bookings found for this venue.
                            </td>
                        </tr>
                    <% } else { %>
                        <% confirmedBookings.forEach(booking => { %>
                            <tr>
                                <td><%= booking.userName %></td>
                                <td><%= booking.eventName || (booking.eventId ? booking.eventId.eventName : 'N/A') %></td>
                                <td><%= new Date(booking.createdAt).toLocaleDateString() %></td>
                                <td><%= booking.eventId ? booking.eventId.startTime + ' - ' + booking.eventId.endTime : 'N/A' %></td>
                                <td><span class="status-pill status-confirmed">Confirmed</span></td>
                            </tr>
                        <% }) %>
                        <% cancelledBookings.forEach(booking => { %>
                            <tr style="opacity: 0.6;">
                                <td><%= booking.userName %></td>
                                <td><%= booking.eventName || (booking.eventId ? booking.eventId.eventName : 'N/A') %></td>
                                <td><%= new Date(booking.createdAt).toLocaleDateString() %></td>
                                <td><%= booking.eventId ? booking.eventId.startTime + ' - ' + booking.eventId.endTime : 'N/A' %></td>
                                <td><span class="status-pill status-cancelled">Cancelled</span></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <script>
        // Copy the same notification/dropdown script from other pages if needed
        const notifBtn = document.getElementById('notifBtn');
        const notifDropdown = document.getElementById('notifDropdown');
        const notifList = document.getElementById('notifList');
        const notifDot = document.getElementById('notifDot');

        notifBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            notifDropdown.classList.toggle('show');
            if (notifDropdown.classList.contains('show')) {
                fetchNotifications();
            }
        });

        async function fetchNotifications() {
            try {
                const response = await fetch('/admin/notifications');
                const data = await response.json();
                renderNotifications(data);
            } catch (err) {
                console.error('Error fetching notifications:', err);
            }
        }

        function renderNotifications(notifications) {
            if (!notifications || notifications.length === 0) {
                if (notifList) notifList.innerHTML = '<p class="notif-empty">No new bookings</p>';
                if (notifDot) notifDot.style.display = 'none';
                return;
            }
            if (notifDot) notifDot.style.display = 'block';
            if (notifList) {
                notifList.innerHTML = notifications.map(n => {
                    const eventName = n.eventId ? (n.eventId.eventName || n.eventId.title) : 'Event';
                    return `<div class="notif-item"><p class="notif-item-title">New Booking: ${n.userName}</p><p class="notif-item-sub">${eventName}</p></div>`;
                }).join('');
            }
        }
        fetchNotifications();
    </script>
</body>

</html>
