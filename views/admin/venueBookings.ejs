<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Venue Bookings – <%= venue.name %>
    </title>
    <link rel="stylesheet" href="/css/admin-manage.css" />
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
        rel="stylesheet" />
</head>

<body>
    <!-- ── Navbar ── -->
    <header class="navbar">
        <div class="nav-inner">
            <div class="nav-brand">
                <a href="/admin/dashboard" class="logo" style="text-decoration: none; color: #1e293b !important; font-size: 1.25rem !important; font-weight: 800 !important; letter-spacing: normal !important; font-family: 'DM Sans', sans-serif !important;">EMS</a>
            </div>
            <nav class="nav-links">
                <a href="/admin/dashboard" class="nav-link">Events</a>
                <a href="/admin/venues" class="nav-link active">Venues</a>
                <a href="/admin/messages" class="nav-link">Messages</a>

                <div class="admin-notif-wrapper" style="position: relative; display: flex; align-items: center;">
                    <button class="icon-btn" id="notifBtn" aria-label="Notifications" title="Recent Bookings">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                        </svg>
                        <span class="notif-dot" id="notifDot" style="display: none;"></span>
                    </button>

                    <div class="notif-dropdown" id="notifDropdown" style="position: absolute; top: calc(100% + 12px); right: 0; width: 320px; padding: 0; overflow: hidden; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1); z-index: 1000; display: none;">
                        <p class="notif-title">RECENT BOOKINGS</p>
                        <div id="notifList">
                            <p class="notif-empty">Loading notifications...</p>
                        </div>
                    </div>
                </div>

                <div class="user-menu-container">
                    <button class="user-trigger" id="userTrigger" title="User Account">
                        <% if (locals.user && user.profileImage && user.profileImage !== 'https://tinyurl.com/3jjyxzj6') { %>
                            <img src="<%= user.profileImage %>" alt="User avatar" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" />
                        <% } else { %>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        <% } %>
                    </button>
                    <div class="user-dropdown" id="userDropdown">
                        <a href="/profile" class="dropdown-link">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path
                                    d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z">
                                </path>
                            </svg>
                            Profile
                        </a>
                        <a href="/logout" class="dropdown-link logout">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            Logout
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main class="page-main">
        <div class="page-header">
            <div class="header-content">
                <a href="/admin/venues"
                    style="color: var(--text-muted); text-decoration: none; font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    BACK TO VENUES
                </a>
                <h1 class="page-title">Bookings for <%= venue.name %>
                </h1>
                <p class="page-eyebrow">
                    <%= totalConfirmed %> Confirmed Bookings
                </p>
            </div>
            <div class="header-actions">
                <a href="/admin/venues/export-csv/<%= venue._id %>" class="btn-create">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    EXPORT CSV
                </a>
            </div>
        </div>

        <div class="table-container">
            <table class="events-table">
                <thead>
                    <tr>
                        <th style="width: 20%;">User</th>
                        <th style="width: 20%;">Date Range</th>
                        <th style="width: 15%;">Time Slot</th>
                        <th style="width: 12%;">Total</th>
                        <th style="width: 10%;">Payment</th>
                        <th style="width: 10%;">Status</th>
                        <th style="width: 13%;">Reference</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (confirmedBookings.length === 0 && cancelledBookings.length === 0 && pendingBookings.length === 0) { %>
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 48px; color: var(--text-muted);">
                                No bookings found for this venue.
                            </td>
                        </tr>
                    <% } else { %>
                        <% confirmedBookings.forEach(booking => { %>
                            <tr>
                                <td>
                                    <strong><%= booking.userId && booking.userId.username ? booking.userId.username : 'N/A' %></strong><br />
                                    <small style="color: var(--text-muted);"><%= booking.userId && booking.userId.email ? booking.userId.email : 'N/A' %></small>
                                </td>
                                <td><%= booking.startDate ? new Date(booking.startDate).toLocaleDateString() : 'N/A' %> - <%= booking.endDate ? new Date(booking.endDate).toLocaleDateString() : 'N/A' %></td>
                                <td><%= booking.startTime || 'N/A' %> - <%= booking.endTime || 'N/A' %></td>
                                <td><%= typeof booking.totalAmount === 'number' ? 'NPR. ' + booking.totalAmount.toFixed(2) : 'N/A' %></td>
                                <td><%= booking.paymentStatus || 'N/A' %></td>
                                <td><span class="status-pill status-confirmed">Confirmed</span></td>
                                <td><%= booking.referenceNumber || 'N/A' %></td>
                            </tr>
                        <% }) %>
                        <% pendingBookings.forEach(booking => { %>
                            <tr>
                                <td>
                                    <strong><%= booking.userId && booking.userId.username ? booking.userId.username : 'N/A' %></strong><br />
                                    <small style="color: var(--text-muted);"><%= booking.userId && booking.userId.email ? booking.userId.email : 'N/A' %></small>
                                </td>
                                <td><%= booking.startDate ? new Date(booking.startDate).toLocaleDateString() : 'N/A' %> - <%= booking.endDate ? new Date(booking.endDate).toLocaleDateString() : 'N/A' %></td>
                                <td><%= booking.startTime || 'N/A' %> - <%= booking.endTime || 'N/A' %></td>
                                <td><%= typeof booking.totalAmount === 'number' ? 'NPR. ' + booking.totalAmount.toFixed(2) : 'N/A' %></td>
                                <td><%= booking.paymentStatus || 'N/A' %></td>
                                <td><span class="status-pill status-pending">Pending</span></td>
                                <td><%= booking.referenceNumber || 'N/A' %></td>
                            </tr>
                        <% }) %>
                        <% cancelledBookings.forEach(booking => { %>
                            <tr>
                                <td>
                                    <strong><%= booking.userId && booking.userId.username ? booking.userId.username : 'N/A' %></strong><br />
                                    <small style="color: var(--text-muted);"><%= booking.userId && booking.userId.email ? booking.userId.email : 'N/A' %></small>
                                </td>
                                <td><%= booking.startDate ? new Date(booking.startDate).toLocaleDateString() : 'N/A' %> - <%= booking.endDate ? new Date(booking.endDate).toLocaleDateString() : 'N/A' %></td>
                                <td><%= booking.startTime || 'N/A' %> - <%= booking.endTime || 'N/A' %></td>
                                <td><%= typeof booking.totalAmount === 'number' ? 'NPR. ' + booking.totalAmount.toFixed(2) : 'N/A' %></td>
                                <td><%= booking.paymentStatus || 'N/A' %></td>
                                <td><span class="status-pill status-cancelled">Cancelled</span></td>
                                <td><%= booking.referenceNumber || 'N/A' %></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <!-- Unified Notifications System -->
    <script src="/js/admin-notif.js"></script>
</body>

</html>