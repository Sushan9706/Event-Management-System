<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Venue – EMS Admin</title>
    <link rel="stylesheet" href="/css/admin-create.css" />
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
        rel="stylesheet" />
</head>

<body>
    <!-- ── Navbar ── -->
    <header class="navbar">
        <div class="nav-inner">
            <div class="nav-brand">
                <a href="/admin/dashboard" class="logo" style="text-decoration: none; color: #1e293b !important; font-size: 1.25rem !important; font-weight: 800 !important; letter-spacing: normal !important; font-family: 'DM Sans', sans-serif !important;">EMS</a>
            </div>
            <nav class="nav-links">
                <a href="/admin/dashboard" class="nav-link">Events</a>
                <a href="/admin/venues" class="nav-link active">Venues</a>

                <button class="icon-btn" id="notifBtn" aria-label="Notifications" title="Recent Bookings">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                    </svg>
                    <span class="notif-dot" id="notifDot" style="display: none;"></span>
                </button>

                <div class="notif-dropdown" id="notifDropdown" style="right: 50px;">
                    <p class="notif-title">RECENT BOOKINGS</p>
                    <div id="notifList">
                        <p class="notif-empty">Loading notifications...</p>
                    </div>
                </div>

                <div class="user-menu-container">
                    <button class="user-trigger" id="userTrigger" title="User Account">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </button>
                    <div class="user-dropdown" id="userDropdown">
                        <a href="/profile" class="dropdown-link">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path
                                    d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1-2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z">
                                </path>
                            </svg>
                            Profile
                        </a>
                        <a href="/logout" class="dropdown-link logout">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            Logout
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main class="create-layout">
        <!-- ── Left Panel ── -->
        <aside class="left-panel">
            <div class="left-panel-content">
                <div class="sidebar-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                </div>
                <h1 class="left-heading">Listing a<br />New Venue.</h1>
                <p class="left-caption">Provide high-quality details about your space. Better descriptions and photos lead to more bookings.</p>

                <div class="quality-checklist">
                    <p class="checklist-title">Venue Standards</p>
                    <div class="checklist-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Clear, bright cover image</span>
                    </div>
                    <div class="checklist-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Accurate capacity limits</span>
                    </div>
                    <div class="checklist-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Competitive pricing rates</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- ── Right Panel (Form) ── -->
        <section class="right-panel">
            <div style="margin-bottom: 32px;">
                <a href="/admin/venues"
                    style="color: var(--text-muted); text-decoration: none; font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    BACK TO VENUES
                </a>
            </div>
            <% if (locals.error && error.length> 0) { %>
                <div class="flash-error"
                    style="background: #fee2e2; color: #ef4444; border: 1px solid #fecaca; padding: 12px; border-radius: 8px; margin-bottom: 24px;">
                    <%= error %>
                </div>
                <% } %>

                    <form action="/admin/venues/create" method="POST" enctype="multipart/form-data" class="event-form"
                        id="createVenueForm">

                        <div class="form-section">
                            <div class="form-section-head">
                                <h2 class="form-section-title">Venue Cover Image</h2>
                            </div>
                            <div class="upload-wrapper">
                                <div class="upload-area" id="uploadArea">
                                    <input type="file" id="venue_image" name="venue_image" accept="image/*" hidden />
                                    <div class="upload-placeholder" id="uploadPlaceholder">
                                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="1.5">
                                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                            <polyline points="21 15 16 10 5 21"></polyline>
                                        </svg>
                                        <p class="upload-text">Upload Venue Image</p>
                                        <p class="upload-hint">Drag and drop or click to upload</p>
                                    </div>
                                    <div class="upload-preview" id="uploadPreview" style="display:none;">
                                        <img id="previewImg" src="" alt="Preview" />
                                        <button type="button" class="remove-img" id="removePreview">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-section">
                            <div class="form-section-head">
                                <h2 class="form-section-title">Core Information</h2>
                            </div>

                            <div class="form-group">
                                <label for="name">Venue Name</label>
                                <input type="text" id="name" name="name"
                                    placeholder="e.g., Grand Ballroom A" required />
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="category">Category</label>
                                    <select id="category" name="category" required>
                                        <option value="" disabled selected>Select Category</option>
                                        <% categories.forEach(cat=> { %>
                                            <option value="<%= cat %>">
                                                <%= cat %>
                                            </option>
                                            <% }) %>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="capacity">Capacity (Persons)</label>
                                    <input type="number" id="capacity" name="capacity" placeholder="e.g., 200" required min="1" />
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="location">Location / Address</label>
                                <input type="text" id="location" name="location" placeholder="e.g., 123 Event St, City" required />
                            </div>

                            <div class="form-group">
                                <label for="description">Venue Description</label>
                                <textarea id="description" name="description" rows="6"
                                    placeholder="Describe the ambiance and facilities..." required></textarea>
                            </div>
                        </div>

                        <div class="form-section">
                            <h2 class="form-section-title">Pricing Rates</h2>
                            <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 16px;">At least one rate must be provided.</p>

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="hourlyRate">Hourly Rate (NPR)</label>
                                    <input type="number" id="hourlyRate" name="hourlyRate" placeholder="0.00" min="0" step="0.01" />
                                </div>
                                <div class="form-group">
                                    <label for="dailyRate">Daily Rate (NPR)</label>
                                    <input type="number" id="dailyRate" name="dailyRate" placeholder="0.00" min="0" step="0.01" />
                                </div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="button" class="btn-secondary"
                                onclick="window.location.href='/admin/venues'">CANCEL</button>
                            <button type="submit" class="btn-primary">CREATE VENUE</button>
                        </div>
                    </form>
        </section>
    </main>

    <script>
        // File upload handling
        const uploadArea = document.getElementById('uploadArea');
        const fileInput = document.getElementById('venue_image');
        const placeholder = document.getElementById('uploadPlaceholder');
        const preview = document.getElementById('uploadPreview');
        const previewImg = document.getElementById('previewImg');
        const removeBtn = document.getElementById('removePreview');

        uploadArea.addEventListener('click', () => fileInput.click());
        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.classList.add('dragover');
        });
        uploadArea.addEventListener('dragleave', () => {
            uploadArea.classList.remove('dragover');
        });
        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadArea.classList.remove('dragover');
            if (e.dataTransfer.files.length) {
                fileInput.files = e.dataTransfer.files;
                showPreview(e.dataTransfer.files[0]);
            }
        });

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length) showPreview(fileInput.files[0]);
        });

        function showPreview(file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                previewImg.src = e.target.result;
                placeholder.style.display = 'none';
                preview.style.display = 'block';
            };
            reader.readAsDataURL(file);
        }

        removeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            fileInput.value = '';
            previewImg.src = '';
            preview.style.display = 'none';
            placeholder.style.display = 'block';
        });

        // Form validation for rates
        document.getElementById('createVenueForm').addEventListener('submit', function(e) {
            const hourly = document.getElementById('hourlyRate').value;
            const daily = document.getElementById('dailyRate').value;
            
            if (!hourly && !daily) {
                e.preventDefault();
                alert('At least one rate (hourly or daily) must be provided.');
            }
        });

        // ─── Navbar Elements ───
        const userTrigger = document.getElementById('userTrigger');
        const userDropdown = document.getElementById('userDropdown');
        const notifBtn = document.getElementById('notifBtn');
        const notifDropdown = document.getElementById('notifDropdown');
        const notifList = document.getElementById('notifList');
        const notifDot = document.getElementById('notifDot');

        if (userTrigger) {
            userTrigger.addEventListener('click', (e) => {
                e.stopPropagation();
                userDropdown.classList.toggle('show');
                notifDropdown.classList.remove('show');
            });
            document.addEventListener('click', () => {
                userDropdown.classList.remove('show');
                notifDropdown.classList.remove('show');
            });
        }

        notifBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            notifDropdown.classList.toggle('show');
            userDropdown.classList.remove('show');
            if (notifDropdown.classList.contains('show')) {
                fetchNotifications();
            }
        });

        async function fetchNotifications() {
            try {
                const response = await fetch('/admin/notifications');
                const data = await response.json();
                renderNotifications(data);
            } catch (err) {
                console.error('Error fetching notifications:', err);
                if (notifList) notifList.innerHTML = '<p class="notif-empty">Failed to load</p>';
            }
        }

        function renderNotifications(notifications) {
            if (!notifications || notifications.length === 0) {
                if (notifList) notifList.innerHTML = '<p class="notif-empty">No new bookings</p>';
                if (notifDot) notifDot.style.display = 'none';
                return;
            }
            if (notifDot) notifDot.style.display = 'block';
            if (notifList) {
                notifList.innerHTML = notifications.map(n => {
                    const eventName = n.eventId ? (n.eventId.eventName || n.eventId.title) : 'Event';
                    const date = new Date(n.createdAt).toLocaleString('en-US', {
                        month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'
                    });
                    return `
                        <div class="notif-item">
                            <p class="notif-item-title">New Booking: ${n.userName}</p>
                            <p class="notif-item-sub">${eventName} · ${n.ticketCount} tickets</p>
                            <p class="notif-time">${date}</p>
                        </div>
                    `;
                }).join('');
            }
        }
    </script>
</body>

</html>
