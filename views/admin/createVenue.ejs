<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Venue – EMS Admin</title>
    <link rel="stylesheet" href="/css/admin-create.css" />
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
        rel="stylesheet" />
</head>

<body>
    <!-- ── Navbar ── -->
    <header class="navbar">
        <div class="nav-inner">
            <div class="nav-brand">
                <a href="/admin/dashboard" class="logo" style="text-decoration: none; color: #1e293b !important; font-size: 1.25rem !important; font-weight: 800 !important; letter-spacing: normal !important; font-family: 'DM Sans', sans-serif !important;">EMS</a>
            </div>
            <nav class="nav-links">
                <a href="/admin/dashboard" class="nav-link">Events</a>
                <a href="/admin/venues" class="nav-link active">Venues</a>
                <a href="/admin/messages" class="nav-link">Messages</a>
                <a href="/admin/users" class="nav-link">Users</a>

                <div class="admin-notif-wrapper" style="position: relative; display: flex; align-items: center;">
                    <button class="icon-btn" id="notifBtn" aria-label="Notifications" title="Recent Bookings">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                        </svg>
                        <span class="notif-dot" id="notifDot" style="display: none;"></span>
                    </button>

                    <div class="notif-dropdown" id="notifDropdown" style="position: absolute; top: calc(100% + 12px); right: 0; width: 320px; padding: 0; overflow: hidden; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1); z-index: 1000; display: none;">
                        <p class="notif-title">RECENT BOOKINGS</p>
                        <div id="notifList">
                            <p class="notif-empty">Loading notifications...</p>
                        </div>
                    </div>
                </div>
                              <div class="user-menu-container">
                    <button class="user-trigger" id="userTrigger" title="User Account">
                        <% if (locals.user && user.profileImage && user.profileImage !== 'https://tinyurl.com/3jjyxzj6') { %>
                            <img src="<%= user.profileImage %>" alt="User avatar" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" />
                        <% } else { %>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        <% } %>
                    </button>
                    <div class="user-dropdown" id="userDropdown">
                        <a href="/profile" class="dropdown-link">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path
                                    d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z">
                                </path>
                            </svg>
                            Profile
                        </a>
                        <a href="/logout" class="dropdown-link logout">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            Logout
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main class="create-layout">
        <!-- ── Left Panel ── -->
        <aside class="left-panel">
            <div class="left-panel-content">
                <div class="sidebar-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                </div>
                <h1 class="left-heading">Listing a<br />New Venue.</h1>
                <p class="left-caption">Provide high-quality details about your space. Better descriptions and photos
                    lead to more bookings.</p>

                <div class="quality-checklist">
                    <p class="checklist-title">Venue Standards</p>
                    <div class="checklist-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="3">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Clear, bright cover image</span>
                    </div>
                    <div class="checklist-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="3">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Accurate capacity limits</span>
                    </div>
                    <div class="checklist-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="3">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Competitive pricing rates</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- ── Right Panel (Form) ── -->
        <section class="right-panel">
            <div style="margin-bottom: 32px;">
                <a href="/admin/venues"
                    style="color: var(--text-muted); text-decoration: none; font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    BACK TO VENUES
                </a>
            </div>
            <% if (locals.error && error.length> 0) { %>
                <div class="flash-error"
                    style="background: #fee2e2; color: #ef4444; border: 1px solid #fecaca; padding: 12px; border-radius: 8px; margin-bottom: 24px;">
                    <%= error %>
                </div>
                <% } %>

                    <form action="/admin/venues/create" method="POST" enctype="multipart/form-data" class="event-form"
                        id="createVenueForm">

                        <div class="form-section">
                            <div class="form-section-head">
                                <h2 class="form-section-title">Venue Cover Image</h2>
                            </div>
                            <div class="upload-wrapper">
                                <div class="upload-area" id="uploadArea">
                                    <input type="file" id="venue_image" name="venue_image" accept="image/*" hidden />
                                    <div class="upload-placeholder" id="uploadPlaceholder">
                                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="1.5">
                                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                            <polyline points="21 15 16 10 5 21"></polyline>
                                        </svg>
                                        <p class="upload-text">Upload Venue Image</p>
                                        <p class="upload-hint">Drag and drop or click to upload</p>
                                    </div>
                                    <div class="upload-preview" id="uploadPreview" style="display:none;">
                                        <img id="previewImg" src="" alt="Preview" />
                                        <button type="button" class="remove-img" id="removePreview">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-section">
                            <div class="form-section-head">
                                <h2 class="form-section-title">Core Information</h2>
                            </div>

                            <div class="form-group">
                                <label for="name">Venue Name</label>
                                <input type="text" id="name" name="name" placeholder="e.g., Grand Ballroom A"
                                    value="<%= locals.formData ? formData.name : '' %>" required />
                                <div class="error-msg" id="name-error"></div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="category">Category</label>
                                    <select id="category" name="category" required>
                                        <option value="" disabled <%= !locals.formData ? 'selected' : '' %>>Select Category</option>
                                        <% categories.forEach(cat=> { %>
                                            <option value="<%= cat %>" <%= locals.formData && formData.category === cat ? 'selected' : '' %>>
                                                <%= cat %>
                                            </option>
                                            <% }) %>
                                    </select>
                                    <div class="error-msg" id="category-error"></div>
                                </div>
                                <div class="form-group">
                                    <label for="capacity">Capacity (Persons)</label>
                                    <input type="number" id="capacity" name="capacity" placeholder="e.g., 200" required
                                        min="1" max="50000" value="<%= locals.formData ? formData.capacity : '' %>" />
                                    <div class="error-msg" id="capacity-error"></div>
                                </div>
                                <div class="form-group">
                                    <label for="status">Status</label>
                                    <select id="status" name="status" required>
                                        <option value="available" <%= locals.formData && formData.status === 'available' ? 'selected' : '' %>>Available</option>
                                        <option value="maintenance" <%= locals.formData && formData.status === 'maintenance' ? 'selected' : '' %>>Maintenance</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="location">Location / Address</label>
                                <input type="text" id="location" name="location" placeholder="e.g., 123 Event St, City"
                                    value="<%= locals.formData ? formData.location : '' %>" required />
                                <div class="error-msg" id="location-error"></div>
                            </div>

                            <div class="form-group">
                                <label for="description">Venue Description</label>
                                <textarea id="description" name="description" rows="6"
                                    placeholder="Describe the ambiance and facilities..." required><%= locals.formData ? formData.description : '' %></textarea>
                                <div class="error-msg" id="description-error"></div>
                            </div>
                        </div>

                        <div class="form-section">
                            <h2 class="form-section-title">Pricing Rates</h2>
                            <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 16px;">At least one rate
                                must be provided.</p>

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="hourlyRate">Hourly Rate (NPR)</label>
                                    <input type="number" id="hourlyRate" name="hourlyRate" placeholder="0.00" min="0" max="100000"
                                        step="0.01" value="<%= locals.formData ? formData.hourlyRate : '' %>" />
                                    <div class="error-msg" id="hourlyRate-error"></div>
                                </div>
                                <div class="form-group">
                                    <label for="dailyRate">Daily Rate (NPR)</label>
                                    <input type="number" id="dailyRate" name="dailyRate" placeholder="0.00" min="0" max="2000000"
                                        step="0.01" value="<%= locals.formData ? formData.dailyRate : '' %>" />
                                    <div class="error-msg" id="dailyRate-error"></div>
                                </div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="button" class="btn-secondary"
                                onclick="window.location.href='/admin/venues'">CANCEL</button>
                            <button type="submit" class="btn-primary">CREATE VENUE</button>
                        </div>
                    </form>
        </section>
    </main>

    <script>
        // File upload handling
        const uploadArea = document.getElementById('uploadArea');
        const fileInput = document.getElementById('venue_image');
        const placeholder = document.getElementById('uploadPlaceholder');
        const preview = document.getElementById('uploadPreview');
        const previewImg = document.getElementById('previewImg');
        const removeBtn = document.getElementById('removePreview');

        uploadArea.addEventListener('click', () => fileInput.click());
        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.classList.add('dragover');
        });
        uploadArea.addEventListener('dragleave', () => {
            uploadArea.classList.remove('dragover');
        });
        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadArea.classList.remove('dragover');
            if (e.dataTransfer.files.length) {
                fileInput.files = e.dataTransfer.files;
                showPreview(e.dataTransfer.files[0]);
            }
        });

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length) showPreview(fileInput.files[0]);
        });

        function showPreview(file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                previewImg.src = e.target.result;
                placeholder.style.display = 'none';
                preview.style.display = 'block';
            };
            reader.readAsDataURL(file);
        }

        removeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            fileInput.value = '';
            previewImg.src = '';
            preview.style.display = 'none';
            placeholder.style.display = 'block';
        });

        // Form validation
        const nameInput = document.getElementById('name');
        const categoryInput = document.getElementById('category');
        const capacityInput = document.getElementById('capacity');
        const locationInput = document.getElementById('location');
        const descriptionInput = document.getElementById('description');
        const hourlyRateInput = document.getElementById('hourlyRate');
        const dailyRateInput = document.getElementById('dailyRate');

        const nameError = document.getElementById('name-error');
        const categoryError = document.getElementById('category-error');
        const capacityError = document.getElementById('capacity-error');
        const locationError = document.getElementById('location-error');
        const descriptionError = document.getElementById('description-error');
        const hourlyRateError = document.getElementById('hourlyRate-error');
        const dailyRateError = document.getElementById('dailyRate-error');

        function showError(element, errorElement, message) {
            element.closest('.form-group').classList.add('has-error');
            errorElement.textContent = message;
            errorElement.style.display = 'block';
        }

        function clearError(element, errorElement) {
            element.closest('.form-group').classList.remove('has-error');
            errorElement.textContent = '';
            errorElement.style.display = 'none';
        }

        const touchedFields = new Set();

        function validateField(input, errorElement, checkFn, isSubmit) {
            if (!isSubmit && !touchedFields.has(input.id)) return true;
            const message = checkFn();
            if (message) {
                showError(input, errorElement, message);
                return false;
            } else {
                clearError(input, errorElement);
                return true;
            }
        }

        function validateName(isSubmit = false) {
            return validateField(nameInput, nameError, () => {
                if (!nameInput.value.trim()) return 'Venue Name is required.';
                return null;
            }, isSubmit);
        }

        function validateCategory(isSubmit = false) {
            return validateField(categoryInput, categoryError, () => {
                if (!categoryInput.value) return 'Please select a venue category.';
                return null;
            }, isSubmit);
        }

        function validateCapacity(isSubmit = false) {
            return validateField(capacityInput, capacityError, () => {
                if (!isSubmit && capacityInput.value === '') {
                    return null;
                }
                const cap = parseInt(capacityInput.value);
                if (isNaN(cap) || cap < 1 || cap > 50000) {
                    return 'Venue capacity must be between 1 and 50,000 persons.';
                }
                return null;
            }, isSubmit);
        }

        function validateLocation(isSubmit = false) {
            return validateField(locationInput, locationError, () => {
                if (!locationInput.value.trim()) return 'Venue location/address is required.';
                return null;
            }, isSubmit);
        }

        function validateDescription(isSubmit = false) {
            return validateField(descriptionInput, descriptionError, () => {
                if (!descriptionInput.value.trim()) return 'Venue description is required.';
                return null;
            }, isSubmit);
        }

        function validateHourlyRate(isSubmit = false) {
            return validateField(hourlyRateInput, hourlyRateError, () => {
                if (!isSubmit && hourlyRateInput.value === '') {
                    return null;
                }
                const hourly = parseFloat(hourlyRateInput.value);
                if (hourlyRateInput.value && (isNaN(hourly) || hourly <= 0 || hourly > 50000)) {
                    return 'Hourly rate must be between NPR 1 and NPR 50,000.';
                }
                if (!hourlyRateInput.value && !dailyRateInput.value) {
                    return 'At least one rate (hourly or daily) must be provided.';
                }
                return null;
            }, isSubmit);
        }

        function validateDailyRate(isSubmit = false) {
            return validateField(dailyRateInput, dailyRateError, () => {
                if (!isSubmit && dailyRateInput.value === '') {
                    return null;
                }
                const daily = parseFloat(dailyRateInput.value);
                if (dailyRateInput.value && (isNaN(daily) || daily <= 0 || daily > 500000)) {
                    return 'Daily rate must be between NPR 1 and NPR 500,000.';
                }
                if (!hourlyRateInput.value && !dailyRateInput.value) {
                    return 'At least one rate (hourly or daily) must be provided.';
                }
                return null;
            }, isSubmit);
        }

        const allInputs = [
            { input: nameInput, validate: validateName },
            { input: categoryInput, validate: validateCategory },
            { input: capacityInput, validate: validateCapacity },
            { input: locationInput, validate: validateLocation },
            { input: descriptionInput, validate: validateDescription },
            { input: hourlyRateInput, validate: validateHourlyRate },
            { input: dailyRateInput, validate: validateDailyRate }
        ];

        allInputs.forEach(({ input, validate }) => {
            const eventType = input.tagName === 'SELECT' ? 'change' : 'input';
            input.addEventListener(eventType, () => {
                touchedFields.add(input.id);
                validate(false);
                if (input.id === 'hourlyRate') {
                    if (hourlyRateInput.value === '' || dailyRateInput.value) {
                        clearError(dailyRateInput, dailyRateError);
                    }
                }
                if (input.id === 'dailyRate') {
                    if (dailyRateInput.value === '' || hourlyRateInput.value) {
                        clearError(hourlyRateInput, hourlyRateError);
                    }
                }
            });
        });

        function validateAll() {
            let isValid = true;
            allInputs.forEach(({ validate }) => {
                const res = validate(true);
                if (!res) isValid = false;
            });
            return isValid;
        }

        document.getElementById('createVenueForm').addEventListener('submit', function (e) {
            if (!validateAll()) {
                e.preventDefault();
                const firstError = document.querySelector('.has-error');
                if (firstError) {
                    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        });

    </script>

    <!-- Unified Notifications System -->
    <script src="/js/admin-notif.js"></script>
    <script src="/js/user.js"></script>
</body>
</html>