<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manage Venues – EMS Admin</title>
    <!-- CSS Dependencies -->
    <link rel="stylesheet" href="/css/admin-manage.css" />
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
        rel="stylesheet" />
    <style>
        .icon-venues { background: rgba(16, 185, 129, 0.1); color: #10b981; }
        .icon-available { background: rgba(59, 130, 246, 0.1); color: #3b82f6; }
        .icon-maintenance { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }
        .status-available { background: #dcfce7; color: #15803d; }
        .status-maintenance { background: #fef3c7; color: #92400e; }
    </style>
</head>

<body>
    <!-- ── Navbar ── -->
    <header class="navbar">
        <div class="nav-inner">
            <div class="nav-brand">
                <a href="/admin/dashboard" class="logo" style="text-decoration: none; color: #1e293b !important; font-size: 1.25rem !important; font-weight: 800 !important; letter-spacing: normal !important; font-family: 'DM Sans', sans-serif !important;">EMS</a>
            </div>
            <nav class="nav-links">
                <a href="/admin/dashboard" class="nav-link">Events</a>
                <a href="/admin/venues" class="nav-link active">Venues</a>
                
                <button class="icon-btn" id="notifBtn" aria-label="Notifications" title="Recent Bookings">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                    </svg>
                    <span class="notif-dot" id="notifDot" style="display: none;"></span>
                </button>

                <div class="notif-dropdown" id="notifDropdown">
                    <p class="notif-title">RECENT BOOKINGS</p>
                    <div id="notifList">
                        <p class="notif-empty">Loading notifications...</p>
                    </div>
                </div>

                <div class="user-menu-container">
                    <button class="user-trigger" id="userTrigger" title="User Account">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </button>
                    <div class="user-dropdown" id="userDropdown">
                        <a href="/profile" class="dropdown-link">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path
                                    d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z">
                                </path>
                            </svg>
                            Profile
                        </a>
                        <a href="/logout" class="dropdown-link logout">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            Logout
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main class="page-main">
        <!-- ── Page Header ── -->
        <div class="page-header">
            <div class="header-content">
                <p class="page-eyebrow">Administration</p>
                <h1 class="page-title">Manage Venues</h1>
            </div>
            <a href="/admin/venues/create" class="btn-create">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Create Venue
            </a>
        </div>

        <!-- ── Flash Messages ── -->
        <% if (locals.success && success.length> 0) { %>
            <div class="flash-msg flash-success">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <%= success %>
            </div>
            <% } %>
                <% if (locals.error && error.length> 0) { %>
                    <div class="flash-msg flash-error">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <%= error %>
                    </div>
                    <% } %>

                        <!-- ── Stats Grid ── -->
                        <div class="stats-grid">
                            <div class="stat-card">
                                <div class="stat-icon icon-venues">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                    </svg>
                                </div>
                                <p class="stat-label">Total Venues</p>
                                <p class="stat-value">
                                    <%= stats.totalVenues %>
                                </p>
                            </div>
                            <div class="stat-card">
                                <div class="stat-icon icon-available">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                    </svg>
                                </div>
                                <p class="stat-label">Available</p>
                                <p class="stat-value">
                                    <%= stats.availableVenues %>
                                </p>
                            </div>
                            <div class="stat-card">
                                <div class="stat-icon icon-maintenance">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                                    </svg>
                                </div>
                                <p class="stat-label">Maintenance</p>
                                <p class="stat-value">
                                    <%= stats.maintenanceVenues %>
                                </p>
                            </div>
                        </div>

                        <!-- ── Table Section ── -->
                        <div class="table-container">
                            <div class="table-controls">
                                <div class="search-box">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <circle cx="11" cy="11" r="8"></circle>
                                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                    </svg>
                                    <input type="text" id="searchInput"
                                        placeholder="Search venues by name, location or category..." />
                                </div>
                                <div class="filter-group">
                                    <select class="select-plain" id="categoryFilter">
                                        <option value="all">All Categories</option>
                                        <option value="Conference Room">Conference Room</option>
                                        <option value="Ballroom">Ballroom</option>
                                        <option value="Outdoor Space">Outdoor Space</option>
                                        <option value="Auditorium">Auditorium</option>
                                        <option value="Exhibition Hall">Exhibition Hall</option>
                                        <option value="Meeting Room">Meeting Room</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                            </div>

                            <div id="venuesTableBody">
                                <table class="events-table">
                                    <thead>
                                        <tr>
                                            <th>Venue Details</th>
                                            <th>Capacity & Rate</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (venues.length===0) { %>
                                            <tr>
                                                <td colspan="4"
                                                    style="text-align: center; padding: 48px; color: var(--text-muted);">
                                                    No venues found.
                                                </td>
                                            </tr>
                                            <% } else { %>
                                                <% venues.forEach(venue=> { %>
                                                    <tr>
                                                        <td>
                                                            <div class="event-cell">
                                                                <img src="<%= venue.imagePath || '/images/default-venue.png' %>"
                                                                    alt="<%= venue.name %>"
                                                                    class="event-img" />
                                                                <div class="event-info-cell">
                                                                    <p class="event-name">
                                                                        <%= venue.name %>
                                                                    </p>
                                                                    <p class="event-location">
                                                                        <%= venue.location %>
                                                                    </p>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <p style="font-weight: 500;">
                                                                Capacity: <%= venue.capacity %>
                                                            </p>
                                                            <p style="font-size: 12px; color: var(--text-light);">
                                                                <%= venue.hourlyRate ? 'NPR. ' + venue.hourlyRate + '/hr' : '' %> 
                                                                <%= venue.hourlyRate && venue.dailyRate ? ' | ' : '' %>
                                                                <%= venue.dailyRate ? 'NPR. ' + venue.dailyRate + '/day' : '' %>
                                                            </p>
                                                        </td>
                                                        <td>
                                                            <span
                                                                class="status-pill status-<%= venue.status %>">
                                                                <%= venue.status %>
                                                            </span>
                                                        </td>
                                                        <td class="actions-cell">
                                                            <a href="/admin/venues/<%= venue._id %>/bookings"
                                                                class="btn-view">BOOKINGS</a>
                                                            <a href="/admin/venues/edit/<%= venue._id %>"
                                                                class="btn-icon" title="Edit">
                                                                <svg width="16" height="16" viewBox="0 0 24 24"
                                                                    fill="none" stroke="currentColor" stroke-width="2">
                                                                    <path
                                                                        d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7">
                                                                    </path>
                                                                    <path
                                                                        d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z">
                                                                    </path>
                                                                </svg>
                                                            </a>
                                                            <button type="button" class="btn-icon delete delete-trigger"
                                                                title="Delete" data-id="<%= venue._id %>"
                                                                data-name="<%= venue.name %>">
                                                                <svg width="16" height="16" viewBox="0 0 24 24"
                                                                    fill="none" stroke="currentColor" stroke-width="2">
                                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                                    <path
                                                                        d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                                    </path>
                                                                </svg>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                                        <% } %>
                                    </tbody>
                                </table>

                                <!-- Pagination -->
                                <div class="pagination">
                                    <a href="?page=<%= pagination.currentPage - 1 %>"
                                        class="pg-btn <%= pagination.currentPage <= 1 ? 'disabled' : '' %>">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <polyline points="15 18 9 12 15 6"></polyline>
                                        </svg>
                                    </a>
                                    <% for(let i=1; i <=pagination.totalPages; i++) { %>
                                        <a href="?page=<%= i %>"
                                            class="pg-btn <%= i === pagination.currentPage ? 'active' : '' %>">
                                            <%= i %>
                                        </a>
                                        <% } %>
                                            <a href="?page=<%= pagination.currentPage + 1 %>"
                                                class="pg-btn <%= pagination.currentPage >= pagination.totalPages ? 'disabled' : '' %>">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2">
                                                    <polyline points="9 18 15 12 9 6"></polyline>
                                                </svg>
                                            </a>
                                </div>
                            </div>
                        </div>
    </main>

    <script>
        // ─── Navbar Elements ───
        const userTrigger = document.getElementById('userTrigger');
        const userDropdown = document.getElementById('userDropdown');
        const notifBtn = document.getElementById('notifBtn');
        const notifDropdown = document.getElementById('notifDropdown');
        const notifList = document.getElementById('notifList');
        const notifDot = document.getElementById('notifDot');

        // ─── Dropdown Toggles ───
        if (userTrigger) {
            userTrigger.addEventListener('click', (e) => {
                e.stopPropagation();
                userDropdown.classList.toggle('show');
                notifDropdown.classList.remove('show');
            });
        }

        if (notifBtn) {
            notifBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                notifDropdown.classList.toggle('show');
                userDropdown.classList.remove('show');
                if (notifDropdown.classList.contains('show')) {
                    fetchNotifications();
                }
            });
        }

        document.addEventListener('click', () => {
            if (userDropdown) userDropdown.classList.remove('show');
            if (notifDropdown) notifDropdown.classList.remove('show');
        });

        // ─── Notifications Fetch ───
        async function fetchNotifications() {
            try {
                const response = await fetch('/admin/notifications');
                const data = await response.json();
                renderNotifications(data);
            } catch (err) {
                console.error('Error fetching notifications:', err);
                if (notifList) notifList.innerHTML = '<p class="notif-empty">Failed to load</p>';
            }
        }

        function renderNotifications(notifications) {
            if (!notifications || notifications.length === 0) {
                if (notifList) notifList.innerHTML = '<p class="notif-empty">No new bookings</p>';
                if (notifDot) notifDot.style.display = 'none';
                return;
            }

            if (notifDot) notifDot.style.display = 'block';

            if (notifList) {
                notifList.innerHTML = notifications.map(n => {
                    const date = new Date(n.createdAt).toLocaleString('en-US', { 
                        month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' 
                    });
                    return `
                        <div class="notif-item">
                            <p class="notif-item-title">${n.userName} booked a ${n.type}</p>
                            <p class="notif-item-sub">${n.name} · ${n.countLabel}</p>
                            <p class="notif-time">${date}</p>
                        </div>
                    `;
                }).join('');
            }
        }

        fetchNotifications();

        // ─── Real-time Search & Filter (AJAX) ───
        const searchInput = document.getElementById('searchInput');
        const categoryFilter = document.getElementById('categoryFilter');
        let searchTimeout;

        const updateVenues = async () => {
            const search = searchInput.value;
            const category = categoryFilter.value;
            const url = `/admin/venues?search=${search}&category=${category}`;

            try {
                const response = await fetch(url, { headers: { 'Accept': 'application/json' } });
                const data = await response.json();
                renderTable(data.venues, data.pagination);
            } catch (err) {
                console.error('Fetch error:', err);
            }
        };

        if (searchInput) {
            searchInput.addEventListener('input', () => {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(updateVenues, 300);
            });
        }

        if (categoryFilter) {
            categoryFilter.addEventListener('change', updateVenues);
        }

        const renderTable = (venues, pagination) => {
            const tbody = document.querySelector('.events-table tbody');
            const paginationDiv = document.querySelector('.pagination');

            if (venues.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align: center; padding: 48px; color: var(--text-muted);">No venues found.</td></tr>';
                paginationDiv.innerHTML = '';
                return;
            }

            tbody.innerHTML = venues.map(venue => `
                <tr>
                    <td>
                        <div class="event-cell">
                            <img src="${venue.imagePath || '/images/default-venue.png'}" alt="${venue.name}" class="event-img" />
                            <div class="event-info-cell">
                                <p class="event-name">${venue.name}</p>
                                <p class="event-location">${venue.location}</p>
                            </div>
                        </div>
                    </td>
                    <td>
                        <p style="font-weight: 500;">Capacity: ${venue.capacity}</p>
                        <p style="font-size: 12px; color: var(--text-light);">
                            ${venue.hourlyRate ? 'NPR. ' + venue.hourlyRate + '/hr' : ''} 
                            ${venue.hourlyRate && venue.dailyRate ? ' | ' : ''}
                            ${venue.dailyRate ? 'NPR. ' + venue.dailyRate + '/day' : ''}
                        </p>
                    </td>
                    <td>
                        <span class="status-pill status-${venue.status}">${venue.status}</span>
                    </td>
                    <td class="actions-cell">
                        <a href="/admin/venues/${venue._id}/bookings" class="btn-view">BOOKINGS</a>
                        <a href="/admin/venues/edit/${venue._id}" class="btn-icon" title="Edit">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                            </svg>
                        </a>
                        <button type="button" class="btn-icon delete delete-trigger" title="Delete" data-id="${venue._id}" data-name="${venue.name}">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                        </button>
                    </td>
                </tr>
            `).join('');

            // Simple pagination render
            let pgHtml = `
                <a href="?page=${pagination.currentPage - 1}" class="pg-btn ${pagination.currentPage <= 1 ? 'disabled' : ''}" onclick="event.preventDefault(); goToPage(${pagination.currentPage - 1})">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </a>
            `;
            for (let i = 1; i <= pagination.totalPages; i++) {
                pgHtml += `<a href="?page=${i}" class="pg-btn ${i === pagination.currentPage ? 'active' : ''}" onclick="event.preventDefault(); goToPage(${i})">${i}</a>`;
            }
            pgHtml += `
                <a href="?page=${pagination.currentPage + 1}" class="pg-btn ${pagination.currentPage >= pagination.totalPages ? 'disabled' : ''}" onclick="event.preventDefault(); goToPage(${pagination.currentPage + 1})">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
            `;
            paginationDiv.innerHTML = pgHtml;
        };

        window.goToPage = async (page) => {
            const search = searchInput.value;
            const category = categoryFilter.value;
            const url = `/admin/venues?page=${page}&search=${search}&category=${category}`;

            try {
                const response = await fetch(url, { headers: { 'Accept': 'application/json' } });
                const data = await response.json();
                renderTable(data.venues, data.pagination);
            } catch (err) {
                console.error('Fetch error:', err);
            }
        };

        // ─── Delete Modal Logic ───
        const showDeleteModal = (venueId, venueName) => {
            const deleteModal = document.getElementById('deleteModal');
            const deleteForm = document.getElementById('deleteForm');
            const venueNameSpan = document.getElementById('deleteVenueName');

            if (venueNameSpan) venueNameSpan.textContent = venueName;
            if (deleteForm) deleteForm.action = `/admin/venues/delete/${venueId}`;
            if (deleteModal) deleteModal.classList.add('show');
        };

        window.closeDeleteModal = () => {
            const deleteModal = document.getElementById('deleteModal');
            if (deleteModal) deleteModal.classList.remove('show');
        };

        // Event delegation for delete buttons
        document.addEventListener('click', (e) => {
            const btn = e.target.closest('.delete-trigger');
            if (btn) {
                e.preventDefault();
                e.stopPropagation();
                const id = btn.getAttribute('data-id');
                const name = btn.getAttribute('data-name');
                showDeleteModal(id, name);
            }
        });

        // Close modal on escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeDeleteModal();
        });

        // Auto-dismiss flash messages
        document.querySelectorAll('.flash-msg').forEach(msg => {
            setTimeout(() => {
                msg.classList.add('fade-out');
                setTimeout(() => {
                    msg.remove();
                }, 400); // Wait for animation to finish
            }, 2000); // 2 seconds delay
        });
    </script>

    <!-- ── Deletion Modal HTML ── -->
    <div class="modal-overlay" id="deleteModal" onclick="if(event.target === this) closeDeleteModal()">
        <div class="modal-card">
            <div class="modal-warning-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M3 6h18"></path>
                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                    <line x1="10" y1="11" x2="10" y2="17"></line>
                    <line x1="14" y1="11" x2="14" y2="17"></line>
                </svg>
            </div>
            <h2 class="modal-title">Delete Venue?</h2>
            <p class="modal-text">
                Are you sure you want to permanently remove
                <span id="deleteVenueName" class="modal-event-name">Venue Name</span>
                All upcoming events at this venue will be cancelled. This action cannot be undone.
            </p>
            <div class="modal-actions">
                <button type="button" class="modal-btn btn-cancel" onclick="closeDeleteModal()">CANCEL</button>
                <form id="deleteForm" method="POST" style="flex: 1;">
                    <button type="submit" class="modal-btn btn-confirm-delete">CONFIRM DELETE</button>
                </form>
            </div>
        </div>
    </div>
</body>

</html>
