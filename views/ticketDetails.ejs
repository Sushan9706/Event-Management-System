<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ticket Details</title>
    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background: #f6f2ef;
        color: #1d1d27;
        font-family: 'DM Sans', sans-serif;
      }

      .page {
        width: min(100%, 760px);
        margin: 0 auto;
        padding: 24px 16px;
      }

      .ticket {
        background: #fff;
        border: 1px solid #e8ddd7;
        border-radius: 14px;
        padding: 22px;
        box-shadow: 0 18px 48px rgba(21, 20, 26, 0.08);
      }

      .eyebrow {
        color: #6f6f78;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.2em;
        margin: 0 0 10px;
        text-transform: uppercase;
      }

      h1 {
        font-size: 28px;
        line-height: 1.1;
        margin: 0 0 6px;
      }

      .status {
        display: inline-flex;
        margin: 10px 0 18px;
        padding: 7px 10px;
        border-radius: 999px;
        background: #eef7ef;
        color: #23803a;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
      }

      .grid {
        display: grid;
        gap: 12px;
      }

      .row {
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: 14px;
        padding: 12px 0;
        border-top: 1px solid #efe7e2;
      }

      .label {
        color: #74727b;
        font-size: 13px;
      }

      .value {
        font-size: 16px;
        font-weight: 700;
        word-break: break-word;
      }

      .actions {
        display: flex;
        gap: 10px;
        margin-top: 18px;
      }

      button {
        border: 0;
        border-radius: 10px;
        padding: 12px 16px;
        background: #17172a;
        color: #fff;
        font-weight: 700;
      }

      @media (max-width: 520px) {
        .page {
          padding: 14px;
        }

        .ticket {
          padding: 18px;
        }

        h1 {
          font-size: 24px;
        }

        .row {
          grid-template-columns: 1fr;
          gap: 4px;
        }
      }

      @media print {
        @page {
          size: A4;
          margin: 18mm;
        }

        body {
          background: #fff;
        }

        .page {
          width: 100%;
          padding: 0;
        }

        .ticket {
          box-shadow: none;
        }

        .actions {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <article class="ticket">
        <p class="eyebrow">EMS Ticket Details</p>
        <h1><%= ticket.eventName %></h1>
        <span class="status"><%= ticket.status %> · Ticket <%= ticket.ticketPosition %></span>

        <section class="grid">
          <div class="row">
            <span class="label">Ticket ID</span>
            <span class="value"><%= ticket.code %></span>
          </div>
          <div class="row">
            <span class="label">Attendee</span>
            <span class="value"><%= ticket.attendeeName %></span>
          </div>
          <div class="row">
            <span class="label">Email</span>
            <span class="value"><%= ticket.attendeeEmail %></span>
          </div>
          <div class="row">
            <span class="label">Date</span>
            <span class="value"><%= ticket.date %></span>
          </div>
          <div class="row">
            <span class="label">Time</span>
            <span class="value"><%= ticket.time %></span>
          </div>
          <div class="row">
            <span class="label">Location</span>
            <span class="value"><%= ticket.location %></span>
          </div>
          <div class="row">
            <span class="label">Price</span>
            <span class="value"><%= ticket.price %></span>
          </div>
          <div class="row">
            <span class="label">Reference</span>
            <span class="value"><%= ticket.reference %></span>
          </div>
          <div class="row">
            <span class="label">Booked On</span>
            <span class="value"><%= ticket.bookedOn %></span>
          </div>
        </section>

        <div class="actions">
          <button type="button" onclick="window.print()">Print / Save PDF</button>
        </div>
      </article>
    </main>
  </body>
</html>
