<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - EMS</title>
    <link rel="stylesheet" href="/css/login.css"> </head>
<body>

    <header class="navbar">
        <div class="logo">EMS</div>
        <nav>
            <a href="/">Events</a>
            <a href="#" class="btn-get-started">Get Started</a>
        </nav>
    </header>

    <main class="login-container">
        <section class="welcome-text">
            <h1>Welcome back.</h1>
            <p>Access your 2026 event management dashboard.</p>
        </section>

        <div class="login-card">
            <% if (error && error.length > 0) { %>
    <div class="error-flash">
        <%= error %>
    </div>
<% } %>
            <form action="/login" method="POST">
                <div class="input-group">
                    <label for="username">USERNAME OR EMAIL</label>
                    <input type="text" id="username" name="username" placeholder="name@event.com" required>
                </div>

                <div class="input-group">
                    <div class="label-row">
                        <label for="password">PASSWORD</label>
                        <a href="#" class="forgot-link">FORGOT PASSWORD?</a>
                    </div>
                    <input type="password" id="password" name="password" placeholder="••••••••" required>
                </div>

                <button type="submit" class="login-btn">Login to Dashboard</button>
            </form>

            <p class="register-text">
                Don't have an account? <a href="/register">Register for EMS</a>
            </p>
        </div>
    </main>

    <footer class="footer">
        <div class="footer-left">
            COPYRIGHT © 2026 EMS. ALL RIGHTS RESERVED.
        </div>
        <div class="footer-right">
            <a href="#">TERMS</a>
            <a href="#">PRIVACY</a>
        </div>
    </footer>

</body>
</html>