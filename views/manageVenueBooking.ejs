<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EMS - Manage Venue Booking</title>
    <link rel="stylesheet" href="/css/manageBooking.css" />
    <link rel="stylesheet" href="/css/common-nav.css?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <%
      const venueName = venue && venue.name ? venue.name : 'Venue';
      const venueLocation = venue && venue.location ? venue.location : 'TBA';
      const venueImage = (venue && (venue.imagePath || venue.image))
        ? (venue.imagePath || venue.image)
        : 'https://images.unsplash.com/photo-1519167758481-83f550bb49b3?q=80&w=1200&auto=format&fit=crop';
      const formatDate = (value) => value
        ? new Date(value).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })
        : 'TBA';
      const startDateLabel = formatDate(booking.startDate);
      const endDateLabel = formatDate(booking.endDate);
      const bookingDate = startDateLabel === endDateLabel ? startDateLabel : `${startDateLabel} - ${endDateLabel}`;
      const bookingTime = `${booking.startTime || 'TBA'} - ${booking.endTime || 'TBA'}`;
      const totalAmount = typeof booking.totalAmount === 'number' ? booking.totalAmount : 0;
      const totalDisplay = totalAmount === 0 ? 'Free' : `NPR. ${totalAmount.toFixed(2)}`;
      const normalizedStatus = (booking.status || 'confirmed').toLowerCase();
      const bookingStatus = normalizedStatus.toUpperCase();
      const isCancelled = normalizedStatus === 'cancelled';
      const isInactive = isCancelled || !!forceViewOnly;
      const backLabel = isCancelled ? '← Back to Cancelled Bookings' : '← Back to My Bookings';
      const backHref = isCancelled ? '/bookings?status=cancelled' : '/bookings?status=confirmed';
      const bookedOnLabel = booking.createdAt
        ? new Date(booking.createdAt).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })
        : 'TBA';
      const phoneNumber = booking.phoneNumber || '-';
      const isDaily = venue && venue.dailyRate;
      const durationMs = booking.startDate && booking.endDate
        ? Math.abs(new Date(booking.endDate) - new Date(booking.startDate))
        : 0;
      const dayCount = Math.ceil(durationMs / (1000 * 60 * 60 * 24)) + 1;
      const durationLabel = isDaily ? `${dayCount} Day${dayCount > 1 ? 's' : ''}` : bookingTime;
      const printBaseUrl = (typeof publicBaseUrl === "string" && publicBaseUrl)
        ? publicBaseUrl.replace(/\/+$/, "")
        : "";
      const venueBookingDetailsUrl = `${printBaseUrl}/venue-tickets/${encodeURIComponent(booking.referenceNumber || '')}`;
      const venueTicketQrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=1100x1100&margin=28&ecc=M&data=${encodeURIComponent(venueBookingDetailsUrl)}`;
      const venueDetailsLink = venue && venue._id ? `/venue/${venue._id}` : '/venue';
      const notifications = Array.isArray(locals.notifications) ? locals.notifications : [];
      const formatTicketCount = (count) => `${count} ticket${count === 1 ? '' : 's'}`;
      const formatNotifTime = (date) => {
        if (!date) return "Just now";
        const d = new Date(date);
        if (Number.isNaN(d.getTime())) return "Just now";
        return d.toLocaleString("en-US", { month: "short", day: "2-digit", hour: "2-digit", minute: "2-digit" });
      };
    %>

    <header class="navbar">
      <div class="nav-inner">
        <a href="<%= locals.user ? (locals.user.role === 'admin' ? '/admin/dashboard' : '/user') : '/guest' %>" class="nav-logo" style="text-decoration: none; color: #1e293b !important; font-size: 1.25rem !important; font-weight: 800 !important; letter-spacing: normal !important; font-family: 'DM Sans', sans-serif !important;">EMS</a>
        <nav class="nav-center">
          <a href="/user" class="nav-link <%= path === '/user' ? 'active' : '' %>">Home</a>
          <a href="/catalog" class="nav-link <%= path === '/catalog' ? 'active' : '' %>">Events</a>
          <a href="/venue" class="nav-link <%= path === '/venue' ? 'active' : '' %>">Venues</a>
          <a href="/bookings" class="nav-link <%= path === '/bookings' ? 'active' : '' %>">My Bookings</a>
        </nav>
        <div class="nav-right">
          <% if (locals.user) { %>
            <button class="icon-btn" id="notifBtn" aria-label="Notifications">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" />
              </svg>
              <% if (notifications.some(n => !n.isRead)) { %>
                <span class="notif-dot"></span>
              <% } %>
            </button>
            <img
              src="<%= (locals.user && user.profileImage) ? user.profileImage : 'https://ui-avatars.com/api/?name=' + (locals.user ? user.username : 'User') + '&background=e74c3c&color=fff' %>"
              alt="User avatar" class="avatar-circle" id="profileTrigger" />
          <% } else { %>
            <a href="/login" class="nav-link">Login</a>
          <% } %>
        </div>
      </div>
    </header>

    <div class="notif-dropdown" id="notifDropdown">
      <p class="notif-title">NOTIFICATIONS</p>
      <% if (notifications.length === 0) { %>
        <p class="notif-empty">No new notifications</p>
      <% } else { %>
        <% notifications.forEach(function(note) { 
            const title = note.type === 'booking_cancelled' ? 'Booking Cancelled' : 'Booking Confirmed';
            const eventTitle = note.eventName || 'Event';
            const countLabel = formatTicketCount(note.ticketCount || 1);
            const timeLabel = formatNotifTime(note.createdAt);
        %>
          <div class="notif-item">
            <p class="notif-item-title"><%= title %></p>
            <p class="notif-item-sub"><%= eventTitle %> · <%= countLabel %></p>
            <p class="notif-time"><%= timeLabel %></p>
          </div>
        <% }) %>
      <% } %>
    </div>

    <main class="page-shell">
      <a href="<%= backHref %>" class="back-link"><%= backLabel %></a>

      <div class="manage-layout">
        <section class="manage-content">
          <article class="hero-card">
            <div class="hero-image" style="background-image: url('<%= venueImage %>')">
              <span class="status-pill <%= normalizedStatus %>"><%= bookingStatus %></span>
            </div>
            <div class="hero-grid">
              <div class="info-block">
                <p class="label">VENUE NAME</p>
                <h2><%= venueName %></h2>
              </div>
              <div class="info-block">
                <p class="label">LOCATION</p>
                <p class="value"><%= venueLocation %></p>
              </div>
              <div class="info-block">
                <p class="label">DATE & TIME</p>
                <p class="value"><%= bookingDate %></p>
                <p class="muted"><%= bookingTime %></p>
              </div>
              <div class="info-block">
                <p class="label">TOTAL</p>
                <p class="value"><%= totalDisplay %></p>
              </div>
            </div>
          </article>

          <article class="attendee-card">
            <p class="label">BOOKING INFORMATION</p>
            <div class="attendee-grid">
              <div>
                <p class="meta-label">Duration</p>
                <p class="meta-value"><%= durationLabel %></p>
              </div>
              <div>
                <p class="meta-label">Phone Number</p>
                <p class="meta-value"><%= phoneNumber %></p>
              </div>
            </div>
          </article>

          <article class="ticket-card">
            <div class="ticket-header">
              <div>
                <p class="label">BOOKING DETAILS</p>
                <h3>EMS Venue Booking</h3>
              </div>
              <div class="ticket-ref">
                <span>REFERENCE</span>
                <strong><%= booking.referenceNumber || '-' %></strong>
              </div>
            </div>
            <div class="ticket-grid">
              <div>
                <p class="meta-label">Venue</p>
                <p class="meta-value"><%= venueName %></p>
              </div>
              <div>
                <p class="meta-label">Date</p>
                <p class="meta-value"><%= bookingDate %></p>
              </div>
              <div>
                <p class="meta-label">Time</p>
                <p class="meta-value"><%= bookingTime %></p>
              </div>
              <div>
                <p class="meta-label">Location</p>
                <p class="meta-value"><%= venueLocation %></p>
              </div>
              <div>
                <p class="meta-label">Total</p>
                <p class="meta-value"><%= totalDisplay %></p>
              </div>
              <div>
                <p class="meta-label">Booked On</p>
                <p class="meta-value"><%= bookedOnLabel %></p>
              </div>
            </div>
          </article>

          <section class="about-section">
            <p class="label">ABOUT THE VENUE</p>
            <p class="about-text">
              <%= (venue && venue.description) ? venue.description : 'A versatile venue ideal for events, meetups, and curated experiences.' %>
            </p>
            <a href="<%= venueDetailsLink %>" class="inline-link">View Full Venue Details →</a>
          </section>
        </section>

        <aside class="manage-sidebar">
          <div class="side-card">
            <h3>Manage Booking</h3>
            <button class="download-btn" type="button" id="downloadBtn" <%= isInactive ? 'disabled' : '' %>>
              Download Confirmation
            </button>
            <button
              class="cancel-btn"
              id="cancelBookingBtn"
              data-booking="<%= booking && booking._id ? booking._id.toString() : '' %>"
              <%= isInactive ? 'disabled' : '' %>
            >
              <%= isInactive ? 'Cancelled' : 'Cancel Booking' %>
            </button>
            <p class="side-note">
              Cancellations are final. No refunds are provided for venue bookings.
            </p>
          </div>
        </aside>
      </div>
    </main>

    <% if (locals.user) { %>
      <div class="sidebar-overlay" id="sidebarOverlay"></div>
      <aside class="avatar-sidebar" id="avatarSidebar">
        <div class="sidebar-user-info">
          Hi, <%= (locals.user && user.username) ? user.username.charAt(0).toUpperCase() + user.username.slice(1) : 'User'
            %>
        </div>

        <div class="sidebar-divider"></div>

        <a href="/profile" class="sidebar-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          My Profile
        </a>

        <div class="sidebar-divider"></div>

        <a href="/logout" class="sidebar-logout" id="logoutBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          Log Out
        </a>
      </aside>
    <% } %>

    <footer class="footer">
      <span class="footer-copy">COPYRIGHT © 2026 EMS. ALL RIGHTS RESERVED.</span>
      <div class="footer-links">
        <a href="/privacy">PRIVACY POLICY</a>
        <a href="/terms">TERMS OF SERVICE</a>
        <a href="/contact">CONTACT</a>
      </div>
    </footer>

    <div class="confirm-modal" id="confirmModal" aria-hidden="true">
      <div class="confirm-backdrop" data-close="true"></div>
      <div class="confirm-card" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
        <h3 id="confirmTitle">Download Confirmation</h3>
        <p class="confirm-subtitle">Review venue booking details before saving.</p>
        <div class="confirm-details">
          <div class="detail-row"><span>Venue</span><strong><%= venueName %></strong></div>
          <div class="detail-row"><span>Date</span><strong><%= bookingDate %></strong></div>
          <div class="detail-row"><span>Time</span><strong><%= bookingTime %></strong></div>
          <div class="detail-row"><span>Location</span><strong><%= venueLocation %></strong></div>
          <div class="detail-row"><span>Total</span><strong><%= totalDisplay %></strong></div>
          <div class="detail-row"><span>Reference</span><strong><%= booking.referenceNumber || '-' %></strong></div>
        </div>
        <div class="confirm-actions">
          <button class="ghost-btn" type="button" id="confirmCancel">Cancel</button>
          <button class="primary-btn" type="button" id="confirmSave">Save</button>
        </div>
      </div>
    </div>

    <div class="confirm-modal" id="cancelModal" aria-hidden="true">
      <div class="confirm-backdrop" data-close="true"></div>
      <div class="confirm-card" role="dialog" aria-modal="true" aria-labelledby="cancelTitle">
        <h3 id="cancelTitle">Cancel Booking</h3>
        <p class="confirm-subtitle">Are you sure you want to cancel this venue booking?</p>
        <div class="confirm-actions">
          <button class="ghost-btn" type="button" id="cancelModalNo">Keep Booking</button>
          <button class="primary-btn" type="button" id="cancelModalYes">Yes, Cancel</button>
        </div>
      </div>
    </div>

    <div class="print-tickets" aria-hidden="true">
      <section class="print-ticket">
        <div class="print-ticket-header">
          <div class="print-ticket-qr-wrap">
            <img class="print-ticket-qr" src="<%= venueTicketQrUrl %>" alt="Venue booking QR code" />
            <p class="print-ticket-scan">Scan QR code for full booking details</p>
          </div>
          <div class="print-ticket-main">
            <p class="print-ticket-label">VENUE BOOKING</p>
            <h2 class="print-ticket-title"><%= venueName %></h2>
            <p class="print-ticket-meta"><%= bookingDate %></p>
            <p class="print-ticket-meta"><%= bookingTime %></p>
            <p class="print-ticket-meta">Location: <%= venueLocation %></p>
            <p class="print-ticket-meta">Phone: <%= phoneNumber %></p>
            <p class="print-ticket-meta">Total: <%= totalDisplay %></p>
            <p class="print-ticket-meta">Reference: <%= booking.referenceNumber || '-' %></p>
            <p class="print-ticket-meta">Booked On: <%= bookedOnLabel %></p>
          </div>
        </div>
        <div class="print-ticket-banner">
          <img src="<%= venueImage %>" alt="<%= venueName %> venue image" />
        </div>
      </section>
    </div>

    <script>
      const downloadBtn = document.getElementById('downloadBtn');
      const confirmModal = document.getElementById('confirmModal');
      const confirmCancel = document.getElementById('confirmCancel');
      const confirmSave = document.getElementById('confirmSave');
      const openModal = () => {
        confirmModal.classList.add('open');
        confirmModal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('modal-open');
      };
      const closeModal = () => {
        confirmModal.classList.remove('open');
        confirmModal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('modal-open');
      };
      if (downloadBtn && !downloadBtn.disabled) downloadBtn.addEventListener('click', openModal);
      if (confirmCancel) confirmCancel.addEventListener('click', closeModal);
      if (confirmSave) confirmSave.addEventListener('click', () => { closeModal(); window.print(); });
      if (confirmModal) {
        confirmModal.addEventListener('click', (event) => {
          if (event.target && event.target.dataset && event.target.dataset.close === 'true') closeModal();
        });
      }

      const cancelBtn = document.getElementById('cancelBookingBtn');
      const cancelModal = document.getElementById('cancelModal');
      const cancelModalNo = document.getElementById('cancelModalNo');
      const cancelModalYes = document.getElementById('cancelModalYes');
      const openCancelModal = () => {
        cancelModal.classList.add('open');
        cancelModal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('modal-open');
      };
      const closeCancelModal = () => {
        cancelModal.classList.remove('open');
        cancelModal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('modal-open');
      };
      if (cancelBtn && !cancelBtn.disabled) cancelBtn.addEventListener('click', openCancelModal);
      if (cancelModalNo) cancelModalNo.addEventListener('click', closeCancelModal);
      if (cancelModal) {
        cancelModal.addEventListener('click', (event) => {
          if (event.target && event.target.dataset && event.target.dataset.close === 'true') closeCancelModal();
        });
      }
      if (cancelModalYes && cancelBtn) {
        cancelModalYes.addEventListener('click', async () => {
          const bookingId = cancelBtn.dataset.booking;
          if (!bookingId) return;
          try {
            const response = await fetch(`/bookings/cancel-booking/${bookingId}`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify({ cancelCount: 1 })
            });
            const contentType = response.headers.get('content-type') || '';
            const data = contentType.includes('application/json') ? await response.json() : { success: false };
            if (!response.ok || !data.success) {
              alert(data.message || 'Unable to cancel booking.');
              return;
            }
            window.location.href = '/bookings?status=cancelled';
          } catch (err) {
            alert('Unable to cancel booking.');
          } finally {
            closeCancelModal();
          }
        });
      }
    </script>
    <script src="/js/user.js"></script>
  </body>
</html>
