<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EMS – Discover & Book Incredible Events</title>
  <link rel="stylesheet" href="/css/guest.css?v=2" />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
    rel="stylesheet" />
</head>

<body>
  <header class="navbar">
    <div class="nav-inner">
      <a href="/" class="logo"
        style="text-decoration: none; color: #1e293b !important; font-size: 1.25rem !important; font-weight: 800 !important; letter-spacing: normal !important; font-family: 'DM Sans', sans-serif !important;">EMS</a>
      <nav class="nav-links">
        <a href="/register" class="nav-link">Register</a>
        <a href="/login" class="btn-get-started">Get Started</a>
      </nav>
    </div>
  </header>

  <section class="hero">
    <div class="hero-content">
      <h1 class="hero-heading">
        Discover and<br />book<br />
        <em class="hero-accent">incredible</em><br />
        events.
      </h1>
      <p class="hero-sub">
        Join the architectural evolution of event management.<br />
        Curated experiences, seamless bookings, and memories<br />
        that anchor the future of 2026.
      </p>
      <form action="/events/search" method="GET" class="search-bar">
        <div class="search-input-wrap">
          <input type="text" name="q" placeholder="Search events..." />
        </div>

        <div class="category-select-wrap" style="padding: 0 15px; border-left: 1px solid #eee">
          <select name="category" style="
                border: none;
                outline: none;
                background: transparent;
                font-family: inherit;
                color: #666;
                cursor: pointer;
              ">
            <option value="All">All Categories</option>
            <option value="Music">Music</option>
            <option value="Technology">Technology</option>
            <option value="Sports">Sports</option>
            <option value="Arts">Arts</option>
            <option value="Food and Drink">Food and Drink</option>
            <option value="Networking">Networking</option>
            <option value="Education">Education</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div class="date-select" style="padding: 0 15px; border-left: 1px solid #eee">
          <input type="date" name="date" style="
                border: none;
                outline: none;
                background: transparent;
                font-family: inherit;
                color: #666;
                cursor: pointer;
              " />
        </div>

        <button type="submit" class="btn-search">Search</button>
      </form>
    </div>
    <div class="hero-image-wrap">
      <img class="hero-img"
        src="https://ca-times.brightspotcdn.com/dims4/default/f854f6b/2147483647/strip/true/crop/5568x3712+0+0/resize/1200x800!/quality/75/?url=https%3A%2F%2Fcalifornia-times-brightspot.s3.amazonaws.com%2Faa%2F18%2Fe54c32e242b684c943ea0cf6c222%2Fap21310170175809.jpg" />

      <div class="floating-card">
        150+ Exclusive <br />
        Events Added
      </div>
    </div>
  </section>

  <section class="events-section">
    <% const formatEventDate=(start, end)=> {
      if (!start) return 'Date TBD';
      const d1 = new Date(start);
      if (isNaN(d1.getTime())) return 'Date TBD';

      const options = { month: 'short', day: '2-digit', year: 'numeric' };
      const sStr = d1.toLocaleDateString('en-US', options);

      if (!end) return sStr;
      const d2 = new Date(end);
      if (isNaN(d2.getTime())) return sStr;

      const eStr = d2.toLocaleDateString('en-US', options);
      return sStr === eStr ? sStr : `${sStr} - ${eStr}`;
      };
      %>
      <div class="section-inner">
        <div class="section-header">
          <div>
            <p class="section-label">CURATION 2026</p>
            <h2 class="section-title">Upcoming Events</h2>
          </div>

        </div>

        <div class="events-grid">
          <% if (events && events.length> 0) { %> <% events.forEach(event=> { %>
              <div class="event-card" onclick="window.location.href='/event/<%= event._id %>'"
                style="cursor:pointer; width:100%;">
                <div class="card-img-wrap">
                  <img src="<%= event.imagePath || event.image || '/images/default-event.png' %>"
                    alt="<%= event.title || event.eventName || 'Event' %>" />

                  <% if (event.category) { %>
                    <span class="card-tag tag-<%= event.category.toLowerCase() %>">
                      <%= event.category %>
                    </span>
                    <% } else if (event.categoryId && event.categoryId.name) { %>
                      <span class="card-tag tag-<%= event.categoryId.name.toLowerCase() %>">
                        <%= event.categoryId.name %>
                      </span>
                      <% } %>
                </div>
                <div class="card-body">
                  <p class="card-date">
                    <%= formatEventDate(event.startDate || event.date, event.endDate) %>
                  </p>
                  <h3 class="card-title">
                    <%= event.title || event.eventName || 'Untitled Event' %>
                  </h3>
                  <p class="card-location">
                    <%= event.location || 'Location TBD' %>
                  </p>
                </div>
              </div>
              <% }) %>
                <% } else { %>
                  <p>No events found for your search.</p>
                  <% } %>
        </div>

        <div class="browse-wrap">
          <a href="/catalog" class="btn-browse">Browse All Events
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
  </section>

  <section class="events-section venues-section">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <p class="section-label">SPACES 2026</p>
          <h2 class="section-title">Featured Venues</h2>
        </div>
      </div>

      <div class="events-grid">
        <% if (typeof venues !=='undefined' && venues && venues.length> 0) { %>
          <% venues.forEach(venue=> { %>
            <div class="event-card" onclick="window.location.href='/venue/<%= venue._id %>'"
              style="cursor:pointer; width:100%;">
              <div class="card-img-wrap">
                <img src="<%= venue.imagePath || '/images/default-venue.png' %>" alt="<%= venue.name %>" />
                <span class="card-tag">
                  <%= venue.category %>
                </span>
              </div>
              <div class="card-body">
                <p class="card-date">
                  <%= venue.location %>
                </p>
                <h3 class="card-title">
                  <%= venue.name %>
                </h3>
                <p class="card-location">Capacity: <%= venue.capacity %> guests</p>
              </div>
            </div>
            <% }); %>
              <% } else { %>
                <p style="color:#999; font-size:14px;">No venues available at the moment.</p>
                <% } %>
      </div>

      <div class="browse-wrap">
        <a href="/venue" class="btn-browse">Browse All Venues
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <footer class="footer">
    <span class="footer-copy">COPYRIGHT © 2026 EMS. ALL RIGHTS RESERVED.</span>
    <div class="footer-links">
      <a href="/privacy">PRIVACY POLICY</a>
      <a href="/terms">TERMS OF SERVICE</a>
      <a href="/contact">CONTACT</a>
    </div>
  </footer>
</body>

</html>