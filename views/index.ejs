    </div>

    <!-- Lower Line: Venues (Scrolling Right) -->
    <div class="ticker-wrapper ticker-right">
      <div class="ticker-track">
        <span class="ticker-tag">🏡 Private Estates</span>
        <span class="ticker-tag">🏢 Rooftop Bars</span>
        <span class="ticker-tag">🌳 Open Air Parks</span>
        <span class="ticker-tag">🍸 Lounges</span>
        <span class="ticker-tag">🏰 Banquet Halls</span>
        <span class="ticker-tag">👥 Co-working Hubs</span>
        <span class="ticker-tag">🌱 Fern Garden</span>
        <span class="ticker-tag">🏨 Hotel</span>
        <span class="ticker-tag">⛲ Outdoor Space</span>


        <!-- Duplicates for seamless infinite scroll -->
        <span class="ticker-tag">🏡 Private Estates</span>
        <span class="ticker-tag">🏢 Rooftop Bars</span>
        <span class="ticker-tag">🌳 Open Air Parks</span>
        <span class="ticker-tag">🍸 Lounges</span>
        <span class="ticker-tag">🏰 Banquet Halls</span>
        <span class="ticker-tag">👥 Co-working Hubs</span>
        <span class="ticker-tag">🌱 Fern Garden</span>
