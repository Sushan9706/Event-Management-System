        <span class="ticker-tag">🎵 Music</span>
        <span class="ticker-tag">🍹 Food & Drink</span>
        <span class="ticker-tag">🎨 Arts</span>
        <span class="ticker-tag">💻 Tech</span>
        <span class="ticker-tag">🎆 Festivals</span>
        <span class="ticker-tag">⚽ Sports</span>
        <span class="ticker-tag">🎤 Concerts</span>
