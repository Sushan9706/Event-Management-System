  <section class="events-section">
    <% const formatEventDate=(start, end)=> {
      if (!start) return 'Date TBD';
      const d1 = new Date(start);
      if (isNaN(d1.getTime())) return 'Date TBD';

      const options = { month: 'short', day: '2-digit', year: 'numeric' };
      const sStr = d1.toLocaleDateString('en-US', options);

      if (!end) return sStr;
      const d2 = new Date(end);
      if (isNaN(d2.getTime())) return sStr;

      const eStr = d2.toLocaleDateString('en-US', options);
      return sStr === eStr ? sStr : `${sStr} - ${eStr}`;
      };
      %>
      <div class="section-inner">
        <div class="section-header">
          <div>
            <p class="section-label">CURATION 2026</p>
            <h2 class="section-title">Upcoming Events</h2>
          </div>

        </div>

        <div class="events-grid">
          <% if (events && events.length> 0) { %> <% events.forEach(event=> { %>
              <div class="event-card" onclick="window.location.href='/login'" style="cursor:pointer; width:100%;">
                <div class="card-img-wrap">
                  <img src="<%= event.imagePath || event.image || '/images/default-event.png' %>"
                    alt="<%= event.title || event.eventName || 'Event' %>" />

                  <% if (event.category) { %>
                    <span class="card-tag tag-<%= event.category.toLowerCase() %>">
                      <%= event.category %>
                    </span>
                    <% } else if (event.categoryId && event.categoryId.name) { %>
                      <span class="card-tag tag-<%= event.categoryId.name.toLowerCase() %>">
                        <%= event.categoryId.name %>
                      </span>
                      <% } %>
                </div>
                <div class="card-body">
                  <h3 class="card-title" style="font-weight: bold; margin-bottom: 4px;">
                    <%= event.title || event.eventName || 'Untitled Event' %>
                  </h3>
                  <p class="card-date" style="font-weight: normal; margin-bottom: 4px; text-align: left; background: none; border: none; padding: 0;">
                    <%= formatEventDate(event.startDate || event.date, event.endDate) %>
                  </p>
                  <p class="card-location">
                    <%= event.location || 'Location TBD' %>
                  </p>
                </div>
              </div>
              <% }) %>
                <% } else { %>
                  <p>No events found for your search.</p>
                  <% } %>
        </div>

        <div class="browse-wrap">
          <a href="/login" class="btn-browse">Browse All Events
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
  </section>

  <section class="events-section venues-section">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <p class="section-label">SPACES 2026</p>
          <h2 class="section-title">Featured Venues</h2>
        </div>
      </div>

      <div class="events-grid">
        <% if (typeof venues !=='undefined' && venues && venues.length> 0) { %>
          <% venues.forEach(venue=> { %>
            <div class="event-card" onclick="window.location.href='/login'" style="cursor:pointer; width:100%;">
              <div class="card-img-wrap">
                <img src="<%= venue.imagePath || '/images/default-venue.png' %>" alt="<%= venue.name %>" />
                <span class="card-tag">
                  <%= venue.category %>
                </span>
              </div>
              <div class="card-body">
                <h3 class="card-title" style="font-weight: bold; margin-bottom: 4px;">
                  <%= venue.name %>
                </h3>
                <p class="card-date" style="font-weight: normal; margin-bottom: 4px; text-align: left; background: none; border: none; padding: 0;">
                  <%= venue.location %>
                </p>
                <p class="card-location">Capacity: <%= venue.capacity %> guests</p>
              </div>
            </div>
            <% }); %>
              <% } else { %>
                <p style="color:#999; font-size:14px;">No venues available at the moment.</p>
                <% } %>
      </div>

      <div class="browse-wrap">
        <a href="/login" class="btn-browse">Browse All Venues
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <footer class="footer">
