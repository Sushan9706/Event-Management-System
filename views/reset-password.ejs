<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - EMS</title>
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>

    <header class="navbar">
        <div class="logo">EMS</div>
        <nav>
            <a href="/guest">Events</a>
            <a href="/register" class="btn-get-started">Get Started</a>
        </nav>
    </header>

    <main class="login-container">
        <section class="welcome-text">
            <h1>Reset Password.</h1>
            <p>Enter your email to receive a password reset link.</p>
        </section>

        <div class="login-card">
           <% if (typeof error !== 'undefined' && error.length > 0) { %>
        <div class="flash-message error">
            <span class="flash-icon">!</span>
            <%= error %>
        </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success.length > 0) { %>
        <div class="flash-message success">
            <span class="flash-icon">✓</span>
            <%= success %>
        </div>
    <% } %>

            <form action="/reset-password" method="POST">
                <div class="input-group">
                    <label for="email">EMAIL</label>
                    <input type="email" id="email" name="email" placeholder="name@event.com" required>
                </div>

                <button type="submit" class="login-btn">Send Reset Link</button>
            </form>

            <p class="register-text">
                Remember your password? <a href="/login">Back to Login</a>
            </p>
        </div>
    </main>

    <footer class="footer">
        <div class="footer-left">
            COPYRIGHT © 2026 EMS. ALL RIGHTS RESERVED.
        </div>
        <div class="footer-right">
            <a href="#">TERMS</a>
            <a href="#">PRIVACY</a>
        </div>
    </footer>

</body>

<script>
    // Auto-dismiss flash messages
    document.querySelectorAll('.flash-message').forEach(msg => {
        setTimeout(() => {
            msg.classList.add('fade-out');
            setTimeout(() => {
                msg.remove();
            }, 400); // Wait for animation to finish
        }, 2000); // 2 seconds delay
    });
</script>
</html>