<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Reset Password</title>
    <link rel="stylesheet" href="/css/reset-password.css">
</head>
<body>

    <div class="container">
        <div class="header">
            <h2 class="logo">EMS</h2>
            <span class="help">?</span>
        </div>

        <div class="content">
            <h1>Reset your<br>password.</h1>
            <p>
                Enter the email associated with your account
                and we'll send a link to reset your password.
            </p>

            <form action="/reset-password" method="POST" class="form-card">
                <label for="email">EMAIL ADDRESS</label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    placeholder="name@company.com" 
                    required
                >

                <button type="submit">
                    Send Reset Link →
                </button>
            </form>

            <a href="/login" class="back-link">← RETURN TO LOGIN</a>
        </div>

        <footer>
            <p>Copyright © <%= new Date().getFullYear() %> EMS. All rights reserved.</p>
            <div class="links">
                <a href="#">Terms</a>
                <a href="#">Privacy</a>
                <a href="#">Contact</a>
            </div>
        </footer>
    </div>

</body>
</html>