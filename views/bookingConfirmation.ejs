<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Confirmed - EMS</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/bookingConfirmation.css">
</head>
<body>

    <header class="navbar">
        <a href="<%= locals.user ? (locals.user.role === 'admin' ? '/admin/dashboard' : '/user') : '/guest' %>" class="logo" style="text-decoration: none; color: #1e293b !important; font-size: 1.25rem !important; font-weight: 800 !important; letter-spacing: normal !important; font-family: 'DM Sans', sans-serif !important;">EMS</a>
        <nav>
            <a href="/catalog">Events</a>
            <a href="/logout" class="btn-logout-nav">Logout</a>
        </nav>
    </header>

    <main class="confirmation-container">

        <div class="confirmation-card">

            <div class="success-icon">&#10003;</div>
            <h1>Booking Confirmed!</h1>
            <p class="subtitle">Your spot has been reserved successfully.</p>

            <div class="booking-ref">
                <span class="ref-label">BOOKING REFERENCE</span>
                <span class="ref-number"><%= booking.bookingRef %></span>
            </div>

            <div class="event-summary">
                <h2><%= booking.event.name %></h2>

                <div class="summary-row">
                    <span class="summary-label">Date</span>
                    <span class="summary-value">
                        <%= booking.event.startDate ? new Date(booking.event.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'TBA' %>
                    </span>
                </div>

                <div class="summary-row">
                    <span class="summary-label">Time</span>
                    <span class="summary-value">
                        <%= booking.event.startTime ? (booking.event.endTime ? `${booking.event.startTime} - ${booking.event.endTime}` : booking.event.startTime) : 'TBA' %>
                    </span>
                </div>

                <div class="summary-row">
                    <span class="summary-label">Location</span>
                    <span class="summary-value"><%= booking.event.location || 'TBA' %></span>
                </div>

                <div class="summary-row">
                    <span class="summary-label">Amount Paid</span>
                    <span class="summary-value">
                        <% if (booking.amount === 0) { %>Free<% } else { %>NPR. <%= booking.amount.toFixed(2) %><% } %>
                    </span>
                </div>

                <div class="summary-row">
                    <span class="summary-label">Status</span>
                    <span class="status-badge <%= booking.status %>"><%= booking.status.toUpperCase() %></span>
                </div>

                <div class="summary-row">
                    <span class="summary-label">Booked On</span>
                    <span class="summary-value">
                        <%= new Date(booking.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                    </span>
                </div>
            </div>

            <div class="confirmation-actions">
                <a href="/catalog" class="btn-secondary">Browse More Events</a>
            </div>

        </div>

    </main>

    <footer class="footer">
        <span class="footer-copy">COPYRIGHT © 2026 EMS. ALL RIGHTS RESERVED.</span>
        <div class="footer-links">
            <a href="/privacy">PRIVACY POLICY</a>
            <a href="/terms">TERMS OF SERVICE</a>
            <a href="/contact">CONTACT</a>
        </div>
    </footer>

</body>
</html>
