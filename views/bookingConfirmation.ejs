<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Confirmed - EMS</title>
    <link rel="stylesheet" href="/css/bookingConfirmation.css">
</head>
<body>

    <header class="navbar">
        <a href="/" class="logo">EMS</a>
        <nav>
            <a href="/events">Events</a>
            <a href="/logout" class="btn-logout-nav">Logout</a>
        </nav>
    </header>

    <main class="confirmation-container">

        <div class="confirmation-card">

            <div class="success-icon">&#10003;</div>
            <h1>Booking Confirmed!</h1>
            <p class="subtitle">Your spot has been reserved successfully.</p>

            <div class="booking-ref">
                <span class="ref-label">BOOKING REFERENCE</span>
                <span class="ref-number"><%= booking.bookingRef %></span>
            </div>

            <div class="event-summary">
                <h2><%= booking.event.name %></h2>

                <div class="summary-row">
                    <span class="summary-label">Date</span>
                    <span class="summary-value">
                        <%= new Date(booking.event.date).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                    </span>
                </div>

                <% if (booking.event.time) { %>
                <div class="summary-row">
                    <span class="summary-label">Time</span>
                    <span class="summary-value"><%= booking.event.time %></span>
                </div>
                <% } %>

                <div class="summary-row">
                    <span class="summary-label">Location</span>
                    <span class="summary-value"><%= booking.event.location || 'TBA' %></span>
                </div>

                <div class="summary-row">
                    <span class="summary-label">Amount Paid</span>
                    <span class="summary-value">
                        <% if (booking.amount === 0) { %>Free<% } else { %>$<%= booking.amount.toFixed(2) %><% } %>
                    </span>
                </div>

                <div class="summary-row">
                    <span class="summary-label">Status</span>
                    <span class="status-badge <%= booking.status %>"><%= booking.status.toUpperCase() %></span>
                </div>

                <div class="summary-row">
                    <span class="summary-label">Booked On</span>
                    <span class="summary-value">
                        <%= new Date(booking.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                    </span>
                </div>
            </div>

            <div class="confirmation-actions">
                <a href="/events" class="btn-secondary">Browse More Events</a>
            </div>

        </div>

    </main>

    <footer class="footer">
        <div class="footer-left">COPYRIGHT &copy; 2026 EMS. ALL RIGHTS RESERVED.</div>
        <div class="footer-right">
            <a href="#">TERMS</a>
            <a href="#">PRIVACY</a>
        </div>
    </footer>

</body>
</html>
