<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EMS – Manage Booking</title>
    <link rel="stylesheet" href="/css/manageBooking.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <%
      const event = booking.eventId;
      const eventName = event ? (event.eventName || event.title || event.name) : "Event";
      const formatDateLabel = (value) => value
        ? new Date(value).toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" })
        : "TBA";
      const startDateLabel = formatDateLabel(event && (event.startDate || event.date));
      const endDateLabel = formatDateLabel(event && (event.endDate || event.startDate || event.date));
      const eventDate = startDateLabel === endDateLabel || endDateLabel === "TBA"
        ? startDateLabel
        : `${startDateLabel} - ${endDateLabel}`;
      const eventTime = event && (event.startTime || event.endTime)
        ? `${event.startTime || "TBA"}${event.endTime ? " - " + event.endTime : ""}`
        : (event && event.time ? event.time : "TBA");
      const printBaseUrl = (typeof publicBaseUrl === "string" && publicBaseUrl)
        ? publicBaseUrl.replace(/\/+$/, "")
        : "";
      const eventLocation = event && event.location ? event.location : "TBA";
      const eventImage = (event && (event.image || event.imagePath))
        ? (event.image || event.imagePath)
        : "https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?q=80&w=1200&auto=format&fit=crop";
      const normalizedStatus = (booking.status || "confirmed").toLowerCase();
      const bookingStatus = normalizedStatus.toUpperCase();
      const isCancelled = normalizedStatus === "cancelled";
      const isExpired = normalizedStatus === "expired";
      const isInactive = isCancelled || isExpired || !!forceViewOnly;
      const backLabel = isCancelled
        ? "← Back to Cancelled Bookings"
        : (isExpired ? "← Back to Expired Bookings" : "← Back to My Bookings");
      const backHref = isCancelled
        ? "/bookings?status=cancelled"
        : (isExpired ? "/bookings?status=expired" : "/bookings?status=confirmed");
      const bookingTier = event && event.category ? event.category : "Premium";
      const ticketCount = booking.ticketCount || 1;
      const unitPrice = (typeof booking.unitPrice === "number")
        ? booking.unitPrice
        : (event && typeof event.ticketPrice === "number" ? event.ticketPrice : 0);
      const totalAmount = (typeof booking.totalAmount === "number")
        ? booking.totalAmount
        : unitPrice * ticketCount;
      const ticketCodes = Array.isArray(booking.ticketCodes) ? booking.ticketCodes : [];
      const ticketSlots = Math.max(ticketCount, ticketCodes.length, 1);
      const ticketList = Array.from({ length: ticketSlots }, (_, index) => ticketCodes[index] || "TBA");
      const ticketCodesDisplay = ticketList.length ? ticketList.join(", ") : "TBA";
      const ticketIdLabel = ticketList.length > 1 ? "Ticket IDs" : "Ticket ID";
      const attendeeNames = Array.isArray(booking.attendeeNames) ? booking.attendeeNames : [];
      const attendeeList = Array.from({ length: ticketSlots }, (_, index) => attendeeNames[index] || (index === 0 ? booking.userName : ""));
      const attendeeNamesDisplay = attendeeList.filter(Boolean).length ? attendeeList.filter(Boolean).join(", ") : "-";
      const cancelTicketRows = ticketList.map((code, index) => ({
        code,
        attendeeName: attendeeList[index] || `Attendee ${index + 1}`,
        index: index + 1
      }));
      const unitPriceDisplay = unitPrice === 0 ? "Free" : `NPR. ${unitPrice % 1 === 0 ? unitPrice.toFixed(0) : unitPrice.toFixed(2)}`;
      const totalDisplay = totalAmount === 0 ? "Free" : `NPR. ${totalAmount % 1 === 0 ? totalAmount.toFixed(0) : totalAmount.toFixed(2)}`;
      const bookingDate = booking.createdAt
        ? new Date(booking.createdAt).toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" })
        : "TBA";
      const attendeeName = attendeeList[0] || "-";
      const attendeeEmail = booking.attendeeEmail || booking.userEmail || (user && user.email) || "-";
      const eventDetailsLink = event && event._id ? `/event/${event._id}` : "/catalog";
      const notifications = Array.isArray(locals.notifications) ? locals.notifications : [];
      const formatTicketCount = (count) => `${count} ticket${count === 1 ? '' : 's'}`;
      const formatNotifTime = (date) => {
        if (!date) return "Just now";
        const d = new Date(date);
        if (Number.isNaN(d.getTime())) return "Just now";
        return d.toLocaleString("en-US", { month: "short", day: "2-digit", hour: "2-digit", minute: "2-digit" });
      };
    %>

    <header class="navbar">
      <div class="nav-container">
        <a href="<%= locals.user ? (locals.user.role === 'admin' ? '/admin/dashboard' : '/user') : '/guest' %>" class="nav-logo" style="text-decoration: none; color: #1e293b !important; font-size: 1.25rem !important; font-weight: 800 !important; letter-spacing: normal !important; font-family: 'DM Sans', sans-serif !important;">EMS</a>
        <nav class="nav-links">
          <a href="/user">Home</a>
          <a href="/catalog">Events</a>
          <a href="/venue">Venues</a>
          <a href="/bookings" class="active">My Bookings</a>
        </nav>
        <div class="nav-actions">
          <div class="notif-wrap">
            <button class="icon-btn" aria-label="Notifications" id="bellBtn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
            </button>
            <div class="bell-dropdown" id="bellDropdown">
              <% if (notifications.length===0) { %>
                No new notifications
                <% } else { %>
                  <% notifications.forEach(function(note) { const title=note.type==='booking_cancelled'
                    ? 'Booking Cancelled' : 'Booking Confirmed' ; const eventTitle=note.eventName || 'Event' ; const
                    countLabel=formatTicketCount(note.ticketCount || 1); const
                    timeLabel=formatNotifTime(note.createdAt); %>
                    <div class="notif-item">
                      <p class="notif-title">
                        <%= title %>
                      </p>
                      <p class="notif-sub">
                        <%= eventTitle %> · <%= countLabel %>
                      </p>
                      <p class="notif-time">
                        <%= timeLabel %>
                      </p>
                    </div>
                    <% }) %>
                      <% } %>
            </div>
          </div>
          <img
            src="<%= (locals.user && user.profileImage) ? user.profileImage : 'https://ui-avatars.com/api/?name=' + (locals.user ? user.username : 'User') + '&background=e74c3c&color=fff' %>"
            alt="User avatar" class="avatar-circle" id="profileTrigger" />
        </div>
      </div>
    </header>

    <main class="page-shell">
      <a href="<%= backHref %>" class="back-link">
        <%= backLabel %>
      </a>

      <div class="manage-layout">
        <section class="manage-content">
          <article class="hero-card">
            <div class="hero-image" style="background-image: url('<%= eventImage %>')">
              <span class="status-pill <%= normalizedStatus %>">
                <%= bookingStatus %>
              </span>
            </div>
            <div class="hero-grid">
              <div class="info-block">
                <p class="label">EVENT NAME</p>
                <h2>
                  <%= eventName %>
                </h2>
              </div>
              <div class="info-block">
                <p class="label">LOCATION</p>
                <p class="value">
                  <%= eventLocation %> <span class="link">View on map</span>
                </p>
              </div>
              <div class="info-block">
                <p class="label">DATE &amp; TIME</p>
                <p class="value">
                  <%= eventDate %>
                </p>
                <p class="muted">
                  <%= eventTime %>
                </p>
              </div>
              <div class="info-block">
                <p class="label">BOOKING TIER</p>
                <p class="value">
                  <%= bookingTier %>
                    <span class="tier-icon">✓</span>
                </p>
              </div>
            </div>
          </article>

          <article class="attendee-card">
            <p class="label">ATTENDEE INFORMATION</p>
            <div class="attendee-grid">
              <div>
                <p class="meta-label">Full Names</p>
                <p class="meta-value">
                  <%= attendeeNamesDisplay %>
                </p>
              </div>
              <div>
                <p class="meta-label">Email Address</p>
                <p class="meta-value">
                  <%= attendeeEmail %>
                </p>
              </div>
            </div>
          </article>

          <article class="ticket-card">
            <div class="ticket-header">
              <div>
                <p class="label">TICKET DETAILS</p>
                <h3>EMS Event Ticket</h3>
              </div>
              <div class="ticket-ref">
                <span>REFERENCE</span>
                <strong>
                  <%= booking.referenceNumber || '-' %>
                </strong>
              </div>
            </div>
            <div class="ticket-grid">
              <div>
                <p class="meta-label">Event</p>
                <p class="meta-value">
                  <%= eventName %>
                </p>
              </div>
              <div>
                <p class="meta-label">Date</p>
                <p class="meta-value">
                  <%= eventDate %>
                </p>
              </div>
              <div>
                <p class="meta-label">Time</p>
                <p class="meta-value">
                  <%= eventTime %>
                </p>
              </div>
              <div>
                <p class="meta-label">Location</p>
                <p class="meta-value">
                  <%= eventLocation %>
                </p>
              </div>
              <div>
                <p class="meta-label">Tickets</p>
                <p class="meta-value">
                  <%= ticketCount %>
                </p>
              </div>
              <div>
                <p class="meta-label">Price / Ticket</p>
                <p class="meta-value">
                  <%= unitPriceDisplay %>
                </p>
              </div>
              <div>
                <p class="meta-label">Total</p>
                <p class="meta-value">
                  <%= totalDisplay %>
                </p>
              </div>
              <div>
                <p class="meta-label">Booked On</p>
                <p class="meta-value">
                  <%= bookingDate %>
                </p>
              </div>
              <div>
                <p class="meta-label">Attendees</p>
                <p class="meta-value">
                  <%= attendeeNamesDisplay %>
                </p>
              </div>
              <div>
                <p class="meta-label">Email</p>
                <p class="meta-value">
                  <%= attendeeEmail %>
                </p>
              </div>
              <div class="ticket-codes">
                <p class="meta-label">
                  <%= ticketIdLabel %>
                </p>
                <p class="meta-value">
                  <%= ticketCodesDisplay %>
                </p>
              </div>
            </div>
          </article>

          <section class="about-section">
            <p class="label">ABOUT THE EVENT</p>
            <p class="about-text">
              <%= (event && event.description) ? event.description : 'Event details will be announced soon.' %>
            </p>
            <a href="<%= eventDetailsLink %>" class="inline-link">View Full Event Details →</a>
          </section>

          <article class="map-card">
            <div class="map-header">
              <span class="map-pill">MAP PREVIEW</span>
            </div>
            <div class="map-preview">
              <div class="map-pin"></div>
            </div>
            <div class="map-footer">
              <span class="map-location">
                <%= eventLocation %>
              </span>
            </div>
          </article>
        </section>

        <aside class="manage-sidebar">
          <div class="side-card">
            <h3>Manage Booking</h3>
            <button class="download-btn" type="button" id="downloadBtn" <%=isInactive ? 'disabled' : '' %>>
              Download Confirmation
            </button>
            <button
              class="cancel-btn"
              id="cancelBookingBtn"
              data-event="<%= event && event._id ? event._id : '' %>"
              data-event-id="<%= booking.groupedEventId || (event && event._id ? event._id : '') %>"
              data-grouped="<%= booking.isGroupedBooking ? 'true' : 'false' %>"
              data-booking="<%= booking && booking._id ? booking._id.toString() : '' %>"
              data-count="<%= ticketCount %>"
              <%= isInactive ? 'disabled' : '' %>
            >
              <%= isCancelled ? 'Cancelled' : (isExpired ? 'Expired' : 'Cancel Booking') %>
            </button>
            <p class="side-note">
              <%= isExpired
                ? 'This booking has expired because the event date has already passed.'
                : 'Cancellations are final. No refunds are provided for event bookings.' %>
            </p>
          </div>

        </aside>
      </div>
    </main>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <aside class="avatar-sidebar" id="avatarSidebar">
      <div class="sidebar-user-info">
        Hi, <%= (locals.user && user.username) ? user.username.charAt(0).toUpperCase() + user.username.slice(1) : 'User'
          %>
      </div>

      <div class="sidebar-divider"></div>

      <a href="/profile" class="sidebar-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        My Profile
      </a>

      <div class="sidebar-divider"></div>

      <a href="/logout" class="sidebar-logout" id="logoutBtn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        Log Out
      </a>
    </aside>

    <footer class="footer">
      <span class="footer-copy">COPYRIGHT © 2026 EMS. ALL RIGHTS RESERVED.</span>
      <div class="footer-links">
      <a href="/privacy">PRIVACY POLICY</a>
      <a href="/terms">TERMS OF SERVICE</a>
      <a href="/contact">CONTACT</a>
    </div>
    </footer>

    <div class="print-tickets" aria-hidden="true">
      <% ticketList.forEach(function(ticketCode, index) { %>
        <% const ticketDetailsUrl=`${printBaseUrl}/tickets/${encodeURIComponent(ticketCode)}`; const
          ticketQrUrl=`https://api.qrserver.com/v1/create-qr-code/?size=1100x1100&margin=28&ecc=M&data=${encodeURIComponent(ticketDetailsUrl)}`;
          %>
          <section class="print-ticket" data-ticket-index="<%= index %>" data-ticket-code="<%= ticketCode %>">
            <div class="print-ticket-header">
              <div class="print-ticket-qr-wrap">
                <img class="print-ticket-qr" src="<%= ticketQrUrl %>" alt="Ticket QR code" />
                <p class="print-ticket-scan">Scan QR code for full ticket details</p>
              </div>
              <div class="print-ticket-main">
                <p class="print-ticket-label">TICKET</p>
                <h2 class="print-ticket-title">
                  <%= eventName %>
                </h2>
                <p class="print-ticket-meta">
                  <%= eventDate %>
                </p>
                <p class="print-ticket-meta">
                  <%= eventTime %>
                </p>
                <p class="print-ticket-meta">Attendee: <%= attendeeNames[index] || (index===0 ? booking.userName : '-' )
                    || '-' %>
                </p>
              </div>
              <div class="print-ticket-id">
                <span>Ticket <%= index + 1 %> of <%= ticketList.length %></span>
              </div>
            </div>
            <div class="print-ticket-banner">
              <img src="<%= eventImage %>" alt="<%= eventName %> event banner" />
            </div>
          </section>
          <% }); %>
    </div>

    <div class="confirm-modal" id="confirmModal" aria-hidden="true">
      <div class="confirm-backdrop" data-close="true"></div>
      <div class="confirm-card" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
        <h3 id="confirmTitle">Download Confirmation</h3>
        <p class="confirm-subtitle">
          Review the ticket details for <strong>
            <%= eventName %>
          </strong> before saving.
        </p>
        <div class="confirm-details">
          <div class="detail-row">
            <span>Event</span>
            <strong>
              <%= eventName %>
            </strong>
          </div>
          <div class="detail-row">
            <span>Date</span>
            <strong>
              <%= eventDate %>
            </strong>
          </div>
          <div class="detail-row">
            <span>Time</span>
            <strong>
              <%= eventTime %>
            </strong>
          </div>
          <div class="detail-row">
            <span>Location</span>
            <strong>
              <%= eventLocation %>
            </strong>
          </div>
          <div class="detail-row">
            <span>Tickets</span>
            <strong>
              <%= ticketCount %>
            </strong>
          </div>
          <div class="detail-row">
            <span>Price / Ticket</span>
            <strong>
              <%= unitPriceDisplay %>
            </strong>
          </div>
          <div class="detail-row">
            <span>Total</span>
            <strong>
              <%= totalDisplay %>
            </strong>
          </div>
          <div class="detail-divider"></div>
          <div class="detail-row">
            <span>Attendees</span>
            <strong>
              <%= attendeeNamesDisplay %>
            </strong>
          </div>
          <div class="detail-row">
            <span>Email</span>
            <strong>
              <%= attendeeEmail %>
            </strong>
          </div>
          <div class="detail-row detail-full">
            <span>
              <%= ticketIdLabel %>
            </span>
            <strong class="detail-codes">
              <%= ticketCodesDisplay %>
            </strong>
          </div>
          <div class="detail-row">
            <span>Reference</span>
            <strong>
              <%= booking.referenceNumber || '-' %>
            </strong>
          </div>
        </div>
        <div class="confirm-actions">
          <button class="ghost-btn" type="button" id="confirmCancel">Cancel</button>
          <button class="primary-btn" type="button" id="confirmSave">Save</button>
        </div>
      </div>
    </div>

    <div class="confirm-modal" id="cancelModal" aria-hidden="true">
      <div class="confirm-backdrop" data-close="true"></div>
      <div class="confirm-card" role="dialog" aria-modal="true" aria-labelledby="cancelTitle">
        <h3 id="cancelTitle">Cancel Booking</h3>
        <p class="confirm-subtitle">
          Choose how many tickets to cancel. Cancelling all tickets will cancel the booking.
        </p>
        <div class="confirm-details">
          <div class="detail-row">
            <span>Tickets booked</span>
            <strong id="cancelTotalTickets">
              <%= ticketCount %>
            </strong>
          </div>
          <div class="detail-row">
            <span>Cancel tickets</span>
            <input
              id="cancelTicketCount"
              class="confirm-input"
              type="text"
              inputmode="numeric"
              autocomplete="off"
              maxlength="3"
              value=""
              placeholder=""
            />
          </div>
        </div>
        <div id="cancelTicketSelector" style="display:none; margin-top: 10px; max-height: 170px; overflow-y: auto; border: 1px solid #e6dfd8; border-radius: 10px; padding: 10px;">
        </div>
        <p class="cancel-warning" id="cancelWarning" style="display:none;">
          Are you sure you want to cancel these tickets? This action cannot be undone.
        </p>
        <div class="confirm-actions">
          <button class="ghost-btn" type="button" id="cancelModalNo">Keep Booking</button>
          <button class="primary-btn" type="button" id="cancelModalYes">Cancel Booking</button>
        </div>
      </div>
    </div>

    <script>
      const downloadBtn = document.getElementById('downloadBtn');
      const confirmModal = document.getElementById('confirmModal');
      const confirmCancel = document.getElementById('confirmCancel');
      const confirmSave = document.getElementById('confirmSave');
      const printTickets = Array.from(document.querySelectorAll('.print-ticket'));
      const clearPrintSelection = () => {
        document.body.classList.remove('print-selection');
        printTickets.forEach((ticket) => ticket.classList.remove('print-selected'));
      };
      const closeModal = () => {
        confirmModal.classList.remove('open');
        confirmModal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('modal-open');
      };
      const openModal = () => {
        clearPrintSelection();
        confirmModal.classList.add('open');
        confirmModal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('modal-open');
      };
      if (downloadBtn && !downloadBtn.disabled) downloadBtn.addEventListener('click', openModal);
      if (confirmCancel) confirmCancel.addEventListener('click', closeModal);
      if (confirmSave) {
        confirmSave.addEventListener('click', () => {
          window.print();
          closeModal();
        });
      }
      if (window && window.addEventListener) {
        window.addEventListener('afterprint', clearPrintSelection);
      }
      if (confirmModal) {
        confirmModal.addEventListener('click', (event) => {
          if (event.target && event.target.dataset && event.target.dataset.close === 'true') {
            closeModal();
          }
        });
      }

      const cancelModal = document.getElementById('cancelModal');
      const cancelModalNo = document.getElementById('cancelModalNo');
      const cancelModalYes = document.getElementById('cancelModalYes');
      const cancelTicketCountInput = document.getElementById('cancelTicketCount');
      const cancelTotalTickets = document.getElementById('cancelTotalTickets');
      const cancelTicketSelector = document.getElementById('cancelTicketSelector');
      const cancelWarning = document.getElementById('cancelWarning');
      const cancelBtn = document.getElementById('cancelBookingBtn');
      const cancelTicketRows = <%- JSON.stringify(cancelTicketRows) %>;
      let cancelConfirmArmed = false;
      const getSelectedTicketCodes = () => {
        if (!cancelTicketSelector) return [];
        return Array.from(cancelTicketSelector.querySelectorAll('input[type="checkbox"]:checked'))
          .map((el) => String(el.value || '').trim())
          .filter(Boolean);
      };
      const renderCancelTicketOptions = () => {
        if (!cancelTicketSelector) return;
        const cancelCount = getCancelCount() || 0;
        if (!cancelCount) {
          cancelTicketSelector.innerHTML = '';
          cancelTicketSelector.style.display = 'none';
          return;
        }
        cancelTicketSelector.style.display = 'block';
        cancelTicketSelector.innerHTML = `
          <p style="margin:0 0 8px; font-size:12px; color:#595766; font-weight:600;">Select ${cancelCount} attendee name${cancelCount > 1 ? 's' : ''} to cancel</p>
          ${cancelTicketRows.map((row) => `
            <label style="display:flex; align-items:center; gap:8px; margin:0 0 6px; font-size:13px; color:#242333;">
              <input type="checkbox" value="${String(row.code || '').replace(/"/g, '&quot;')}" />
              <span>${row.attendeeName} · ${row.code}</span>
            </label>
          `).join('')}
        `;
        const checkboxes = Array.from(cancelTicketSelector.querySelectorAll('input[type="checkbox"]'));
        checkboxes.forEach((checkbox) => {
          checkbox.addEventListener('change', () => {
            const selected = checkboxes.filter((item) => item.checked);
            if (selected.length > cancelCount) checkbox.checked = false;
            updateCancelButtonLabel();
          });
        });
      };
      const getTotalTickets = () => {
        if (cancelBtn) {
          const fromDataset = Number.parseInt(cancelBtn.dataset.count || '', 10);
          if (Number.isInteger(fromDataset) && fromDataset > 0) return fromDataset;
        }
        if (cancelTotalTickets) {
          const fromLabel = Number.parseInt(cancelTotalTickets.textContent || '', 10);
          if (Number.isInteger(fromLabel) && fromLabel > 0) return fromLabel;
        }
        return 0;
      };
      const getCancelCount = () => {
        if (!cancelTicketCountInput || !cancelBtn) return null;
        const totalTickets = getTotalTickets();
        const rawValue = cancelTicketCountInput.value.trim();
        if (!/^[1-9]\d*$/.test(rawValue)) return null;
        return Math.min(parseInt(rawValue, 10), totalTickets);
      };
      const updateCancelButtonLabel = () => {
        if (!cancelModalYes || !cancelBtn) return;
        const totalTickets = getTotalTickets();
        const value = getCancelCount();
        if (!value) {
          cancelModalYes.textContent = 'Cancel Ticket';
          return;
        }
        cancelModalYes.textContent =
          value >= totalTickets ? 'Cancel Booking' : `Cancel ${value} Ticket${value > 1 ? 's' : ''}`;
      };
      const openCancelModal = () => {
        if (!cancelModal) return;
        cancelConfirmArmed = false;
        if (cancelWarning) cancelWarning.style.display = 'none';
        if (cancelModalYes) cancelModalYes.textContent = 'Cancel Ticket';
          if (cancelBtn) {
            const totalTickets = getTotalTickets();
            if (cancelTotalTickets) cancelTotalTickets.textContent = totalTickets;
            if (cancelTicketCountInput) {
              cancelTicketCountInput.value = '';
              cancelTicketCountInput.setAttribute('value', '');
              cancelTicketCountInput.placeholder = '';
            }
            renderCancelTicketOptions();
            updateCancelButtonLabel();
          }
        cancelModal.classList.add('open');
        cancelModal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('modal-open');
      };
      const closeCancelModal = () => {
        if (!cancelModal) return;
        cancelConfirmArmed = false;
        if (cancelWarning) cancelWarning.style.display = 'none';
        if (cancelTicketSelector) {
          cancelTicketSelector.innerHTML = '';
          cancelTicketSelector.style.display = 'none';
        }
        cancelModal.classList.remove('open');
        cancelModal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('modal-open');
      };
      if (cancelModalNo) cancelModalNo.addEventListener('click', closeCancelModal);
      if (cancelModal) {
        cancelModal.addEventListener('click', (event) => {
          if (event.target && event.target.dataset && event.target.dataset.close === 'true') {
            closeCancelModal();
          }
        });
      }
      if (cancelTicketCountInput && cancelModalYes && cancelBtn) {
        cancelTicketCountInput.addEventListener('input', () => {
          cancelConfirmArmed = false;
          if (cancelWarning) cancelWarning.style.display = 'none';
          const totalTickets = getTotalTickets();
          const digitsOnly = cancelTicketCountInput.value.replace(/\D/g, '');
          if (digitsOnly !== cancelTicketCountInput.value) {
            cancelTicketCountInput.value = digitsOnly;
          }
          if (digitsOnly && parseInt(digitsOnly, 10) > totalTickets) {
            cancelTicketCountInput.value = String(totalTickets);
          }
          renderCancelTicketOptions();
          updateCancelButtonLabel();
        });
      }

      const bellBtn = document.getElementById('bellBtn');
      const bellDropdown = document.getElementById('bellDropdown');
      if (bellBtn && bellDropdown) {
        bellBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = bellDropdown.style.display === 'block';
          bellDropdown.style.display = isOpen ? 'none' : 'block';
        });
        document.addEventListener('click', () => {
          bellDropdown.style.display = 'none';
        });
      }

      const avatar = document.getElementById('profileTrigger') || document.querySelector('.avatar-circle');
      const sidebar = document.getElementById('avatarSidebar');
      const overlay = document.getElementById('sidebarOverlay');
      const toggleSidebar = (state) => {
        if (sidebar) sidebar.classList.toggle('open', state);
        if (overlay) overlay.classList.toggle('open', state);
      };
      if (avatar) avatar.addEventListener('click', () => toggleSidebar(true));
      if (overlay) overlay.addEventListener('click', () => toggleSidebar(false));

      const logoutBtn = document.getElementById('logoutBtn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', (e) => {
          // direct logout
        });
      }

      if (cancelBtn && !cancelBtn.disabled) {
        cancelBtn.addEventListener('click', async () => {
          openCancelModal();
        });
      }

      if (cancelModalYes && cancelBtn) {
        cancelModalYes.addEventListener('click', async () => {
          const bookingId = cancelBtn.dataset.booking;
          if (!bookingId) return;
          const cancelCount = getCancelCount();
          if (!cancelCount) {
            if (cancelWarning) {
              cancelWarning.textContent = 'Please enter how many tickets you want to cancel.';
              cancelWarning.style.display = 'block';
            }
            cancelTicketCountInput?.focus();
            return;
          }
          const selectedTicketCodes = getSelectedTicketCodes();
          if (selectedTicketCodes.length !== cancelCount) {
            if (cancelWarning) {
              cancelWarning.textContent = `Please select exactly ${cancelCount} attendee name${cancelCount > 1 ? 's' : ''} to cancel.`;
              cancelWarning.style.display = 'block';
            }
            return;
          }
          if (!cancelConfirmArmed) {
            cancelConfirmArmed = true;
            if (cancelWarning) {
              cancelWarning.textContent = `Are you sure you want to cancel ${cancelCount} selected ticket${cancelCount > 1 ? 's' : ''}? This action cannot be undone.`;
              cancelWarning.style.display = 'block';
            }
            cancelModalYes.textContent = 'Yes, Cancel';
            return;
          }
          try {
            const response = await fetch(`/bookings/cancel-booking/${bookingId}`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify({
                cancelCount,
                selectedTicketCodes,
                grouped: cancelBtn.dataset.grouped === 'true',
                eventId: cancelBtn.dataset.eventId || ''
              })
            });
            if (response.redirected && response.url && response.url.includes('/login')) {
              window.location.href = '/login';
              return;
            }
            const contentType = response.headers.get('content-type') || '';
            const data = contentType.includes('application/json')
              ? await response.json()
              : { success: false, message: await response.text() };
            if (!response.ok || !data.success) {
              alert(data.message || 'Unable to cancel booking.');
              return;
            }
            if (data.success) {
              if (data.status === 'cancelled' || data.remainingTickets === 0) {
                window.location.href = '/bookings';
              } else {
                window.location.href = `/bookings/manage/${bookingId}`;
              }
            }
          } catch (err) {
            alert('Unable to cancel booking.');
          } finally {
            closeCancelModal();
          }
        });
      }
    </script>
</body>

</html>