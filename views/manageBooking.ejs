<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Bookings - EMS</title>
    <link rel="stylesheet" href="/css/manageBooking.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <!-- ========== NAVBAR ========== -->
    <header class="navbar">
        <div class="nav-inner">
            <a href="/dashboard" class="nav-logo">EMS</a>

            <nav class="nav-links">
                <a href="/events">Events</a>
                <a href="/bookings/my-bookings" class="active">My Bookings</a>
                <button class="nav-link-btn" type="button">Profile</button>
            </nav>

            <div class="nav-actions">
                <button class="icon-btn" title="Search">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                </button>
                <button class="icon-btn" title="Notifications">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                </button>
                <div class="avatar-circle" title="<%= user.username %>">
                    <%= user.username ? user.username.charAt(0).toUpperCase() : 'U' %>
                </div>
            </div>
        </div>
    </header>

    <!-- ========== MAIN CONTENT ========== -->
    <main class="page-wrapper">
        <% const event = booking && booking.event ? booking.event : null; %>
        <% const hasEvent = Boolean(event); %>
        <% const eventName = hasEvent && event.name ? event.name : 'Event Removed'; %>
        <% const eventLocation = hasEvent && event.location ? event.location : 'Venue to be announced'; %>
        <% const eventTier = hasEvent && event.tier ? event.tier : 'Standard'; %>
        <% const eventDescription = hasEvent && event.description ? event.description : 'No description available for this event.'; %>
        <% const eventImage = hasEvent && event.image ? event.image : null; %>
        <% const eventId = hasEvent && event._id ? event._id : null; %>
        <% const eventDateObj = hasEvent && event.date ? new Date(event.date) : null; %>
        <% const eventDateLabel = eventDateObj && !isNaN(eventDateObj.getTime())
            ? eventDateObj.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
            : 'TBA'; %>
        <% const eventTimeLabel = hasEvent && event.time ? event.time + ' CET' : ''; %>

        <a href="/bookings/my-bookings" class="back-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5"/><path d="m12 5-7 7 7 7"/></svg>
            BACK TO MY BOOKINGS
        </a>

        <!-- Flash Messages -->
        <% if (typeof error !== 'undefined' && error.length > 0) { %>
            <div class="flash-error"><%= error[0] %></div>
        <% } %>

        <div class="booking-layout">

            <!-- ===== LEFT COLUMN ===== -->
            <section class="booking-main">

                <!-- Event Image -->
                <div class="event-image-wrap">
                    <% if (eventImage) { %>
                        <img src="<%= eventImage %>" alt="<%= eventName %>" class="event-img">
                    <% } else { %>
                        <div class="event-img-placeholder">
                            <div class="placeholder-pattern"></div>
                            <div class="placeholder-text"><%= eventName %></div>
                        </div>
                    <% } %>
                    <span class="status-badge status-<%= booking.status %>">
                        <%= booking.status.toUpperCase() %>
                    </span>
                </div>

                <!-- Event Details Grid -->
                <div class="details-grid">
                    <div class="detail-block">
                        <span class="detail-label">EVENT NAME</span>
                        <span class="detail-value bold"><%= eventName %></span>
                    </div>

                    <div class="detail-block">
                        <span class="detail-label">LOCATION</span>
                        <span class="detail-value">
                            <%= eventLocation %>
                            <% if (hasEvent && event.location) { %>
                                <span class="map-link map-link--disabled">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    View on map
                                </span>
                            <% } %>
                        </span>
                    </div>

                    <div class="detail-block">
                        <span class="detail-label">DATE & TIME</span>
                        <span class="detail-value">
                            <%= eventDateLabel %>
                            <% if (eventTimeLabel) { %><br><span class="time-text"><%= eventTimeLabel %></span><% } %>
                        </span>
                    </div>

                    <div class="detail-block">
                        <span class="detail-label">BOOKING TIER</span>
                        <span class="detail-value tier-value">
                            <%= eventTier %>
                            <svg class="verified-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        </span>
                    </div>
                </div>

                <!-- Attendee Information -->
                <div class="info-card attendee-section">
                    <h3 class="section-label">ATTENDEE INFORMATION</h3>
                    <div class="attendee-grid">
                        <div class="attendee-item">
                            <span class="att-label">Full Name</span>
                            <span class="att-value"><%= user.username %></span>
                        </div>
                        <div class="attendee-item">
                            <span class="att-label">Email Address</span>
                            <span class="att-value"><%= user.email %></span>
                        </div>
                    </div>
                </div>

                <!-- About the Event -->
                <div class="about-section">
                    <h3 class="section-label">ABOUT THE EVENT</h3>
                    <p class="about-text">
                        <%= eventDescription %>
                    </p>
                    <% if (eventId) { %>
                        <a href="/events/<%= eventId %>" class="view-full-link">
                            View Full Event Details
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                        </a>
                    <% } %>
                </div>

                <!-- Map Section -->
                <div class="map-placeholder-box">
                    <div class="map-placeholder-top">
                        <span class="map-pill">Map Preview</span>
                    </div>
                    <div class="map-art">
                        <div class="map-pin"></div>
                    </div>
                    <div class="map-placeholder-bottom">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        <span><%= eventLocation %></span>
                    </div>
                </div>

            </section>

            <!-- ===== RIGHT SIDEBAR ===== -->
            <aside class="booking-sidebar">

                <!-- Manage Booking Card -->
                <% const statusValue = (booking.status || '').toString().trim().toLowerCase(); %>
                <% const isCancelled = statusValue === 'cancelled' || statusValue === 'canceled'; %>
                <div class="sidebar-card">
                    <h3 class="sidebar-title">Manage Booking</h3>

                    <button class="btn-download <%= isCancelled ? 'btn-download--disabled' : '' %>" type="button" <%= isCancelled ? 'disabled aria-disabled="true"' : 'onclick="showDownloadModal()"' %>>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        Download Confirmation
                    </button>

                    <% if (!isCancelled) { %>
                    <div class="cancel-section">
                        <button class="btn-cancel-booking" onclick="showCancelModal()">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                            Cancel Booking
                        </button>
                        <p class="cancel-note">Cancellations are subject to the event terms and conditions. A 10% processing fee may apply.</p>
                    </div>
                    <% } else { %>
                    <div class="cancelled-notice">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                        This booking has been cancelled.
                    </div>
                    <% } %>
                </div>

                <!-- Assistance Card -->
                <div class="sidebar-card assistance-card">
                    <h4 class="assist-title">Need assistance?</h4>
                    <p class="assist-text">Our support curators are available 24/7 for VIP and Front Row tier members.</p>
                    <span class="contact-link contact-link--disabled">Contact Concierge</span>
                </div>

            </aside>

        </div><!-- /.booking-layout -->

    </main>

    <!-- ========== CANCEL MODAL ========== -->
    <div id="cancelModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="cancelModalTitle">
        <div class="modal-box">
            <h2 id="cancelModalTitle" class="modal-title">Cancel Booking?</h2>
            <p class="modal-body">
                Are you sure you want to cancel your booking for
                <strong><%= eventName %></strong>?
            </p>

            <div class="modal-actions">
                <button class="btn-keep" onclick="closeCancelModal()">Keep Booking</button>
                <button class="btn-confirm-cancel" onclick="confirmCancel('<%= booking._id %>')">
                    <span id="cancelBtnText">Yes, Cancel</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ========== DOWNLOAD CONFIRMATION MODAL ========== -->
    <div id="downloadModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="downloadModalTitle"
        data-event="<%= eventName %>"
        data-date="<%= eventDateLabel %>"
        data-time="<%= eventTimeLabel %>"
        data-location="<%= eventLocation %>"
        data-user-id="<%= user && user._id ? user._id : 'N/A' %>"
        data-booking-ref="<%= booking.bookingRef %>"
        data-status="<%= booking.status %>">
        <div class="modal-box">
            <h2 id="downloadModalTitle" class="modal-title">Download Confirmation</h2>
            <p class="modal-body">
                Review the details for <strong><%= eventName %></strong> before saving.
            </p>

            <div class="download-details">
                <div class="download-row">
                    <span class="download-label">Event</span>
                    <span class="download-value"><%= eventName %></span>
                </div>
                <div class="download-row">
                    <span class="download-label">Date</span>
                    <span class="download-value"><%= eventDateLabel %></span>
                </div>
                <% if (eventTimeLabel) { %>
                <div class="download-row">
                    <span class="download-label">Time</span>
                    <span class="download-value"><%= eventTimeLabel %></span>
                </div>
                <% } %>
                <div class="download-row">
                    <span class="download-label">Location</span>
                    <span class="download-value"><%= eventLocation %></span>
                </div>
                <div class="download-row">
                    <span class="download-label">User ID</span>
                    <span class="download-value"><%= user && user._id ? user._id : 'N/A' %></span>
                </div>
            </div>

            <div class="modal-actions">
                <button class="btn-keep" onclick="closeDownloadModal()">Cancel</button>
                <button class="btn-primary" type="button" onclick="saveTicket()">Save</button>
            </div>
        </div>
    </div>

    <!-- ========== FOOTER ========== -->
    <footer class="page-footer">
        <span class="footer-copy">COPYRIGHT 2026 EMS MANAGEMENT</span>
        <div class="footer-links">
            <a href="#">PRIVACY POLICY</a>
            <a href="#">TERMS OF SERVICE</a>
            <a href="#">CONTACT</a>
        </div>
    </footer>

    <script src="/js/manageBooking.js"></script>

</body>
</html>
