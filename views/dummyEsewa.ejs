<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dummy Payment Sandbox</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/dummyEsewa.css" />
  </head>
  <body>
    <main class="gateway-shell">
      <header class="gateway-header">
        <div class="brand-mark">e</div>
        <span>Sandbox Wallet</span>
      </header>

      <section class="gateway-panel">
        <aside class="payment-summary">
          <div class="merchant">
            <div class="brand-mark small">e</div>
            <strong><%= payment.product_code %></strong>
          </div>
          <p>Total Amount</p>
          <h1>NPR. <%= Number(payment.total_amount).toFixed(2) %></h1>
          <dl>
            <div>
              <dt>Product Code</dt>
              <dd><%= payment.product_code %></dd>
            </div>
            <div>
              <dt>Transaction</dt>
              <dd><%= payment.transaction_uuid %></dd>
            </div>
          </dl>
        </aside>

        <div class="auth-card">
          <% if (error) { %>
            <p class="message error"><%= error %></p>
          <% } %>
          <% if (success) { %>
            <p class="message success"><%= success %></p>
          <% } %>

          <% if (mode === "register") { %>
            <% const pending = typeof pendingRegistration !== "undefined" ? pendingRegistration : null; %>
            <p class="eyebrow">Dummy Wallet</p>
            <h2><%= pending ? "Verify phone OTP" : "Register your phone" %></h2>
            <form action="/dummy-esewa/register" method="POST" class="gateway-form">
              <% if (pending) { %>
                <div class="wallet-box compact">
                  <span>Phone Number</span>
                  <strong><%= pending.esewaId %></strong>
                </div>
                <p class="otp-hint">Generated demo OTP: <strong><%= pending.otp %></strong></p>

                <label for="otp">OTP</label>
                <input id="otp" name="otp" type="tel" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="Enter generated OTP" required />

                <button type="submit">Verify and Continue</button>
              <% } else { %>
                <label for="esewaId">Phone Number</label>
                <input id="esewaId" name="esewaId" type="tel" inputmode="numeric" pattern="(97|98)[0-9]{8}" placeholder="98XXXXXXXX" required />

                <label for="pin">Create 4 Digit PIN</label>
                <input id="pin" name="pin" type="password" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" placeholder="4 digit PIN" required />

                <button type="submit">Send OTP</button>
              <% } %>
            </form>
            <% if (pending) { %>
              <p class="switch-copy"><a href="/dummy-esewa/register?reset=1">Use another phone number</a></p>
            <% } %>
            <p class="switch-copy">Already registered? <a href="/dummy-esewa/auth">Login</a></p>
          <% } else if (mode === "dashboard") { %>
            <p class="eyebrow">Dashboard</p>
            <h2>Payment dashboard</h2>
            <div class="wallet-box">
              <span>Wallet Number</span>
              <strong><%= wallet ? wallet.esewaId : "Not registered" %></strong>
            </div>
            <form action="/dummy-esewa/pay" method="POST" class="gateway-form">
              <button type="submit">Pay NPR. <%= Number(payment.total_amount).toFixed(2) %></button>
            </form>
            <form action="/dummy-esewa/cancel" method="POST">
              <button type="submit" class="ghost-btn">Cancel Payment</button>
            </form>
          <% } else { %>
            <p class="eyebrow">Sandbox Login</p>
            <h2>Sign in with dummy PIN</h2>
            <form action="/dummy-esewa/login" method="POST" class="gateway-form">
              <label for="loginEsewaId">Wallet Number</label>
              <input
                id="loginEsewaId"
                name="esewaId"
                type="tel"
                inputmode="numeric"
                pattern="[0-9]{10}"
                value="<%= wallet ? wallet.esewaId : "" %>"
                placeholder="98XXXXXXXX"
                required
              />

              <label for="loginPin">PIN</label>
              <input id="loginPin" name="pin" type="password" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" placeholder="4 digit PIN" required />

              <button type="submit">Login</button>
            </form>
            <p class="switch-copy">Don't have a dummy wallet? <a href="/dummy-esewa/register">Register</a></p>
          <% } %>
        </div>
      </section>

      <p class="sandbox-note">College project dummy payment testing only. No live payment is used.</p>
    </main>
  </body>
</html>
