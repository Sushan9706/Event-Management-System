<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= venue.venueName %> - EMS Venues</title>
    <link rel="stylesheet" href="/css/venueDetail.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

    <header class="navbar">
        <div class="logo">EMS</div>
        <nav>
            <a href="/user">Home</a>
            <a href="/catalog">Events</a>
            <a href="/venue">Venues</a>
            <% if (user) { %>
                <a href="/bookings">My Bookings</a>
                <a href="/logout" class="btn-logout-nav">Logout</a>
            <% } else { %>
                <a href="/login" class="btn-login-nav">Login</a>
            <% } %>
        </nav>
    </header>

    <div class="venue-hero" <% if (venue.imagePath || venue.image) { %>style="background-image: url('<%= venue.imagePath || venue.image %>')"<% } %>>
        <div class="hero-overlay">
            <div class="hero-content">
                <span class="venue-status"><%= venue.status || 'Available' %></span>
                <h1><%= venue.venueName %></h1>
            </div>
        </div>
    </div>

    <main class="venue-main">

        <div class="venue-info-bar">
            <div class="info-box">
                <span class="info-label">LOCATION</span>
                <span class="info-value"><%= venue.location %></span>
            </div>
            <div class="info-box">
                <span class="info-label">CAPACITY</span>
                <span class="info-value"><%= venue.capacity %> Guests</span>
            </div>
            <div class="info-box highlight">
                <span class="info-label">BASE RATE</span>
                <span class="info-value price">
                    $<%= venue.pricePerHour %>/hr
                </span>
            </div>
        </div>

        <div class="venue-body">
            <div class="venue-description">
                <h2>About This Venue</h2>
                <p><%= venue.description || 'Experience the perfect blend of elegance and functionality at ' + venue.venueName + '. Ideal for both intimate gatherings and large-scale celebrations, this space offers modern amenities in a prime location.' %></p>

                <div class="amenities">
                    <div class="amenity-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        Professional Staff
                    </div>
                    <div class="amenity-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                        AV Equipment
                    </div>
                    <div class="amenity-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0"></path><path d="M1.42 9a16 16 0 0 1 21.16 0"></path><path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path><line x1="12" y1="20" x2="12.01" y2="20"></line></svg>
                        High-speed WiFi
                    </div>
                    <div class="amenity-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        Flexible Hours
                    </div>
                </div>
            </div>

            <div class="booking-panel">
                <div class="booking-card">
                    <h3>Inquiry & Booking</h3>
                    <div class="price-display">
                        <span class="price-amount">$<%= venue.pricePerHour %></span>
                        <span class="price-per">starting per hour</span>
                    </div>

                    <% if (venue.status === 'available' && user) { %>
                        <div class="booking-inputs" style="margin-bottom: 20px;">
                            <label style="display: block; font-size: 11px; color: var(--muted); margin-bottom: 5px;">SELECT DATE</label>
                            <input type="date" id="bookingDate" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; margin-bottom: 10px;">
                            
                            <div style="display: flex; gap: 10px;">
                                <div style="flex: 1;">
                                    <label style="display: block; font-size: 11px; color: var(--muted); margin-bottom: 5px;">START TIME</label>
                                    <input type="time" id="startTime" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px;">
                                </div>
                                <div style="flex: 1;">
                                    <label style="display: block; font-size: 11px; color: var(--muted); margin-bottom: 5px;">END TIME</label>
                                    <input type="time" id="endTime" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px;">
                                </div>
                            </div>
                        </div>
                        <button class="book-btn" id="confirmBookingBtn">Confirm Booking</button>
                    <% } else if (!user) { %>
                        <a href="/login" class="book-btn" style="text-align: center; text-decoration: none; display: block;">Login to Book</a>
                    <% } else { %>
                        <button class="book-btn unavailable" disabled>Currently Unavailable</button>
                    <% } %>

                    <script>
                        document.getElementById('confirmBookingBtn')?.addEventListener('click', async () => {
                            const bookingDate = document.getElementById('bookingDate').value;
                            const startTime = document.getElementById('startTime').value;
                            const endTime = document.getElementById('endTime').value;

                            if (!bookingDate || !startTime || !endTime) {
                                alert('Please fill all booking details.');
                                return;
                            }

                            try {
                                const response = await fetch('/venue/book', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        venueId: '<%= venue._id %>',
                                        bookingDate,
                                        startTime,
                                        endTime
                                    })
                                });

                                const data = await response.json();
                                if (data.success) {
                                    alert('Venue booked successfully!');
                                    window.location.href = '/venue/my-bookings';
                                } else {
                                    alert(data.message || 'Booking failed.');
                                }
                            } catch (err) {
                                console.error(err);
                                alert('An error occurred. Please try again.');
                            }
                        });
                    </script>

                    <div class="contact-box">
                        <p class="contact-title">DIRECT CONTACT</p>
                        <p class="contact-info"><%= venue.contactInfo || 'contact@ems-venues.com' %></p>
                    </div>
                    
                    <p class="secure-note">Dedicated support for your venue needs</p>
                </div>
            </div>
        </div>

    </main>

    <footer class="footer">
        <div class="footer-left">COPYRIGHT &copy; 2026 EMS. ALL RIGHTS RESERVED.</div>
        <div class="footer-right">
            <a href="#">TERMS</a>
            <a href="#">PRIVACY</a>
            <a href="#">SUPPORT</a>
        </div>
    </footer>

</body>
</html>
