<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= venue.name %> - EMS Venues</title>
    <link rel="stylesheet" href="/css/venueDetail.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <div id="notificationToast" class="notification-toast">
        <span class="notification-icon" id="notifIcon"></span>
        <span class="notification-message" id="notifMessage"></span>
    </div>

    <header class="navbar">
      <a href="<%= locals.user ? (locals.user.role === 'admin' ? '/admin/dashboard' : '/user') : '/guest' %>" class="logo" style="text-decoration: none; color: inherit;">EMS</a>
      <nav class="nav-links">
        <a href="/user" class="nav-link <%= path === '/user' ? 'active' : '' %>">Home</a>
        <a href="/catalog" class="nav-link <%= path === '/catalog' ? 'active' : '' %>">Events</a>
        <a href="/venue" class="nav-link <%= path === '/venue' ? 'active' : '' %>">Venues</a>
        <a href="/bookings" class="nav-link <%= path === '/bookings' ? 'active' : '' %>">My Bookings</a>
      </nav>
      <div class="nav-icons">
        <% if (locals.user) { %>
        <button class="icon-btn" aria-label="Notifications" id="notifBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
          </svg>
          <% if (locals.notifications && notifications.length > 0) { %>
            <span class="notif-dot"></span>
          <% } %>
        </button>
        <div class="avatar" id="profileTrigger" style="cursor: pointer">
          <img
            src="<%= (locals.user && user.profileImage) ? user.profileImage : 'https://ui-avatars.com/api/?name=' + (locals.user ? (user.username || 'User') : 'User') + '&background=e74c3c&color=fff' %>"
            alt="User avatar"
            onerror="this.style.display='none'"
          />
        </div>
        <% } else { %>
          <a href="/login" class="login-link">Login</a>
        <% } %>
      </div>
    </header>

    <div class="venue-hero" <% if (venue.imagePath || venue.image) { %>style="background-image: url('<%= venue.imagePath || venue.image %>')"<% } %>>
        <div class="hero-overlay">
            <div class="hero-content">
                <span class="venue-status"><%= venue.status || 'Available' %></span>
                <h1><%= venue.name %></h1>
            </div>
        </div>
    </div>

    <main class="venue-main">

        <div class="venue-info-bar">
            <div class="info-box">
                <span class="info-label">LOCATION</span>
                <span class="info-value"><%= venue.location %></span>
            </div>
            <div class="info-box">
                <span class="info-label">CAPACITY</span>
                <span class="info-value"><%= venue.capacity %> Guests</span>
            </div>
            <div class="info-box highlight">
                <span class="info-label">BASE RATE</span>
                <span class="info-value price">
                    NPR. <%= venue.dailyRate || venue.hourlyRate || 0 %>/<%= venue.dailyRate ? 'day' : 'hr' %>
                </span>
            </div>
        </div>

        <div class="venue-body">
            <div class="venue-sidebar">
                <div class="availability-calendar-container">
                    <label class="section-label">AVAILABILITY CALENDAR</label>
                    <div class="calendar-header">
                        <button type="button" id="prevMonth">&lt;</button>
                        <h4 id="currentMonthYear">May 2026</h4>
                        <button type="button" id="nextMonth">&gt;</button>
                    </div>
                    <div class="calendar-grid" id="calendarGrid">
                        <!-- Days injected by JS -->
                    </div>
                    <div class="calendar-legend">
                        <div class="legend-item"><span class="dot available"></span> Available</div>
                        <div class="legend-item"><span class="dot booked"></span> Booked</div>
                    </div>
                </div>
            </div>

            <div class="venue-description">
                <h2>About This Venue</h2>
                <p><%= venue.description || 'Experience the perfect blend of elegance and functionality at ' + venue.name + '. Ideal for both intimate gatherings and large-scale celebrations, this space offers modern amenities in a prime location.' %></p>

                <div class="amenities">
                    <div class="amenity-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        Professional Staff
                    </div>
                    <div class="amenity-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                        AV Equipment
                    </div>
                    <div class="amenity-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0"></path><path d="M1.42 9a16 16 0 0 1 21.16 0"></path><path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path><line x1="12" y1="20" x2="12.01" y2="20"></line></svg>
                        High-speed WiFi
                    </div>
                    <div class="amenity-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        Flexible Hours
                    </div>
                </div>
            </div>

            <div class="booking-panel">
                <div class="booking-card">
                    <h3>Inquiry & Booking</h3>
                    <div class="price-display">
                        <span class="price-amount">NPR. <%= venue.dailyRate || venue.hourlyRate || 0 %></span>
                        <span class="price-per">starting per <%= venue.dailyRate ? 'day' : 'hour' %></span>
                    </div>

                    <% if (venue.status === 'available' && user) { %>
                        <div class="booking-inputs-grid">
                            <div class="input-group">
                                <label>START DATE</label>
                                <input type="date" id="startDate">
                            </div>
                            <div class="input-group">
                                <label>START TIME</label>
                                <input type="time" id="startTime">
                            </div>
                            <div class="input-group">
                                <label>END DATE</label>
                                <input type="date" id="endDate">
                            </div>
                            <div class="input-group">
                                <label>END TIME</label>
                                <input type="time" id="endTime">
                            </div>
                        </div>
                        <button class="book-btn" id="confirmBookingBtn">Confirm Booking</button>
                    <% } else if (!user) { %>
                        <a href="/login" class="book-btn" style="text-align: center; text-decoration: none; display: block;">Login to Book</a>
                    <% } else { %>
                        <button class="book-btn unavailable" disabled>Currently Unavailable</button>
                    <% } %>

                    <script>
                        const bookedDates = <%- bookedDates %>;
                        const calendarGrid = document.getElementById('calendarGrid');
                        const monthYearLabel = document.getElementById('currentMonthYear');
                        const prevBtn = document.getElementById('prevMonth');
                        const nextBtn = document.getElementById('nextMonth');

                        let currentDate = new Date();

                        function getYYYYMMDD(date) {
                            const y = date.getFullYear();
                            const m = String(date.getMonth() + 1).padStart(2, '0');
                            const d = String(date.getDate()).padStart(2, '0');
                            return `${y}-${m}-${d}`;
                        }

                        // Set min date for inputs to today
                        const todayStr = getYYYYMMDD(new Date());
                        const startDateInput = document.getElementById('startDate');
                        const endDateInput = document.getElementById('endDate');
                        if (startDateInput) startDateInput.min = todayStr;
                        if (endDateInput) endDateInput.min = todayStr;

                        startDateInput?.addEventListener('change', (e) => {
                            if (endDateInput) endDateInput.min = e.target.value;
                            if (endDateInput && endDateInput.value < e.target.value) {
                                endDateInput.value = e.target.value;
                            }
                        });

                        function renderCalendar() {
                            calendarGrid.innerHTML = '';
                            const year = currentDate.getFullYear();
                            const month = currentDate.getMonth();

                            monthYearLabel.textContent = new Date(year, month).toLocaleString('default', { month: 'long', year: 'numeric' });

                            const firstDay = new Date(year, month, 1).getDay();
                            const daysInMonth = new Date(year, month + 1, 0).getDate();

                            ['S', 'M', 'T', 'W', 'T', 'F', 'S'].forEach(day => {
                                const el = document.createElement('div');
                                el.className = 'calendar-day-header';
                                el.textContent = day;
                                calendarGrid.appendChild(el);
                            });

                            for (let i = 0; i < firstDay; i++) {
                                const el = document.createElement('div');
                                el.className = 'calendar-day empty';
                                calendarGrid.appendChild(el);
                            }

                            const today = new Date();
                            today.setHours(0, 0, 0, 0);

                            for (let day = 1; day <= daysInMonth; day++) {
                                const date = new Date(year, month, day);
                                const dateStr = getYYYYMMDD(date);
                                const isPast = date < today;
                                const isBooked = bookedDates.includes(dateStr);
                                
                                const el = document.createElement('div');
                                el.className = 'calendar-day';
                                el.textContent = day;

                                if (isPast) el.classList.add('past');
                                else if (isBooked) {
                                    el.classList.add('booked');
                                    el.title = 'Venue is already booked for this date';
                                }
                                else el.classList.add('available');

                                calendarGrid.appendChild(el);
                            }
                        }

                        prevBtn?.addEventListener('click', () => {
                            currentDate.setMonth(currentDate.getMonth() - 1);
                            renderCalendar();
                        });

                        nextBtn?.addEventListener('click', () => {
                            currentDate.setMonth(currentDate.getMonth() + 1);
                            renderCalendar();
                        });

                        renderCalendar();

                        function showNotification(message, type = 'error') {
                            const toast = document.getElementById('notificationToast');
                            const icon = document.getElementById('notifIcon');
                            const msg = document.getElementById('notifMessage');

                            toast.className = `notification-toast show ${type}`;
                            msg.textContent = message;
                            icon.textContent = type === 'success' ? '✓' : '⚠';

                            setTimeout(() => {
                                toast.classList.remove('show');
                            }, 4000);
                        }

                        document.getElementById('confirmBookingBtn')?.addEventListener('click', async () => {
                            const startDate = document.getElementById('startDate').value;
                            const endDate = document.getElementById('endDate').value;
                            const startTime = document.getElementById('startTime').value;
                            const endTime = document.getElementById('endTime').value;

                            if (!startDate || !endDate || !startTime || !endTime) {
                                showNotification('Please select both start and end dates and times.');
                                return;
                            }

                            const today = new Date();
                            today.setHours(0, 0, 0, 0);
                            if (new Date(startDate) < today) {
                                showNotification('Cannot book a date in the past.');
                                return;
                            }

                            if (new Date(startDate) > new Date(endDate)) {
                                showNotification('Start date cannot be after end date.');
                                return;
                            }

                            try {
                                const response = await fetch('/venue/book', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        venueId: '<%= venue._id %>',
                                        startDate,
                                        endDate,
                                        startTime,
                                        endTime
                                    })
                                });

                                const data = await response.json();
                                if (data.success) {
                                    showNotification('Venue booked successfully!', 'success');
                                    setTimeout(() => {
                                        window.location.href = '/bookings';
                                    }, 1500);
                                } else {
                                    showNotification(data.message || 'Booking failed.');
                                }
                            } catch (err) {
                                console.error(err);
                                showNotification('An error occurred. Please try again.');
                            }
                        });
                    </script>

                    <div class="contact-box">
                        <p class="contact-title">DIRECT CONTACT</p>
                        <p class="contact-info"><%= venue.contactInfo || 'contact@ems-venues.com' %></p>
                    </div>
                    
                    <p class="secure-note">Dedicated support for your venue needs</p>
                </div>
            </div>
        </div>

    </main>

    <% if (locals.user) { %>
    <%
      const notifications = Array.isArray(locals.notifications) ? locals.notifications : [];
      const formatTicketCount = (count) => `${count} ticket${count === 1 ? '' : 's'}`;
      const formatNotifTime = (date) => {
        if (!date) return "Just now";
        const d = new Date(date);
        if (Number.isNaN(d.getTime())) return "Just now";
        return d.toLocaleString("en-US", { month: "short", day: "2-digit", hour: "2-digit", minute: "2-digit" });
      };
    %>
    <div class="notif-dropdown" id="notifDropdown">
      <p class="notif-title">NOTIFICATIONS</p>
      <% if (notifications.length === 0) { %>
        <p class="notif-empty">No new notifications</p>
      <% } else { %>
        <% notifications.forEach(function(note) { 
            const title = note.type === 'booking_cancelled' ? 'Booking Cancelled' : 'Booking Confirmed';
            const eventTitle = note.eventName || 'Event';
            const countLabel = formatTicketCount(note.ticketCount || 1);
            const timeLabel = formatNotifTime(note.createdAt);
        %>
          <div class="notif-item">
            <p class="notif-item-title"><%= title %></p>
            <p class="notif-item-sub"><%= eventTitle %> · <%= countLabel %></p>
            <p class="notif-time"><%= timeLabel %></p>
          </div>
        <% }) %>
      <% } %>
    </div>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <aside class="avatar-sidebar" id="avatarSidebar">
      <div class="sidebar-user-info">
        Hi, <%= (locals.user && user.username) ? user.username.charAt(0).toUpperCase() + user.username.slice(1) : 'Guest' %>
      </div>
      <div class="sidebar-divider"></div>
      <a href="/profile" class="sidebar-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
        My Profile
      </a>
      <div class="sidebar-divider"></div>
      <button class="sidebar-logout" id="logoutBtn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
        Log Out
      </button>
    </aside>

    <script>
      // Notification Dropdown Logic
      const notifBtn = document.getElementById("notifBtn");
      const notifDropdown = document.getElementById("notifDropdown");
      if (notifBtn && notifDropdown) {
        notifBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          notifDropdown.classList.toggle("open");
        });
        document.addEventListener("click", (e) => {
          if (!notifDropdown.contains(e.target) && !notifBtn.contains(e.target)) {
            notifDropdown.classList.remove("open");
          }
        });
      }

      // Sidebar Toggle Logic (taken from dashboard)
      const profileTrigger = document.getElementById("profileTrigger");
      const avatarSidebar = document.getElementById("avatarSidebar");
      const sidebarOverlay = document.getElementById("sidebarOverlay");

      const toggleSidebar = (state) => {
        if (avatarSidebar && sidebarOverlay) {
          if (state) {
            avatarSidebar.classList.add("open");
            sidebarOverlay.classList.add("open");
          } else {
            avatarSidebar.classList.remove("open");
            sidebarOverlay.classList.remove("open");
          }
        }
      };

      if (profileTrigger) {
        profileTrigger.addEventListener("click", () => toggleSidebar(true));
      }
      if (sidebarOverlay) {
        sidebarOverlay.addEventListener("click", () => toggleSidebar(false));
      }

      const logoutBtn = document.getElementById("logoutBtn");
      if (logoutBtn) {
        logoutBtn.addEventListener("click", () => {
          if (confirm("Are you sure you want to log out?")) {
            window.location.href = "/logout";
          }
        });
      }
    </script>
    <% } %>

    <footer class="footer">
        <div class="footer-left">COPYRIGHT &copy; 2026 EMS. ALL RIGHTS RESERVED.</div>
        <div class="footer-right">
            <a href="#">TERMS</a>
            <a href="#">PRIVACY</a>
            <a href="#">SUPPORT</a>
        </div>
    </footer>

</body>
</html>
