<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EMS – My Bookings</title>
  <link rel="stylesheet" href="/css/bookings.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&display=swap"
    rel="stylesheet" />
</head>

<body>
  <% 
    const eventBookings = locals.bookings || [];
    const vBookings = locals.venueBookings || [];
    
    const normalizeStatus = (status) => {
        const value = (status || 'confirmed').toLowerCase(); 
        return ['cancelled', 'expired'].includes(value) ? value : 'confirmed'; 
    };

    // Event counts
    const confirmedCount = eventBookings.filter(b => normalizeStatus(b.status) === 'confirmed').length;
    const expiredCount = eventBookings.filter(b => normalizeStatus(b.status) === 'expired').length;
    const cancelledCount = eventBookings.filter(b => normalizeStatus(b.status) === 'cancelled').length;

    // Venue counts
    const vConfirmedCount = vBookings.filter(b => normalizeStatus(b.status) === 'confirmed').length;
    const vCancelledCount = vBookings.filter(b => normalizeStatus(b.status) === 'cancelled').length;

    const activeStatus = (typeof locals.initialStatus === 'string' && ['cancelled', 'expired'].includes(locals.initialStatus)) ? locals.initialStatus : 'confirmed';
    const notifications = Array.isArray(locals.notifications) ? locals.notifications : [];
    
    const formatTicketCount = (count) => `${count} ticket${count === 1 ? '' : 's'}`;
    const formatNotifTime = (date) => { 
        if (!date) return "Just now";
        const d = new Date(date); 
        if (Number.isNaN(d.getTime())) return "Just now";
        return d.toLocaleString("en-US", { month: "short", day: "2-digit", hour: "2-digit", minute: "2-digit" }); 
    };
    %>
    <header class="navbar">
      <div class="nav-inner">
        <div class="nav-logo">EMS</div>
        <nav class="nav-links">
          <a href="/user" class="nav-item">Home</a>
          <a href="/catalog" class="nav-item">Events</a>
          <a href="/venues" class="nav-item">Venues</a>
          <a href="/bookings" class="nav-item active">My Bookings</a>
        </nav>
        <div class="nav-right">
          <div class="notif-wrap">
            <button class="icon-btn" aria-label="Notifications" id="bellBtn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
              <% if (notifications.some(function(n){ return !n.isRead; })) { %>
                <span class="notif-dot"></span>
                <% } %>
            </button>
            <% var _notifs=Array.isArray(locals.notifications) ? locals.notifications : []; var
              _unread=_notifs.filter(function(n){ return !n.isRead; }).length; var _formatTime=function(date) { if
              (!date) return 'Just now' ; var d=new Date(date); if (Number.isNaN(d.getTime())) return 'Just now' ;
              return d.toLocaleString('en-US', { month: 'short' , day: '2-digit' , hour: '2-digit' , minute: '2-digit'
              }); }; %>
              <div class="notif-dropdown" id="notifDropdown">
                <div style="
                  display: flex;
                  align-items: center;
                  justify-content: space-between;
                  padding: 0 0 10px 0;
                ">
                  <p class="notif-title" style="margin: 0">NOTIFICATIONS</p>
                  <% if (_unread> 0) { %>
                    <button id="markAllReadBtn" onclick="markAllNotificationsRead()" style="
                    font-size: 11px;
                    font-weight: 600;
                    color: #e74c3c;
                    background: none;
                    border: none;
                    cursor: pointer;
                    padding: 0;
                    letter-spacing: 0.03em;
                  ">
                      MARK ALL READ
                    </button>
                    <% } %>
                </div>
                <% if (_notifs.length===0) { %>
                  <p class="notif-empty">No new notifications</p>
                  <% } else { %>
                    <% _notifs.forEach(function(note) { var title='Notification' ; var sub=note.eventName || 'Event' ;
                      var isLink=false; var eventLink=note.link || (note.eventId ? '/event/' + note.eventId : '#' ); var
                      count=note.ticketCount || 1; if (note.type==='booking_confirmed' ) { title='Booking Confirmed' ;
                      sub=(note.eventName || 'Event' ) + ' · ' + count + ' ticket' + (count===1 ? '' : 's' ); } else if
                      (note.type==='booking_cancelled' ) { title='Booking Cancelled' ; sub=(note.eventName || 'Event' )
                      + ' · ' + count + ' ticket' + (count===1 ? '' : 's' ); } else if (note.type==='event_update' ) {
                      title='Event Updated' ; sub=(note.eventName || 'Event' ) + ' details have been updated.' ;
                      isLink=true; } else if (note.type==='event_cancelled' ) { title='Event Cancelled' ;
                      sub=(note.eventName || 'Event' ) + (note.eventDate ? ' · ' + note.eventDate : '' )
                      + ' has been cancelled.' ; } var timeLabel=_formatTime(note.createdAt); var isUnread=!note.isRead;
                      %>
                      <div class="notif-item <%= isUnread ? 'notif-item--unread' : '' %>">
                        <% if (isLink) { %>
                          <a href="<%= eventLink %>" style="text-decoration: none; color: inherit; display: block">
                            <p class="notif-item-title">
                              <%= title %>
                            </p>
                            <p class="notif-item-sub">
                              <%= sub %>
                            </p>
                            <p class="notif-time">
                              <%= timeLabel %>
                            </p>
                          </a>
                          <% } else { %>
                            <p class="notif-item-title">
                              <%= title %>
                            </p>
                            <p class="notif-item-sub">
                              <%= sub %>
                            </p>
                            <p class="notif-time">
                              <%= timeLabel %>
                            </p>
                            <% } %>
                      </div>
                      <% }); %>
                        <% } %>
              </div>
          </div>
          <div class="avatar-btn" id="avatarBtn">
            <img
              src="<%= (locals.user && locals.user.profileImage) ? locals.user.profileImage : 'https://ui-avatars.com/api/?name=' + (locals.user ? locals.user.username : 'User') + '&background=e74c3c&color=fff' %>"
              alt="User avatar" class="avatar-circle"
              onerror="this.style.background='#3b4254';this.removeAttribute('src')" />
          </div>
        </div>
      </div>
    </header>

    <main class="page-shell">
      <section class="page-hero">
        <h1>My Bookings</h1>
        <p>Manage your upcoming experiences and venue reservations in our curated environment.</p>
      </section>

      <section class="type-selector">
        <div class="type-tabs">
          <button class="type-tab active" data-type="events">EVENT BOOKINGS</button>
          <button class="type-tab" data-type="venues">VENUE BOOKINGS</button>
        </div>
      </section>

      <!-- Event Bookings Section -->
      <div id="eventsSection" class="booking-type-content active">
        <section class="booking-controls">
          <div class="tabs">
            <button class="tab <%= activeStatus === 'confirmed' ? 'active' : '' %>" data-status="confirmed">
              CONFIRMED <span><%= confirmedCount %></span>
            </button>
            <button class="tab <%= activeStatus === 'expired' ? 'active' : '' %>" data-status="expired">
              EXPIRED <span><%= expiredCount %></span>
            </button>
            <button class="tab <%= activeStatus === 'cancelled' ? 'active' : '' %>" data-status="cancelled">
              CANCELLED <span><%= cancelledCount %></span>
            </button>
          </div>
          <div class="filters">
            <button class="filter-btn" type="button" id="filterToggle">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="4" y1="6" x2="20" y2="6"></line>
                <line x1="7" y1="12" x2="17" y2="12"></line>
                <line x1="10" y1="18" x2="14" y2="18"></line>
              </svg>
              FILTER BY DATE
            </button>
            <input type="date" id="dateFilter" class="date-filter" />
          </div>
        </section>

        <section class="booking-list">
          <% if (eventBookings.length === 0) { %>
            <div class="empty-state">
              <p>You have no event bookings yet.</p>
              <a href="/catalog" class="link-btn">Browse events</a>
            </div>
          <% } else { %>
            <% eventBookings.forEach(function(booking) { 
                const event = booking.eventId;
                const eventName = event ? (event.eventName || event.title || event.name) : 'Event';
                const eventDate = event && event.startDate ? new Date(event.startDate).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) : 'TBA';
                const eventDateIso = event && event.startDate ? new Date(event.startDate).toISOString().slice(0,10) : '';
                const eventLocation = event && event.location ? event.location : 'TBA';
                const eventImage = event && (event.image || event.imagePath) ? (event.image || event.imagePath) : 'https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?q=80&w=300&auto=format&fit=crop';
                const ticketCount = booking.ticketCount || 1;
                const totalAmount = typeof booking.totalAmount === 'number' ? booking.totalAmount : (booking.unitPrice || 0) * ticketCount;
                const totalDisplay = (booking.unitPrice === 0 || totalAmount === 0) ? 'Free' : `$${Number.isInteger(totalAmount) ? totalAmount.toFixed(0) : totalAmount.toFixed(2)}`;
                const statusGroup = normalizeStatus(booking.status);
                const actionLabel = statusGroup === 'confirmed' ? 'Manage' : 'View';
            %>
              <article class="booking-card" data-status="<%= statusGroup %>" data-date="<%= eventDateIso %>">
                <img class="booking-image" src="<%= eventImage %>" alt="<%= eventName %>" onerror="this.src='https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?q=80&w=300&auto=format&fit=crop'" />
                <div class="booking-meta">
                  <p class="label">EVENT NAME</p>
                  <h3><%= eventName %></h3>
                </div>
                <div class="booking-meta">
                  <p class="label">REFERENCE</p>
                  <div class="reference-pill"><%= booking.referenceNumber || '-' %></div>
                </div>
                <div class="booking-meta">
                  <p class="label">DATE & LOCATION</p>
                  <p class="date"><%= eventDate %></p>
                  <p class="location"><%= eventLocation %></p>
                </div>
                <div class="booking-meta">
                  <p class="label">TICKETS</p>
                  <p class="value"><%= ticketCount %> · <%= totalDisplay %></p>
                </div>
                <div class="booking-actions">
                  <span class="status <%= statusGroup %>"><%= statusGroup.toUpperCase() %></span>
                  <a href="/bookings/manage/<%= booking._id %>" class="manage-btn"><%= actionLabel %></a>
                </div>
              </article>
            <% }); %>
          <% } %>
        </section>
      </div>

      <!-- Venue Bookings Section -->
      <div id="venuesSection" class="booking-type-content">
        <section class="booking-controls">
          <div class="tabs">
            <button class="tab active" data-status="v-confirmed">
              CONFIRMED <span><%= vConfirmedCount %></span>
            </button>
            <button class="tab" data-status="v-cancelled">
              CANCELLED <span><%= vCancelledCount %></span>
            </button>
          </div>
        </section>

        <section class="booking-list">
          <% if (vBookings.length === 0) { %>
            <div class="empty-state">
              <p>You have no venue reservations yet.</p>
              <a href="/venues" class="link-btn">Browse venues</a>
            </div>
          <% } else { %>
            <% vBookings.forEach(function(booking) { 
                const venue = booking.venueId;
                const venueName = venue ? (venue.name || venue.venueName) : 'Venue';
                const bookingDate = booking.createdAt ? new Date(booking.createdAt).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) : 'TBA';
                const venueDate = booking.venueDate ? new Date(booking.venueDate).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) : bookingDate;
                const venueLocation = venue && venue.location ? venue.location : 'TBA';
                const venueImage = venue && (venue.image || venue.imagePath) ? (venue.image || venue.imagePath) : 'https://images.unsplash.com/photo-1519167758481-83f550bb49b3?q=80&w=300&auto=format&fit=crop';
                const statusGroup = normalizeStatus(booking.status);
                const displayStatus = statusGroup === 'confirmed' ? 'v-confirmed' : 'v-cancelled';
            %>
              <article class="booking-card venue-booking-card" data-status="<%= displayStatus %>">
                <img class="booking-image" src="<%= venueImage %>" alt="<%= venueName %>" onerror="this.src='https://images.unsplash.com/photo-1519167758481-83f550bb49b3?q=80&w=300&auto=format&fit=crop'" />
                <div class="booking-meta">
                  <p class="label">VENUE NAME</p>
                  <h3><%= venueName %></h3>
                </div>
                <div class="booking-meta">
                  <p class="label">REFERENCE</p>
                  <div class="reference-pill"><%= booking.bookingRef || booking.referenceNumber || '-' %></div>
                </div>
                <div class="booking-meta">
                  <p class="label">RESERVATION DATE</p>
                  <p class="date"><%= venueDate %></p>
                  <p class="location"><%= venueLocation %></p>
                </div>
                <div class="booking-meta">
                  <p class="label">RATE</p>
                  <p class="value">NPR <%= (booking.totalAmount || (venue && venue.ratePerDay) || 0).toLocaleString() %></p>
                </div>
                <div class="booking-actions">
                  <span class="status <%= statusGroup %>"><%= statusGroup.toUpperCase() %></span>
                  <a href="/venues" class="manage-btn">View</a>
                </div>
              </article>
            <% }); %>
          <% } %>
        </section>
      </div>
    </main>

  <footer class="footer">
    <span class="footer-copy">COPYRIGHT © 2026 EMS. ALL RIGHTS RESERVED.</span>
    <div class="footer-links">
      <a href="/terms">TERMS</a>
      <a href="/privacy">PRIVACY</a>
      <a href="/contact">CONTACT</a>
    </div>
  </footer>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <aside class="avatar-sidebar" id="avatarSidebar">
      <div class="sidebar-user-info">
        Hi, <%= (locals.user && locals.user.username) ? locals.user.username.charAt(0).toUpperCase() + locals.user.username.slice(1) : 'User' %>
      </div>

      <div class="sidebar-divider"></div>

      <a href="/profile" class="sidebar-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        My Profile
      </a>
      <div class="sidebar-divider"></div>

      <a href="/logout" class="sidebar-logout" id="logoutBtn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        Log Out
      </a>
    </aside>

    <script>
      const tabs = document.querySelectorAll(".tab");
      const typeTabs = document.querySelectorAll(".type-tab");
      const typeContents = document.querySelectorAll(".booking-type-content");
      const eventCards = document.querySelectorAll("#eventsSection .booking-card");
      const venueCards = document.querySelectorAll("#venuesSection .booking-card");
      const dateFilter = document.getElementById("dateFilter");
      const filterToggle = document.getElementById("filterToggle");

      function setActiveTab(status) {
        tabs.forEach((t) => t.classList.remove("active"));
        const target = Array.from(tabs).find(
          (t) => t.dataset.status === status
        );
        if (target) target.classList.add("active");
      }

      const urlStatus = new URLSearchParams(window.location.search).get("status");
      if (urlStatus === "cancelled" || urlStatus === "confirmed" || urlStatus === "expired") {
        setActiveTab(urlStatus);
      }

      function applyFilters() {
        const activeType = document.querySelector(".type-tab.active")?.dataset.type || "events";
        
        if (activeType === "events") {
            const activeStatus = document.querySelector("#eventsSection .tab.active")?.dataset.status || "confirmed";
            const dateValue = dateFilter.value;
            eventCards.forEach((card) => {
                const matchesStatus = card.dataset.status === activeStatus;
                const matchesDate = !dateValue || card.dataset.date === dateValue;
                card.style.display = matchesStatus && matchesDate ? "grid" : "none";
            });
        } else {
            const activeStatus = document.querySelector("#venuesSection .tab.active")?.dataset.status || "v-confirmed";
            venueCards.forEach((card) => {
                const matchesStatus = card.dataset.status === activeStatus;
                card.style.display = matchesStatus ? "grid" : "none";
            });
        }
      }

      typeTabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          typeTabs.forEach((t) => t.classList.remove("active"));
          tab.classList.add("active");
          
          const type = tab.dataset.type;
          typeContents.forEach(content => {
            content.classList.toggle("active", content.id === `${type}Section`);
          });
          applyFilters();
        });
      });

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const parentSection = tab.closest(".booking-type-content");
          parentSection.querySelectorAll(".tab").forEach((t) => t.classList.remove("active"));
          tab.classList.add("active");
          applyFilters();
        });
      });

      if (filterToggle) {
        filterToggle.addEventListener("click", () => {
            dateFilter.classList.toggle("open");
            if (!dateFilter.classList.contains("open")) {
                dateFilter.value = "";
                applyFilters();
            }
        });
      }

      if (dateFilter) {
        dateFilter.addEventListener("change", applyFilters);
      }

      applyFilters();

      const bellBtn = document.getElementById("bellBtn");
      const bellDropdown = document.getElementById("notifDropdown");
      if (bellBtn && bellDropdown) {
        bellBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          const isOpen = bellDropdown.classList.contains("open");
          bellDropdown.classList.toggle("open", !isOpen);
          if (!isOpen) {
            fetch("/notifications/mark-all-read", {
              method: "POST",
              credentials: "same-origin",
            })
              .then((res) => res.json())
              .then((data) => {
                if (data.success) {
                  document
                    .querySelectorAll(".notif-item--unread")
                    .forEach((el) => el.classList.remove("notif-item--unread"));
                  const dot = document.querySelector(".notif-dot");
                  if (dot) dot.style.display = "none";
                  const btn = document.getElementById("markAllReadBtn");
                  if (btn) btn.style.display = "none";
                }
              });
          }
        });
        document.addEventListener("click", () => {
          bellDropdown.classList.remove("open");
        });
      }

      const avatar = document.getElementById("avatarBtn");
      const sidebar = document.getElementById("avatarSidebar");
      const overlay = document.getElementById("sidebarOverlay");
      const toggleSidebar = (state) => {
        if (sidebar) sidebar.classList.toggle("open", state);
        if (overlay) overlay.classList.toggle("open", state);
      };
      if (avatar) avatar.addEventListener("click", () => toggleSidebar(true));
      if (overlay) overlay.addEventListener("click", () => toggleSidebar(false));

      const logoutBtn = document.getElementById("logoutBtn");
      if (logoutBtn) {
        logoutBtn.addEventListener("click", (e) => {
          if (!confirm("Are you sure you want to log out?")) {
            e.preventDefault();
          }
        });
      }
      function markAllNotificationsRead() {
        fetch("/notifications/mark-all-read", {
          method: "POST",
          credentials: "same-origin",
        })
          .then((res) => res.json())
          .then((data) => {
            if (data.success) {
              document
                .querySelectorAll(".notif-item--unread")
                .forEach((el) => el.classList.remove("notif-item--unread"));
              const dot = document.querySelector(".notif-dot");
              if (dot) dot.style.display = "none";
              const btn = document.getElementById("markAllReadBtn");
              if (btn) btn.style.display = "none";
            }
          });
      }
    </script>
</body>
</html>