<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EMS – My Bookings</title>
  <link rel="stylesheet" href="/css/bookings.css?v=2" />
  <link rel="stylesheet" href="/css/common-nav.css?v=2" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&display=swap"
    rel="stylesheet" />
</head>

<body>
  <% 
    const bookingList = locals.bookings || []; 
    const normalizeStatus = (status) => {
      const value = (status || 'confirmed').toLowerCase();
      return ['cancelled', 'expired'].includes(value) ? value : 'confirmed';
    };
    const confirmedCount = bookingList.filter(b => normalizeStatus(b.status) === 'confirmed').length;
    const expiredCount = bookingList.filter(b => normalizeStatus(b.status) === 'expired').length;
    const cancelledCount = bookingList.filter(b => normalizeStatus(b.status) === 'cancelled').length;
    const activeStatus = (typeof initialStatus === 'string' && ['cancelled', 'expired'].includes(initialStatus)) ? initialStatus : 'confirmed';
    const notifications = Array.isArray(locals.notifications) ? locals.notifications : [];
    const formatTicketCount = (count) => `${count} ticket${count === 1 ? '' : 's'}`;
    const formatNotifTime = (date) => {
      if (!date) return "Just now";
      const d = new Date(date);
      return Number.isNaN(d.getTime()) ? "Just now" : d.toLocaleString("en-US", { month: "short", day: "2-digit", hour: "2-digit", minute: "2-digit" });
    };
  %>
  <header class="navbar">
    <div class="nav-inner">
      <a href="<%= locals.user ? (locals.user.role === 'admin' ? '/admin/dashboard' : '/user') : '/guest' %>" class="nav-logo" style="text-decoration: none; color: #1e293b !important; font-size: 1.25rem !important; font-weight: 800 !important; letter-spacing: normal !important; font-family: 'DM Sans', sans-serif !important;">EMS</a>
      <nav class="nav-center">
        <a href="/user" class="nav-link <%= path === '/user' ? 'active' : '' %>">Home</a>
        <a href="/catalog" class="nav-link <%= path === '/catalog' ? 'active' : '' %>">Events</a>
        <a href="/venue" class="nav-link <%= path === '/venue' ? 'active' : '' %>">Venues</a>
        <a href="/bookings" class="nav-link <%= path === '/bookings' ? 'active' : '' %>">My Bookings</a>
      </nav>
      <div class="nav-right">
        <% if (locals.user) { %>
          <button class="icon-btn" id="notifBtn" aria-label="Notifications">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" />
            </svg>
            <% if (notifications.some(n => !n.isRead)) { %>
              <span class="notif-dot"></span>
            <% } %>
          </button>
          <img src="<%= user.profileImage || 'https://ui-avatars.com/api/?name=' + user.username + '&background=e74c3c&color=fff' %>" 
               alt="User avatar" class="avatar-circle" id="profileTrigger" />
        <% } else { %>
          <a href="/login" class="nav-link">Login</a>
        <% } %>
      </div>
    </div>
  </header>

  <div class="notif-dropdown" id="notifDropdown">
    <p class="notif-title">NOTIFICATIONS</p>
    <% if (notifications.length === 0) { %>
      <p class="notif-empty">No new notifications</p>
    <% } else { %>
      <% notifications.forEach(function(note) { 
          const title = ['booking_cancelled', 'venue_booking_cancelled'].includes(note.type) ? 'Booking Cancelled' : 'Booking Confirmed';
          const eventTitle = note.eventName || 'Event';
          const countLabel = formatTicketCount(note.ticketCount || 1);
          const timeLabel = formatNotifTime(note.createdAt);
      %>
        <div class="notif-item">
          <p class="notif-item-title"><%= title %></p>
          <p class="notif-item-sub"><%= eventTitle %> · <%= countLabel %></p>
          <p class="notif-time"><%= timeLabel %></p>
        </div>
      <% }) %>
    <% } %>
  </div>

  <main class="page-shell">
    <section class="page-hero">
      <h1>My Bookings</h1>
      <p>Manage your upcoming experiences and track past attendances in our curated environment.</p>
    </section>

    <section class="booking-controls">
      <div class="tabs">
        <button class="tab <%= activeStatus === 'confirmed' ? 'active' : '' %>" data-status="confirmed">
          CONFIRMED <span><%= confirmedCount %></span>
        </button>
        <button class="tab <%= activeStatus === 'expired' ? 'active' : '' %>" data-status="expired">
          EXPIRED <span><%= expiredCount %></span>
        </button>
        <button class="tab <%= activeStatus === 'cancelled' ? 'active' : '' %>" data-status="cancelled">
          CANCELLED <span><%= cancelledCount %></span>
        </button>
      </div>
      <div class="filters">
        <div class="type-filter">
          <button class="type-btn active" data-type="both">BOTH</button>
          <button class="type-btn" data-type="event">EVENTS</button>
          <button class="type-btn" data-type="venue">VENUES</button>
        </div>
      </div>
    </section>

    <section class="booking-list">
      <% if (bookingList.length === 0) { %>
        <div class="empty-state">
          <p>You have no bookings yet.</p>
          <a href="/catalog" class="link-btn">Browse events</a>
        </div>
      <% } else { %>
        <% bookingList.forEach(function(booking) { 
            const isEvent = booking.bookingType === 'event';
            const isVenue = booking.bookingType === 'venue';
            let title = 'Booking', dateLabel = 'TBA', dateIso = '', locationLabel = 'TBA', image = '', ref = '-', countLabel = '', manageUrl = '#', actionLabel = 'View', typeLabel = 'NAME';

            if (isEvent) {
              const event = booking.eventId || {};
              title = event.eventName || event.title || event.name || 'Event';
              dateLabel = event.startDate ? new Date(event.startDate).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) : 'TBA';
              dateIso = event.startDate ? new Date(event.startDate).toISOString().slice(0,10) : '';
              locationLabel = event.location || 'TBA';
              image = event.image || 'https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?q=80&w=300&auto=format&fit=crop';
              ref = booking.referenceNumber || '-';
              const tCount = booking.ticketCount || 1;
              const totalAmount = typeof booking.totalAmount === 'number' ? booking.totalAmount : (booking.unitPrice || 0) * tCount;
              const totalDisplay = (booking.unitPrice === 0 || totalAmount === 0) ? 'Free' : `NPR. ${totalAmount.toFixed(2)}`;
              countLabel = `${tCount} ticket${tCount > 1 ? 's' : ''} · ${totalDisplay}`;
              manageUrl = `/bookings/manage/${booking._id}`;
              typeLabel = 'EVENT NAME';
            } else if (isVenue) {
              const venue = booking.venueId || {};
              title = venue.name || 'Venue';
              const sDate = booking.startDate ? new Date(booking.startDate) : new Date();
              const eDate = booking.endDate ? new Date(booking.endDate) : sDate;
              const sLabel = sDate.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
              const eLabel = eDate.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
              dateLabel = sLabel === eLabel ? sLabel : `${sLabel} - ${eLabel}`;
              dateIso = sDate.toISOString().slice(0, 10);
              locationLabel = venue.location || 'TBA';
              image = (venue.imagePath || venue.image) || 'https://images.unsplash.com/photo-1519167758481-83f550bb49b3?q=80&w=300&auto=format&fit=crop';
              ref = booking.referenceNumber || '-';
              const totalAmt = booking.totalAmount || 0;
              const totalDisp = totalAmt === 0 ? 'Free' : `NPR. ${totalAmt.toFixed(2)}`;
              const diffTime = Math.abs(eDate - sDate);
              const daysCount = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
              const isDaily = venue.dailyRate;
              const durationLabel = isDaily ? `${daysCount} Day${daysCount > 1 ? 's' : ''}` : `${booking.startTime || 'TBA'} - ${booking.endTime || 'TBA'}`;
              countLabel = `${durationLabel} · ${totalDisp}`;
              manageUrl = `/bookings/manage/${booking._id}`;
              typeLabel = 'VENUE NAME';
            }

            const statusGroup = normalizeStatus(booking.status);
            actionLabel = statusGroup === 'confirmed' ? 'Manage' : 'View';
            if (isEvent && statusGroup === 'confirmed') {
              manageUrl = `/bookings/manage/${booking._id}?grouped=1&eventId=${(booking.eventId && booking.eventId._id) ? booking.eventId._id : ''}`;
            } else if (statusGroup !== 'confirmed') {
              manageUrl = `/bookings/manage/${booking._id}?viewOnly=1`;
            }
        %>
          <article class="booking-card" data-status="<%= statusGroup %>" data-type="<%= isEvent ? 'event' : 'venue' %>">
            <img class="booking-image" src="<%= image %>" alt="<%= title %>" onerror="this.src='/images/default-event.png'" />
            <div class="booking-meta">
              <p class="label"><%= typeLabel %></p>
              <h3><%= title %></h3>
            </div>
            <div class="booking-meta">
              <p class="label">REFERENCE</p>
              <div class="reference-pill"><%= ref %></div>
            </div>
            <div class="booking-meta">
              <p class="label">DATE & LOCATION</p>
              <p class="date"><%= dateLabel %></p>
              <p class="location"><%= locationLabel %></p>
            </div>
            <div class="booking-meta">
              <p class="label"><%= isEvent ? 'TICKETS' : 'TIME & TOTAL' %></p>
              <p class="value"><%= countLabel %></p>
            </div>
            <div class="booking-actions">
              <span class="status <%= statusGroup %>"><%= statusGroup.toUpperCase() %></span>
              <a href="<%= manageUrl %>" class="manage-btn"><%= actionLabel %></a>
            </div>
          </article>
        <% }); %>
      <% } %>
    </section>
  </main>

  <footer class="footer">
    <span class="footer-copy">COPYRIGHT © 2026 EMS. ALL RIGHTS RESERVED.</span>
    <div class="footer-links">
      <a href="/privacy">PRIVACY POLICY</a>
      <a href="/terms">TERMS OF SERVICE</a>
      <a href="/contact">CONTACT</a>
    </div>
  </footer>

  <% if (locals.user) { %>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <aside class="avatar-sidebar" id="avatarSidebar">
      <div class="sidebar-user-info">Hi, <%= user.username %></div>
      <div class="sidebar-divider"></div>
      <a href="/profile" class="sidebar-link">My Profile</a>
      <div class="sidebar-divider"></div>
      <a href="/logout" class="sidebar-logout" id="logoutBtn">Log Out</a>
    </aside>
  <% } %>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('.tab');
      const typeBtns = document.querySelectorAll('.type-btn');
      const cards = document.querySelectorAll('.booking-card');

      function applyFilters() {
        const activeStatus = document.querySelector('.tab.active')?.dataset.status || 'confirmed';
        const activeType = document.querySelector('.type-btn.active')?.dataset.type || 'both';

        cards.forEach(card => {
          const matchesStatus = card.dataset.status === activeStatus;
          const matchesType = activeType === 'both' || card.dataset.type === activeType;
          card.style.display = matchesStatus && matchesType ? 'grid' : 'none';
        });
      }

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          applyFilters();
        });
      });

      typeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          typeBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          applyFilters();
        });
      });

      applyFilters();
    });
  </script>
  <script src="/js/user.js"></script>
</body>

</html>
