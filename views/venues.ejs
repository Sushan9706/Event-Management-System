<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= typeof title !=='undefined' ? title : 'EMS – Premium Venues' %>
  </title>
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/catalog.css?v=2" />
  <link rel="stylesheet" href="/css/common-nav.css?v=2" />
  <link rel="stylesheet" href="/css/voice-search.css" />
</head>

<body>
  <header class="navbar">
    <div class="nav-inner">
      <a href="<%= locals.user ? (locals.user.role === 'admin' ? '/admin/dashboard' : '/user') : '/guest' %>"
        class="nav-logo"
        style="text-decoration: none; color: #1e293b !important; font-size: 1.25rem !important; font-weight: 800 !important; letter-spacing: normal !important; font-family: 'DM Sans', sans-serif !important;">EMS</a>

      <nav class="nav-center">
        <a href="/user" class="nav-link <%= path === '/user' ? 'active' : '' %>">Home</a>
        <a href="/catalog" class="nav-link <%= path === '/catalog' ? 'active' : '' %>">Events</a>
        <a href="/venue" class="nav-link <%= path === '/venue' ? 'active' : '' %>">Venues</a>
        <a href="/bookings" class="nav-link <%= path === '/bookings' ? 'active' : '' %>">My Bookings</a>
      </nav>

      <div class="nav-right">
        <% if (locals.user) { %>
          <button class="icon-btn" id="notifBtn" aria-label="Notifications">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
              <path d="M13.73 21a2 2 0 0 1-3.46 0" />
            </svg>
            <% if (locals.notifications && locals.notifications.some(n=> !n.isRead)) { %>
              <span class="notif-dot"></span>
            <% } %>
          </button>
          <img
            src="<%= (locals.user && user.profileImage) ? user.profileImage : 'https://ui-avatars.com/api/?name=' + (locals.user ? user.username : 'User') + '&background=e74c3c&color=fff' %>"
            alt="User avatar" class="avatar-circle" id="profileTrigger" />
          <% } else { %>
            <a href="/login" class="nav-link">Login</a>
            <% } %>
      </div>
    </div>
  </header>

  <% const notifications=Array.isArray(locals.notifications) ? locals.notifications : []; const
    formatTicketCount=(count)=> `${count} ticket${count === 1 ? '' : 's'}`;
    const formatNotifTime = (date) => {
    if (!date) return "Just now";
    const d = new Date(date);
    if (Number.isNaN(d.getTime())) return "Just now";
    return d.toLocaleString("en-US", { month: "short", day: "2-digit", hour: "2-digit", minute: "2-digit" });
    };
    %>
    <div class="notif-dropdown" id="notifDropdown">
      <p class="notif-title">NOTIFICATIONS</p>
      <% if (notifications.length===0) { %>
        <p class="notif-empty">No new notifications</p>
        <% } else { %>
          <% notifications.forEach(function(note) { const title=note.type==='booking_cancelled' ? 'Booking Cancelled'
            : 'Booking Confirmed' ; const eventTitle=note.eventName || 'Event' ; const
            countLabel=formatTicketCount(note.ticketCount || 1); const timeLabel=formatNotifTime(note.createdAt); %>
            <div class="notif-item">
              <p class="notif-item-title">
                <%= title %>
              </p>
              <p class="notif-item-sub">
                <%= eventTitle %> · <%= countLabel %>
              </p>
              <p class="notif-time">
                <%= timeLabel %>
              </p>
            </div>
            <% }) %>
              <% } %>
    </div>

    <section class="hero">
      <h1>Premium <span>Venues.</span></h1>
      <div class="search-bar">
        <div class="search-bar-input">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input type="text" id="venueSearch" placeholder="Search for venues, cities, or capacity..." />
          <button class="mic-btn" id="voiceSearchBtn" title="Search by voice">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
              <path d="M19 10v1a7 7 0 0 1-14 0v-1"></path>
              <line x1="12" y1="19" x2="12" y2="22"></line>
            </svg>
          </button>
        </div>

        <div class="voice-status" id="voiceStatus">
          <div class="status-inner">
            <span class="status-text">Listening...</span>
            <div class="dots">
              <div class="dot"></div>
              <div class="dot"></div>
              <div class="dot"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="filters" id="filters" style="display: flex; justify-content: center; gap: 10px; margin-bottom: 30px;">
      <button class="filter-tag active" data-filter="all">All Venues</button>
      <button class="filter-tag" data-filter="large">Large (500+)</button>
      <button class="filter-tag" data-filter="medium">Medium (100-500)</button>
      <button class="filter-tag" data-filter="small">Small (<100)< /button>
    </div>

    <section class="events-section">
      <div id="noResults"
        style="display: none; text-align: center; padding: 4rem 2rem; background: #fff; border-radius: 12px; border: 1px dashed var(--border); grid-column: 1 / -1; margin-bottom: 2rem;">
        <div style="font-size: 40px; margin-bottom: 1rem;">🔍</div>
        <h3 style="font-size: 18px; font-weight: 700; color: var(--dark); margin-bottom: 0.5rem;">No venues found</h3>
        <p style="font-size: 14px; color: var(--muted);">Try adjusting your search to find what you're looking for.</p>
      </div>
      <div class="events-grid" id="venuesGrid">
        <% if (typeof venues !=='undefined' && venues.length> 0) { %>
          <% venues.forEach(venue=> {
            let imgUrl = venue.imagePath || venue.image || '/images/default-venue.png';
            if(imgUrl && !imgUrl.startsWith('http') && !imgUrl.startsWith('/')) {
            imgUrl = '/' + imgUrl;
            }
            %>
            <div class="event-card" data-id="<%= venue._id %>">
              <div class="card-img">
                <img src="<%= imgUrl %>" alt="<%= venue.name %>"
                  onerror="this.onerror=null;this.src='/images/default-venue.png';" />
                <span class="card-tag tag-venue">
                  Capacity: <%= venue.capacity %>
                </span>
              </div>
                <div class="card-meta">
                  <div class="card-meta-row">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                      <circle cx="12" cy="10" r="3" />
                    </svg>
                    <%= venue.location %>
                  </div>
                </div>
                <div class="card-footer">
                  <span class="card-price">
                    NPR. <%= venue.dailyRate || venue.hourlyRate || 0 %>/<%= venue.dailyRate ? 'day' : 'hr' %>
                  </span>
                  <button class="btn-details">Details →</button>
                </div>
              </div>
            </div>
            <% }); %>
          <% } else { %>
            <p style="text-align: center; grid-column: 1 / -1; margin-top: 2rem">
              No venues found. Check back later!
            </p>
          <% } %>
      </div>
    </section>

    <footer class="footer">
      <span class="footer-copy">COPYRIGHT © 2026 EMS. ALL RIGHTS RESERVED.</span>
      <div class="footer-links">
        <a href="/privacy">PRIVACY POLICY</a>
        <a href="/terms">TERMS OF SERVICE</a>
        <a href="/contact">CONTACT</a>
      </div>
    </footer>

    <% if (locals.user) { %>
      <div class="sidebar-overlay" id="sidebarOverlay"></div>

      <aside class="avatar-sidebar" id="avatarSidebar">
        <div class="sidebar-user-info">
          Hi, <%= (locals.user && user.username) ? user.username.charAt(0).toUpperCase() + user.username.slice(1) : 'User' %>
        </div>

        <div class="sidebar-divider"></div>

        <a href="/profile" class="sidebar-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          My Profile
        </a>

        <div class="sidebar-divider"></div>

        <a href="/logout" class="sidebar-logout" id="logoutBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          Log Out
        </a>
      </aside>
    <% } %>

    <script src="/js/voice-search.js"></script>
    <script src="/js/venues.js"></script>
    <script src="/js/user.js"></script>
</body>
</html>