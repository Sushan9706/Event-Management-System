<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EMS – Premium Venues</title>
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/catalog.css" />
</head>

<body>
  <header class="navbar">
    <div class="nav-inner">
      <div class="nav-logo">EMS</div>
      <nav class="nav-links">
        <a href="/user" class="nav-item">Home</a>
        <a href="/catalog" class="nav-item">Events</a>
        <a href="/venues" class="nav-item active">Venues</a>
        <a href="/bookings" class="nav-item">My Bookings</a>
      </nav>
      <div class="nav-right">
        <button class="icon-btn" id="notifBtn" aria-label="Notifications">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
          </svg>
          <% if (locals.notifications && locals.notifications.length > 0) { %>
            <span class="notif-dot"></span>
          <% } %>
        </button>

        <div class="profile-menu-container" style="position: relative">
          <div class="avatar-btn" id="avatarBtn">
            <img
              src="<%= (user && user.profileImage) ? user.profileImage : 'https://ui-avatars.com/api/?name=' + (user ? user.username : 'User') + '&background=e74c3c&color=fff' %>"
              alt="User avatar" />
          </div>

          <aside class="avatar-sidebar" id="avatarSidebar">
            <div style="padding: 10px 22px; font-weight: 700; font-size: 12px; color: var(--dark);">
              Hi, <%= user ? user.username : 'Guest' %>
            </div>
            <div class="sidebar-divider"></div>
            <a href="/profile" class="sidebar-link"> My Profile </a>
            <div class="sidebar-divider"></div>
            <a href="/logout" class="sidebar-logout"> Log Out </a>
          </aside>
        </div>
      </div>
    </div>
  </header>

  <section class="hero">
    <h1>Iconic <span>Venues.</span></h1>
    <div class="search-bar">
      <div class="search-bar-input">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input type="text" id="venueSearch" placeholder="Search for venues or locations..." />
      </div>
    </div>
  </section>

  <div class="filters" id="venueFilters">
    <button class="filter-tag active" data-filter="all">All Venues</button>
    <button class="filter-tag" data-filter="banquet-hall">Banquet Hall</button>
    <button class="filter-tag" data-filter="conference-room">Conference Room</button>
    <button class="filter-tag" data-filter="stadium">Stadium</button>
    <button class="filter-tag" data-filter="rooftop">Rooftop</button>
    <button class="filter-tag" data-filter="garden">Garden</button>
    <button class="filter-tag" data-filter="other">Other</button>
  </div>

  <section class="events-section">
    <div id="noResults"
      style="display: <%= (typeof venues !== 'undefined' && venues.length > 0) ? 'none' : 'block' %>; text-align: center; padding: 4rem 2rem; background: #fff; border-radius: 12px; border: 1px dashed var(--border); grid-column: 1 / -1; margin-bottom: 2rem;">
      <div style="font-size: 40px; margin-bottom: 1rem;">🏢</div>
      <h3 style="font-size: 18px; font-weight: 700; color: var(--dark); margin-bottom: 0.5rem;">No venues available</h3>
      <p style="font-size: 14px; color: var(--muted);">No venues are currently available matching your criteria.</p>
    </div>
    <div class="events-grid" id="venuesGrid">
      <% if (typeof venues !=='undefined' && venues.length > 0) { %>
        <% venues.forEach(venue => {
          let catStr = (venue.category || 'other').toLowerCase().trim().replace(/\s+/g, '-');
          let imgUrl = venue.imageUrl || '/images/default-venue.png';
          %>
          <div class="event-card" data-id="<%= venue._id %>" data-category="<%= catStr %>" data-name="<%= venue.name.toLowerCase() %>" data-location="<%= venue.location.toLowerCase() %>">
            <div class="card-img">
              <img src="<%= imgUrl %>" alt="<%= venue.name %>" onerror="this.src='/images/default-event.png'" />
              <span class="card-tag tag-<%= catStr %>">
                <%= venue.category %>
              </span>
            </div>
            <div class="card-body">
              <p class="card-name">
                <%= venue.name %>
              </p>
              <div class="card-meta">
                <div class="card-meta-row">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                  <%= venue.location %>
                </div>
                <div class="card-meta-row">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                  </svg>
                  Capacity: <%= venue.capacity %>
                </div>
              </div>
              <div class="card-footer">
                <span class="card-price">
                  $<%= venue.rate.toFixed(2) %> / hr
                </span>
                <% if (user) { %>
                  <button class="btn-book-venue btn-details" data-id="<%= venue._id %>">Book Venue →</button>
                <% } else { %>
                  <button class="btn-book-venue btn-details" onclick="window.location.href='/login'">Login to Book</button>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </section>

  <footer class="footer">
    <span class="footer-copy">COPYRIGHT 2026 EMS MANAGEMENT</span>
    <div class="footer-links">
      <a href="#">PRIVACY POLICY</a>
      <a href="#">TERMS OF SERVICE</a>
      <a href="#">CONTACT</a>
    </div>
  </footer>

  <script>
    // Simple client-side search and filtering
    const searchInput = document.getElementById('venueSearch');
    const filterTags = document.querySelectorAll('.filter-tag');
    const venueCards = document.querySelectorAll('.event-card');
    const noResults = document.getElementById('noResults');

    function filterVenues() {
      const searchTerm = searchInput.value.toLowerCase();
      const activeFilter = document.querySelector('.filter-tag.active').getAttribute('data-filter');
      let visibleCount = 0;

      venueCards.forEach(card => {
        const name = card.getAttribute('data-name');
        const location = card.getAttribute('data-location');
        const category = card.getAttribute('data-category');

        const matchesSearch = name.includes(searchTerm) || location.includes(searchTerm);
        const matchesFilter = activeFilter === 'all' || category === activeFilter;

        if (matchesSearch && matchesFilter) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    searchInput.addEventListener('input', filterVenues);

    filterTags.forEach(tag => {
      tag.addEventListener('click', () => {
        filterTags.forEach(t => t.classList.remove('active'));
        tag.classList.add('active');
        filterVenues();
      });
    });

    // Avatar Sidebar Logic
    const avatarBtn = document.getElementById('avatarBtn');
    const avatarSidebar = document.getElementById('avatarSidebar');
    if (avatarBtn) {
        avatarBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            avatarSidebar.classList.toggle('open');
        });
    }
    document.addEventListener('click', () => {
        if (avatarSidebar) avatarSidebar.classList.remove('open');
    });

    // Notif Logic
    const notifBtn = document.getElementById('notifBtn');
    if (notifBtn) {
        notifBtn.addEventListener('click', () => {
            alert('Notifications coming soon!');
        });
    }
  </script>
</body>

</html>
