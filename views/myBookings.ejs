<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Bookings - EMS</title>
    <link rel="stylesheet" href="/css/manageBooking.css">
    <link rel="stylesheet" href="/css/myBookings.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="my-bookings-page">

    <!-- NAVBAR -->
    <header class="navbar">
        <div class="nav-inner">
            <a href="/" class="nav-logo">EMS</a>
            <nav class="nav-links">
                <a href="/events">Events</a>
                <a href="/bookings/my-bookings" class="active">My Bookings</a>
            </nav>
            <div class="nav-actions">
                <button class="icon-btn" title="Search">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                </button>
                <button class="icon-btn" title="Notifications">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                </button>
                <div class="avatar-circle"><%= user.username ? user.username.charAt(0).toUpperCase() : 'U' %></div>
            </div>
        </div>
    </header>

    <!-- MAIN -->
    <main class="page-wrapper">
        <section class="bookings-hero">
            <h1 class="hero-title">My Bookings</h1>
            <p class="hero-subtitle">
                Manage your upcoming experiences and track past attendances in our curated environment.
            </p>
        </section>

        <div class="bookings-controls">
            <div class="bookings-tabs">
                <button class="tab-btn active" type="button" data-tab="confirmed">Confirmed</button>
                <button class="tab-btn" type="button" data-tab="cancelled">Cancelled</button>
            </div>
            <button class="filter-btn" type="button">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h18"/><path d="M6 12h12"/><path d="M10 19h4"/></svg>
                Filter by date
            </button>
        </div>

        <% if (typeof error !== 'undefined' && error.length > 0) { %>
            <div class="flash-error"><%= error[0] %></div>
        <% } %>

        <% if (bookings.length === 0) { %>
            <div class="empty-state">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <h3>No bookings yet</h3>
                <p>You haven't booked any events. Browse events to get started.</p>
                <a href="/events" class="btn-browse">Browse Events</a>
            </div>
        <% } else { %>
            <% const confirmedBookings = bookings.filter(b => b.status === 'confirmed'); %>
            <% const cancelledBookings = bookings.filter(b => b.status === 'cancelled'); %>

            <div class="bookings-list is-active" data-status="confirmed">
                <% if (confirmedBookings.length === 0) { %>
                    <div class="empty-inline">No confirmed bookings.</div>
                <% } %>
                <% confirmedBookings.forEach(booking => { %>
                <div class="booking-row">
                    <div class="row-media">
                        <% if (booking.event && booking.event.image) { %>
                            <img src="<%= booking.event.image %>" alt="<%= booking.event ? booking.event.name : 'Event' %>">
                        <% } else { %>
                            <div class="row-media-placeholder">
                                <span><%= booking.event ? booking.event.name.charAt(0) : 'E' %></span>
                            </div>
                        <% } %>
                    </div>
                    <div class="row-block">
                        <span class="row-label">Event Name</span>
                        <span class="row-title"><%= booking.event ? booking.event.name : 'Event Removed' %></span>
                    </div>
                    <div class="row-block">
                        <span class="row-label">Reference</span>
                        <span class="row-chip"><%= booking.bookingRef %></span>
                    </div>
                    <div class="row-block">
                        <span class="row-label">Date &amp; Location</span>
                        <% if (booking.event) { %>
                            <span class="row-title">
                                <%= new Date(booking.event.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                            </span>
                            <span class="row-subtext"><%= booking.event.location || 'TBA' %></span>
                        <% } else { %>
                            <span class="row-title">TBA</span>
                            <span class="row-subtext">Location unavailable</span>
                        <% } %>
                    </div>
                    <div class="row-actions">
                        <a href="/bookings/manage/<%= booking._id %>" class="btn-manage">Manage</a>
                    </div>
                </div>
                <% }) %>
            </div>

            <div class="bookings-list" data-status="cancelled">
                <% if (cancelledBookings.length === 0) { %>
                    <div class="empty-inline">No cancelled bookings.</div>
                <% } %>
                <% cancelledBookings.forEach(booking => { %>
                <div class="booking-row">
                    <div class="row-media">
                        <% if (booking.event && booking.event.image) { %>
                            <img src="<%= booking.event.image %>" alt="<%= booking.event ? booking.event.name : 'Event' %>">
                        <% } else { %>
                            <div class="row-media-placeholder">
                                <span><%= booking.event ? booking.event.name.charAt(0) : 'E' %></span>
                            </div>
                        <% } %>
                    </div>
                    <div class="row-block">
                        <span class="row-label">Event Name</span>
                        <span class="row-title"><%= booking.event ? booking.event.name : 'Event Removed' %></span>
                    </div>
                    <div class="row-block">
                        <span class="row-label">Reference</span>
                        <span class="row-chip"><%= booking.bookingRef %></span>
                    </div>
                    <div class="row-block">
                        <span class="row-label">Date &amp; Location</span>
                        <% if (booking.event) { %>
                            <span class="row-title">
                                <%= new Date(booking.event.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                            </span>
                            <span class="row-subtext"><%= booking.event.location || 'TBA' %></span>
                        <% } else { %>
                            <span class="row-title">TBA</span>
                            <span class="row-subtext">Location unavailable</span>
                        <% } %>
                    </div>
                    <div class="row-actions">
                        <a href="/bookings/manage/<%= booking._id %>" class="btn-manage">Manage</a>
                    </div>
                </div>
                <% }) %>
            </div>
        <% } %>
    </main>

    <!-- FOOTER -->
    <footer class="page-footer">
        <span class="footer-copy">COPYRIGHT 2026 EMS MANAGEMENT</span>
        <div class="footer-links">
            <a href="#">PRIVACY POLICY</a>
            <a href="#">TERMS OF SERVICE</a>
            <a href="#">CONTACT</a>
        </div>
    </footer>

    <script>
        (function () {
            const tabs = document.querySelectorAll('.tab-btn');
            const lists = document.querySelectorAll('.bookings-list');

            function setActive(status) {
                tabs.forEach(tab => {
                    tab.classList.toggle('active', tab.dataset.tab === status);
                });
                lists.forEach(list => {
                    list.classList.toggle('is-active', list.dataset.status === status);
                });
            }

            tabs.forEach(tab => {
                tab.addEventListener('click', () => setActive(tab.dataset.tab));
            });
        })();
    </script>

</body>
</html>
